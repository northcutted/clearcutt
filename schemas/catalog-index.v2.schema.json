{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CatalogIndexV2",
  "type": "object",
  "required": [
    "schemaVersion",
    "generatedAt",
    "owner",
    "repo",
    "repoUrl",
    "registryBase",
    "latestTag",
    "releases",
    "languages",
    "tiers",
    "images"
  ],
  "properties": {
    "schemaVersion": { "type": "string", "const": "clearcutt.catalog.index/v2" },
    "generatedAt": { "type": "string" },
    "generator": {
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "version": { "type": "string" },
        "commit": { "type": "string" }
      }
    },
    "source": {
      "type": "object",
      "properties": {
        "owner": { "type": "string" },
        "repo": { "type": "string" },
        "repoUrl": { "type": "string" },
        "registryBase": { "type": "string" }
      }
    },
    "summary": {
      "type": "object",
      "properties": {
        "imageCount": { "type": "integer" },
        "releaseCount": { "type": "integer" },
        "signedCount": { "type": "integer" },
        "provenanceCount": { "type": "integer" },
        "sbomCount": { "type": "integer" },
        "scanCount": { "type": "integer" },
        "passingCount": { "type": "integer" }
      }
    },
    "owner": { "type": "string" },
    "repo": { "type": "string" },
    "repoUrl": { "type": "string" },
    "registryBase": { "type": "string" },
    "latestTag": { "type": "string" },
    "releases": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["tag", "publishedAt", "isLatest"],
        "properties": {
          "tag": { "type": "string" },
          "publishedAt": { "type": "string" },
          "isLatest": { "type": "boolean" }
        }
      }
    },
    "languages": {
      "type": "array",
      "items": { "$ref": "#/definitions/LanguageInfo" }
    },
    "tiers": {
      "type": "array",
      "items": { "$ref": "#/definitions/TierInfo" }
    },
    "images": {
      "type": "array",
      "items": { "$ref": "#/definitions/CatalogImageSummary" }
    }
  },
  "definitions": {
    "LanguageInfo": {
      "type": "object",
      "required": ["id", "displayName", "version"],
      "properties": {
        "id": { "type": "string" },
        "displayName": { "type": "string" },
        "version": { "type": "string" },
        "icon": { "type": ["string", "null"] }
      }
    },
    "TierInfo": {
      "type": "object",
      "required": ["id", "name", "blurb"],
      "properties": {
        "id": { "type": "string", "enum": ["dev", "slim", "distroless", "service"] },
        "name": { "type": "string" },
        "blurb": { "type": "string" }
      }
    },
    "EvidenceSummary": {
      "type": "object",
      "required": [
        "signature",
        "provenance",
        "sbom",
        "tests",
        "vulnerabilities",
        "archCount",
        "sbomArchCount",
        "testArchCount",
        "passedTestArchCount",
        "vulnerabilityArchCount"
      ],
      "properties": {
        "signature": { "type": "boolean" },
        "provenance": { "type": "boolean" },
        "sbom": { "type": "boolean" },
        "tests": { "type": "boolean" },
        "vulnerabilities": { "type": "boolean" },
        "statuses": { "$ref": "#/definitions/EvidenceStatuses" },
        "archCount": { "type": "integer" },
        "sbomArchCount": { "type": "integer" },
        "testArchCount": { "type": "integer" },
        "passedTestArchCount": { "type": "integer" },
        "vulnerabilityArchCount": { "type": "integer" }
      }
    },
    "EvidenceStatuses": {
      "type": "object",
      "properties": {
        "signature": { "$ref": "#/definitions/EvidenceChannelStatus" },
        "provenance": { "$ref": "#/definitions/EvidenceChannelStatus" },
        "sbom": { "$ref": "#/definitions/EvidenceChannelStatus" },
        "tests": { "$ref": "#/definitions/EvidenceChannelStatus" },
        "vulnerabilities": { "$ref": "#/definitions/EvidenceChannelStatus" }
      }
    },
    "EvidenceChannelStatus": {
      "type": "object",
      "required": ["status"],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["missing", "observed", "verified", "attested", "stale", "unknown"]
        },
        "source": { "type": "string" },
        "claim": { "type": "string" }
      }
    },
    "ImageOrigin": {
      "type": "object",
      "required": ["kind", "createdByClearCutt"],
      "properties": {
        "kind": { "type": "string", "enum": ["clearcutt", "imported"] },
        "createdByClearCutt": { "type": "boolean" },
        "sourceRef": { "type": "string" },
        "digestRef": { "type": "string" },
        "observedAt": { "type": "string" },
        "observationMode": { "type": "string" },
        "provenanceClaim": { "type": "string", "enum": ["none", "external", "clearcutt"] }
      }
    },
    "ImageGovernance": {
      "type": "object",
      "required": ["imported"],
      "properties": {
        "imported": { "type": "boolean" },
        "owner": { "type": "string" },
        "classificationConfidence": { "type": "string" },
        "productionIntent": { "type": "string" },
        "notes": { "type": "array", "items": { "type": "string" } }
      }
    },
    "EvidencePolicy": {
      "type": "object",
      "properties": {
        "signature": { "type": "string" },
        "sbom": { "type": "string" },
        "provenance": { "type": "string" },
        "vulnerabilityScan": { "type": "string" },
        "tests": { "type": "string" }
      }
    },
    "Lifecycle": {
      "type": "object",
      "required": ["status", "support", "productionAllowed"],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["active", "preview", "deprecated", "eol", "experimental", "blocked"]
        },
        "support": { "type": "string" },
        "productionAllowed": { "type": "boolean" },
        "deprecatedAt": { "type": ["string", "null"] },
        "eolAt": { "type": ["string", "null"] },
        "reason": { "type": ["string", "null"] }
      }
    },
    "RuntimeContract": {
      "type": "object",
      "required": ["productionTier"],
      "properties": {
        "user": { "type": ["string", "null"] },
        "workingDir": { "type": ["string", "null"] },
        "shellPresent": { "type": ["boolean", "null"] },
        "packageManagerPresent": { "type": ["boolean", "null"] },
        "caCertificatesPresent": { "type": ["boolean", "null"] },
        "timezoneDataPresent": { "type": ["boolean", "null"] },
        "defaultEntrypoint": { "type": ["string", "null"] },
        "productionTier": { "type": "boolean" }
      }
    },
    "ServicePortInfo": {
      "type": "object",
      "required": ["port"],
      "properties": {
        "name": { "type": "string" },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "protocol": { "type": "string", "enum": ["tcp", "udp"] }
      }
    },
    "ServiceInfo": {
      "type": "object",
      "required": ["template", "version", "stateful"],
      "properties": {
        "template": { "type": "string" },
        "version": { "type": "string" },
        "ports": {
          "type": "array",
          "items": { "$ref": "#/definitions/ServicePortInfo" }
        },
        "stateful": { "type": "boolean" },
        "dataDirs": {
          "type": "array",
          "items": { "type": "string" }
        },
        "smoke": {
          "type": "array",
          "items": { "type": "string" }
        },
        "smokeStatus": { "type": "string" }
      }
    },
    "CatalogImageSummary": {
      "type": "object",
      "required": [
        "id",
        "kind",
        "language",
        "languageDisplay",
        "languageVersion",
        "tier",
        "latestTag",
        "latestPackageCount",
        "architectures",
        "signed",
        "provenance",
        "passed",
        "lifecycle",
        "runtimeContract"
      ],
      "properties": {
        "id": { "type": "string" },
        "kind": { "type": "string", "enum": ["runtime", "service", "application"] },
        "language": { "type": "string" },
        "languageDisplay": { "type": "string" },
        "languageVersion": { "type": "string" },
        "tier": { "type": "string", "enum": ["dev", "slim", "distroless", "service"] },
        "latestTag": { "type": "string" },
        "latestManifestDigest": { "type": ["string", "null"] },
        "latestPackageCount": { "type": "integer" },
        "architectures": {
          "type": "array",
          "items": { "type": "string" }
        },
        "signed": { "type": "boolean" },
        "provenance": { "type": "boolean" },
        "evidence": { "$ref": "#/definitions/EvidenceSummary" },
        "passed": { "type": "boolean" },
        "lifecycle": { "$ref": "#/definitions/Lifecycle" },
        "runtimeContract": { "$ref": "#/definitions/RuntimeContract" },
        "origin": { "$ref": "#/definitions/ImageOrigin" },
        "governance": { "$ref": "#/definitions/ImageGovernance" },
        "evidencePolicy": { "$ref": "#/definitions/EvidencePolicy" },
        "service": { "$ref": "#/definitions/ServiceInfo" },
        "vulnSummary": { "type": ["object", "null"] }
      }
    }
  }
}
