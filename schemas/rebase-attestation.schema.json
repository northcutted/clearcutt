{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://clearcutt.dev/schemas/rebase-attestation.schema.json",
  "title": "ClearCuttRebaseAttestation",
  "description": "in-toto statement attesting that a ClearCutt base swap preserved the application layers byte-for-byte, with dual-control evidence that the original developer signature was verified before the rebase was allowed.",
  "type": "object",
  "required": ["_type", "predicateType", "subject", "predicate"],
  "properties": {
    "_type": {
      "type": "string",
      "enum": ["https://in-toto.io/Statement/v1"]
    },
    "predicateType": {
      "type": "string",
      "enum": ["https://clearcutt.dev/attestations/rebase/v1"]
    },
    "subject": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "digest"],
        "properties": {
          "name": { "type": "string" },
          "digest": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": { "type": "string" }
          }
        }
      }
    },
    "predicate": { "$ref": "#/definitions/predicate" }
  },
  "definitions": {
    "digest": {
      "type": "string",
      "pattern": "^[a-z0-9]+:[a-f0-9]+$"
    },
    "predicate": {
      "type": "object",
      "required": [
        "sourceImage",
        "sourceDigest",
        "newBaseDigest",
        "preservedAppLayers",
        "rebaseDecision",
        "developerIdentity",
        "developerIssuer",
        "developerSignatureVerified"
      ],
      "properties": {
        "sourceImage": {
          "type": "string",
          "description": "The original developer-built application image reference."
        },
        "sourceDigest": {
          "$ref": "#/definitions/digest",
          "description": "Manifest digest of the original developer image whose layers were preserved."
        },
        "oldBaseDigest": { "$ref": "#/definitions/digest" },
        "newBaseDigest": { "$ref": "#/definitions/digest" },
        "preservedAppLayers": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/digest" },
          "description": "Compressed layer digests preserved byte-for-byte from the source image."
        },
        "removedBaseLayers": {
          "type": "array",
          "items": { "$ref": "#/definitions/digest" }
        },
        "addedBaseLayers": {
          "type": "array",
          "items": { "$ref": "#/definitions/digest" }
        },
        "compatibilityPolicy": {
          "type": "string",
          "description": "Identifier of the ABI/runtime compatibility policy applied to gate the rebase."
        },
        "rebaseDecision": {
          "type": "string",
          "enum": ["allowed", "blocked"]
        },
        "developerIdentity": {
          "type": "string",
          "description": "Pinned keyless signer identity of the original developer whose signature over sourceDigest was verified."
        },
        "developerIssuer": {
          "type": "string",
          "description": "OIDC issuer of the verified developer signature."
        },
        "developerSignatureVerified": {
          "type": "boolean",
          "description": "True only if the developer signature over sourceDigest was cryptographically verified before the rebase; an allowed rebase requires this to be true."
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "rebaseDecision": { "const": "allowed" } }
          },
          "then": {
            "properties": {
              "developerSignatureVerified": { "const": true },
              "developerIdentity": { "type": "string", "minLength": 1 }
            }
          }
        }
      ]
    }
  }
}
