{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ImageRecord",
  "type": "object",
  "required": [
    "schemaVersion",
    "id",
    "language",
    "tier",
    "registry",
    "imageName",
    "fullName",
    "releases",
    "lifecycle",
    "runtimeContract"
  ],
  "properties": {
    "schemaVersion": { "type": "string", "const": "clearcutt.catalog.image/v1" },
    "id": { "type": "string" },
    "language": {
      "type": "object",
      "required": ["id", "displayName", "version"],
      "properties": {
        "id": { "type": "string" },
        "displayName": { "type": "string" },
        "version": { "type": "string" },
        "icon": { "type": ["string", "null"] }
      }
    },
    "tier": {
      "type": "object",
      "required": ["id", "name", "blurb"],
      "properties": {
        "id": { "type": "string", "enum": ["dev", "slim", "distroless"] },
        "name": { "type": "string" },
        "blurb": { "type": "string" }
      }
    },
    "registry": { "type": "string" },
    "imageName": { "type": "string" },
    "fullName": { "type": "string" },
    "lifecycle": { "$ref": "catalog.schema.json#/definitions/Lifecycle" },
    "runtimeContract": { "$ref": "catalog.schema.json#/definitions/RuntimeContract" },
    "releases": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/ReleaseEntry"
      }
    }
  },
  "definitions": {
    "PackageEntry": {
      "type": "object",
      "required": ["name", "version", "cpes", "license", "supplier", "spdxId"],
      "properties": {
        "name": { "type": "string" },
        "version": { "type": "string" },
        "purl": { "type": ["string", "null"] },
        "cpes": {
          "type": "array",
          "items": { "type": "string" }
        },
        "license": { "type": "string" },
        "supplier": { "type": "string" },
        "nixStorePath": { "type": ["string", "null"] },
        "spdxId": { "type": "string" },
        "layerDigest": { "type": ["string", "null"] }
      }
    },
    "ArchPayload": {
      "type": "object",
      "required": ["arch", "os", "layers", "labels", "sbom"],
      "properties": {
        "arch": { "type": "string", "enum": ["amd64", "arm64"] },
        "os": { "type": "string" },
        "imageDigest": { "type": ["string", "null"] },
        "imageSize": { "type": ["integer", "null"] },
        "layerCount": { "type": ["integer", "null"] },
        "layers": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["digest", "size"],
            "properties": {
              "digest": { "type": "string" },
              "size": { "type": "integer" },
              "diffID": { "type": ["string", "null"] }
            }
          }
        },
        "labels": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "sbom": {
          "type": "object",
          "required": ["tool", "createdAt", "packageCount", "packages"],
          "properties": {
            "tool": { "type": "string" },
            "createdAt": { "type": "string" },
            "rootDigest": { "type": ["string", "null"] },
            "packageCount": { "type": "integer" },
            "packages": {
              "type": "array",
              "items": { "$ref": "#/definitions/PackageEntry" }
            }
          }
        },
        "testResults": {
          "type": ["object", "null"],
          "required": ["status", "timestamp", "assertions"],
          "properties": {
            "status": { "type": "string" },
            "timestamp": { "type": ["string", "null"] },
            "assertions": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["name", "status"],
                "properties": {
                  "name": { "type": "string" },
                  "status": { "type": "string" }
                }
              }
            }
          }
        },
        "vulnerabilities": {
          "type": ["object", "null"],
          "required": ["scannedAt", "scanner", "countsBySeverity", "findings"],
          "properties": {
            "scannedAt": { "type": "string" },
            "scanner": { "type": "string" },
            "dbBuiltAt": { "type": ["string", "null"] },
            "countsBySeverity": {
              "type": "object",
              "required": ["critical", "high", "medium", "low", "negligible", "unknown"],
              "properties": {
                "critical": { "type": "integer" },
                "high": { "type": "integer" },
                "medium": { "type": "integer" },
                "low": { "type": "integer" },
                "negligible": { "type": "integer" },
                "unknown": { "type": "integer" }
              }
            },
            "findings": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["id", "severity", "packageName", "packageVersion", "fixedIn", "fixState"],
                "properties": {
                  "id": { "type": "string" },
                  "severity": { "type": "string" },
                  "packageName": { "type": "string" },
                  "packageVersion": { "type": "string" },
                  "purl": { "type": ["string", "null"] },
                  "layer": { "type": "string", "enum": ["runtime", "base"] },
                  "fixedIn": { "type": ["string", "null"] },
                  "fixState": { "type": "string" },
                  "remediation": {
                    "type": "object",
                    "required": ["status", "reason", "summary"],
                    "properties": {
                      "status": { "type": "string", "enum": ["eligible", "deferred"] },
                      "reason": { "type": "string" },
                      "summary": { "type": "string" }
                    }
                  },
                  "inclusion": {
                    "type": "object",
                    "required": ["category", "summary"],
                    "properties": {
                      "category": { "type": "string" },
                      "summary": { "type": "string" }
                    }
                  },
                  "dataSource": { "type": ["string", "null"] },
                  "namespace": { "type": ["string", "null"] },
                  "description": { "type": ["string", "null"] },
                  "cvssScore": { "type": ["number", "null"] },
                  "cvssVersion": { "type": ["string", "null"] },
                  "cvssVector": { "type": ["string", "null"] },
                  "epssScore": { "type": ["number", "null"] },
                  "epssPercentile": { "type": ["number", "null"] },
                  "riskScore": { "type": ["number", "null"] }
                }
              }
            }
          }
        }
      }
    },
    "AttestationEntry": {
      "type": "object",
      "required": ["kind", "predicateType", "sources"],
      "properties": {
        "kind": { "type": "string", "enum": ["slsa-provenance", "sbom", "test-results", "custom"] },
        "predicateType": { "type": "string" },
        "subjectName": { "type": ["string", "null"] },
        "subjectDigest": { "type": ["string", "null"] },
        "signerIdentity": { "type": ["string", "null"] },
        "issuer": { "type": ["string", "null"] },
        "runUrl": { "type": ["string", "null"] },
        "workflowUrl": { "type": ["string", "null"] },
        "githubApiUrl": { "type": ["string", "null"] },
        "releaseAssetUrl": { "type": ["string", "null"] },
        "transparencyLogIndex": { "type": ["integer", "null"] },
        "transparencyUrl": { "type": ["string", "null"] },
        "sources": {
          "type": "array",
          "items": { "type": "string", "enum": ["oci", "github"] }
        }
      }
    },
    "ExceptionSummary": {
      "type": "object",
      "required": [
        "total",
        "expired",
        "active",
        "acceptedRisk",
        "noFixAvailable",
        "falsePositive",
        "inheritedFromBase"
      ],
      "properties": {
        "total": { "type": "integer" },
        "expired": { "type": "integer" },
        "active": { "type": "integer" },
        "acceptedRisk": { "type": "integer" },
        "noFixAvailable": { "type": "integer" },
        "falsePositive": { "type": "integer" },
        "inheritedFromBase": { "type": "integer" }
      }
    },
    "ReleaseEntry": {
      "type": "object",
      "required": [
        "tag",
        "publishedAt",
        "isLatest",
        "architectures",
        "attestations",
        "assetUrls",
        "lifecycle",
        "runtimeContract",
        "exceptions"
      ],
      "properties": {
        "tag": { "type": "string" },
        "publishedAt": { "type": "string" },
        "lastRebuiltAt": { "type": ["string", "null"] },
        "isLatest": { "type": "boolean" },
        "manifestDigest": { "type": ["string", "null"] },
        "totalSize": { "type": ["integer", "null"] },
        "architectures": {
          "type": "array",
          "items": { "$ref": "#/definitions/ArchPayload" }
        },
        "signature": {
          "type": ["object", "null"],
          "required": ["cosignBundlePresent"],
          "properties": {
            "cosignBundlePresent": { "type": "boolean" },
            "rekorLogIndex": { "type": ["integer", "null"] },
            "certificate": {
              "type": ["object", "null"],
              "properties": {
                "subject": { "type": ["string", "null"] },
                "issuer": { "type": ["string", "null"] },
                "runInvocation": { "type": ["string", "null"] }
              }
            }
          }
        },
        "provenance": {
          "type": ["object", "null"],
          "required": ["predicateType", "builder", "slsaLevel"],
          "properties": {
            "predicateType": { "type": "string" },
            "builder": {
              "type": "object",
              "required": ["id"],
              "properties": {
                "id": { "type": "string" }
              }
            },
            "buildType": { "type": ["string", "null"] },
            "sourceUri": { "type": ["string", "null"] },
            "sourceRevision": { "type": ["string", "null"] },
            "slsaLevel": { "type": "integer" }
          }
        },
        "attestations": {
          "type": "array",
          "items": { "$ref": "#/definitions/AttestationEntry" }
        },
        "assetUrls": {
          "type": "object",
          "required": ["sbom", "testResults"],
          "properties": {
            "sbom": {
              "type": "object",
              "additionalProperties": { "type": "string" }
            },
            "provenance": { "type": ["string", "null"] },
            "testResults": {
              "type": "object",
              "additionalProperties": { "type": "string" }
            },
            "digest": { "type": ["string", "null"] }
          }
        },
        "evidence": { "$ref": "catalog.schema.json#/definitions/EvidenceSummary" },
        "lifecycle": { "$ref": "catalog.schema.json#/definitions/Lifecycle" },
        "runtimeContract": { "$ref": "catalog.schema.json#/definitions/RuntimeContract" },
        "exceptions": { "$ref": "#/definitions/ExceptionSummary" }
      }
    }
  }
}
