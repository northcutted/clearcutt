---
import type { CatalogIndex } from '../lib/catalog-schema';
interface Props { index: CatalogIndex }
const { index } = Astro.props;
const base = (import.meta.env.BASE_URL ?? '/').replace(/\/$/, '') + '/';

const tierOrder: Array<'distroless' | 'slim' | 'dev'> = ['distroless', 'slim', 'dev'];

// Group images: row per language+version, columns per tier
const byLang = new Map<string, Map<string, typeof index.images[number]>>();
for (const img of index.images) {
  const key = `${img.language}-${img.languageVersion}`;
  if (!byLang.has(key)) byLang.set(key, new Map());
  byLang.get(key)!.set(img.tier, img);
}

const LANG_ORDER = ['core', 'java', 'node', 'python', 'go', 'dotnet'];
const rows = Array.from(byLang.entries()).sort(([a], [b]) => {
  const [la, va] = a.split('-');
  const [lb, vb] = b.split('-');
  const di = LANG_ORDER.indexOf(la) - LANG_ORDER.indexOf(lb);
  if (di !== 0) return di;
  return va.localeCompare(vb, undefined, { numeric: true });
});

function langIcon(id: string) {
  switch (id) {
    case 'java':   return '☕';
    case 'node':   return '⬢';
    case 'python': return '🐍';
    case 'go':     return '🐹';
    case 'dotnet': return '◆';
    default:       return '◯';
  }
}
---
<div class="surface overflow-hidden">
  <div class="grid grid-cols-[minmax(180px,1fr)_repeat(3,minmax(220px,1fr))] border-b border-ink-700/70 bg-ink-900/60 text-xs uppercase tracking-wider text-ink-300">
    <div class="px-5 py-3">Language</div>
    {tierOrder.map((t) => (
      <div class="px-5 py-3 border-l border-ink-700/40">
        <div class="text-ink-100">{t}</div>
        <div class="mt-0.5 text-[10px] normal-case tracking-normal text-ink-300">
          {t === 'distroless' && 'zero shells · hardened'}
          {t === 'slim' && 'runtime + minimal tooling'}
          {t === 'dev' && 'full toolchain · debug shells'}
        </div>
      </div>
    ))}
  </div>
  {rows.map(([rowKey, tiers]) => {
    const [langId, ver] = rowKey.split('-');
    const sample = Array.from(tiers.values())[0];
    return (
      <div class="grid grid-cols-[minmax(180px,1fr)_repeat(3,minmax(220px,1fr))] border-b border-ink-800 last:border-b-0">
        <div class="flex items-center gap-3 px-5 py-4">
          <span class="text-2xl leading-none">{langIcon(langId)}</span>
          <div>
            <div class="text-sm font-semibold text-ink-50">{sample?.languageDisplay ?? langId}</div>
            <div class="text-xs text-ink-300">{ver}</div>
          </div>
        </div>
        {tierOrder.map((tier) => {
          const img = tiers.get(tier);
          if (!img) {
            return <div class="border-l border-ink-800/70 px-5 py-4 text-ink-300 text-xs">—</div>;
          }
          const ref = `${index.registryBase}/clearcutt-${langId}${ver === 'LTS' ? 'lts' : ver}:${tier}`;
          return (
            <a
              href={`${base}images/${img.id}`}
              class="group block border-l border-ink-800/70 px-5 py-4 no-underline transition hover:bg-ink-800/50"
            >
              <div class="flex items-center justify-between">
                <span class="font-mono text-xs text-ink-100 group-hover:text-accent-soft truncate">
                  {ref.replace('ghcr.io/', '')}
                </span>
                <span class="font-mono text-[10px] text-ink-300 group-hover:text-ink-100">{img.latestTag}</span>
              </div>
              <div class="mt-2 flex flex-wrap items-center gap-1.5">
                {img.architectures.map((a) => <span class="chip text-[10px]">{a}</span>)}
                {img.signed && <span class="chip-accent text-[10px]">cosign</span>}
                {img.provenance && <span class="chip-accent text-[10px]">SLSA L3</span>}
                {img.vulnSummary ? (
                  (() => {
                    const c = img.vulnSummary.critical;
                    const h = img.vulnSummary.high;
                    if (c > 0) return <span class="chip-danger text-[10px]">{c} critical · {h} high</span>;
                    if (h > 0) return <span class="chip-warn text-[10px]">{h} high</span>;
                    return <span class="chip-accent text-[10px]">0 high CVEs</span>;
                  })()
                ) : img.passed ? (
                  <span class="chip-accent text-[10px]">Grype ✓</span>
                ) : (
                  <span class="chip-warn text-[10px]">unverified</span>
                )}
              </div>
              <div class="mt-3 flex items-center justify-between text-[11px] text-ink-300">
                <span>
                  {img.latestPackageCount > 0
                    ? `${img.latestPackageCount} packages`
                    : 'SBOM pending'}
                </span>
                {img.vulnSummary?.scannedAt && (
                  <span title={`Scanned ${img.vulnSummary.scannedAt}`}>
                    scan {new Date(img.vulnSummary.scannedAt).toUTCString().split(' ').slice(1, 4).join(' ')}
                  </span>
                )}
              </div>
            </a>
          );
        })}
      </div>
    );
  })}
</div>
