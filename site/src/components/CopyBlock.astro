---
import { Code } from 'astro:components';
import type { BundledLanguage } from 'shiki';

interface Props {
  code: string;
  language?: string;
  label?: string;
  /** Tailwind extras applied to the outer wrapper (e.g. `h-full` to make
   *  the block stretch in a grid cell). */
  class?: string;
}
const { code, language = 'shell', label, class: extra = '' } = Astro.props;

// Map the friendly language names we use in templates onto shiki bundle ids.
const LANG_MAP: Record<string, BundledLanguage> = {
  shell: 'bash',
  bash: 'bash',
  sh: 'bash',
  yaml: 'yaml',
  yml: 'yaml',
  nix: 'nix',
  json: 'json',
  ts: 'typescript',
  typescript: 'typescript',
  js: 'javascript',
  javascript: 'javascript',
  dockerfile: 'docker',
  docker: 'docker',
};
const shikiLang: BundledLanguage = LANG_MAP[language] ?? 'bash';
---
<div class={`copy-block group flex flex-col ${extra}`} data-copy-root>
  {label && (
    <div class="flex shrink-0 items-center justify-between border-b border-ink-600/60 bg-ink-900/80 px-4 py-2 text-xs uppercase tracking-wider text-ink-300">
      <span>{label}</span>
      <span class="font-mono text-[10px] text-ink-300">{language}</span>
    </div>
  )}
  {/* The Astro <Code /> component runs Shiki at build time. We pass two
      themes so the same HTML can render both Latte and Mocha — Shiki
      emits CSS variables for each, and global.css applies the right one
      based on whether `.dark` is on <html>. defaultColor:false is what
      makes Shiki emit BOTH light and dark colors as vars (no baked-in). */}
  <div class="flex-1 overflow-x-auto" data-copy-source>
    <Code
      code={code}
      lang={shikiLang}
      themes={{ light: 'catppuccin-latte', dark: 'catppuccin-mocha' }}
      defaultColor={false}
      wrap={true}
    />
  </div>
  <button
    type="button"
    class="absolute right-2 top-2 inline-flex items-center gap-1 rounded-md border border-ink-600/60 bg-ink-900/80 px-2 py-1 text-xs text-ink-200 opacity-0 transition group-hover:opacity-100 hover:border-accent/50 hover:text-accent-soft focus-visible:opacity-100"
    data-copy-btn
    aria-label="Copy code to clipboard"
  >
    <svg viewBox="0 0 24 24" class="h-3.5 w-3.5" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15V5a2 2 0 0 1 2-2h10"/></svg>
    <span>Copy</span>
  </button>
</div>
<script>
  document.querySelectorAll<HTMLElement>('[data-copy-root]').forEach((root) => {
    const btn = root.querySelector<HTMLButtonElement>('[data-copy-btn]');
    const src = root.querySelector<HTMLElement>('[data-copy-source]');
    if (!btn || !src) return;
    btn.addEventListener('click', async () => {
      // innerText is the visible text — shiki tokens are spans, so this
      // resolves to the original code without HTML markup or line numbers.
      const text = src.innerText;
      try {
        await navigator.clipboard.writeText(text);
        const label = btn.querySelector('span');
        if (label) {
          const old = label.textContent;
          label.textContent = 'Copied';
          setTimeout(() => { label.textContent = old; }, 1200);
        }
      } catch {}
    });
  });
</script>
