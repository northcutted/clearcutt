---
import SbomTable from './SbomTable.tsx';

interface Props {
  dataUrl: string;
  releaseTag: string;
  rawSbomUrls: Record<string, string>;
  language: string;
  tier: string;
  createdAt?: string;
}
const { dataUrl, releaseTag, rawSbomUrls, language, tier, createdAt } = Astro.props;
---
<section class="space-y-5">
  <header class="space-y-1 mb-5">
    <h2 class="heading text-lg">Software Bill of Materials</h2>
    <p class="text-sm text-ink-200">
      Every package included in the image's <code class="font-mono text-ink-100">/nix/store</code>
      closure. Generated from the actual OCI archive at build time and attached as an SPDX SBOM,
      using the same package inventory as the CVE findings above.
    </p>
    <p class="text-[11px] text-ink-300">
      {createdAt && (<>SBOM generated {new Date(createdAt).toUTCString()}. </>)}
      Toggle between architectures; the package set typically matches but layer hashes differ.
    </p>
  </header>
  <SbomTable dataUrl={dataUrl} releaseTag={releaseTag} rawSbomUrls={rawSbomUrls} language={language} tier={tier} client:visible />
</section>
