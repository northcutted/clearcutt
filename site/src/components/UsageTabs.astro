---
import Tabs from './Tabs.astro';
import CopyBlock from './CopyBlock.astro';
import type { ImageRecord, ReleaseEntry } from '../lib/catalog-schema';

interface Props {
  image: ImageRecord;
  release: ReleaseEntry;
  ownerRepo: string;
}
const { image, release } = Astro.props;
const rolling = `${image.fullName}:${image.tier.id}`;
const versioned = `${image.fullName}:${release.tag}-${image.tier.id}`;

const dockerRun = `docker run --rm \\
  --read-only \\
  --cap-drop=ALL \\
  --security-opt no-new-privileges \\
  --user 10001:10001 \\
  --tmpfs /tmp:mode=1777 \\
  ${versioned}`;

const podmanRun = `podman run --rm \\
  --read-only \\
  --cap-drop=ALL \\
  --security-opt no-new-privileges \\
  --user 10001:10001 \\
  --tmpfs /tmp:mode=1777 \\
  ${versioned}`;

const compose = `services:
  app:
    image: ${versioned}
    read_only: true
    user: "10001:10001"
    security_opt:
      - no-new-privileges:true
    cap_drop:
      - ALL
    tmpfs:
      - /tmp:mode=1777`;

const kube = `apiVersion: v1
kind: Pod
metadata:
  name: ${image.imageName}
spec:
  automountServiceAccountToken: false
  securityContext:
    runAsNonRoot: true
    runAsUser: 10001
    runAsGroup: 10001
    seccompProfile: { type: RuntimeDefault }
  containers:
    - name: app
      image: ${versioned}
      imagePullPolicy: IfNotPresent
      securityContext:
        readOnlyRootFilesystem: true
        allowPrivilegeEscalation: false
        capabilities: { drop: ["ALL"] }
      volumeMounts:
        - { name: tmp, mountPath: /tmp }
  volumes:
    - { name: tmp, emptyDir: { medium: Memory } }`;

// Nix overlay attribute names follow PascalCase + no-dot pattern
const cap = (s: string) => s.charAt(0).toUpperCase() + s.slice(1);
const nixAttr =
  image.language.id === 'core'
    ? 'clearcuttCore'
    : `clearcutt${cap(image.language.id)}${image.language.version.replace(/\./g, '')}`;

const nixFlake = `{
  inputs.clearcutt.url = "github:${image.registry.replace('ghcr.io/', '')}/${release.tag}";
  outputs = { self, nixpkgs, clearcutt }: {
    devShells.x86_64-linux.default = let
      pkgs = import nixpkgs {
        system = "x86_64-linux";
        overlays = [ clearcutt.overlays.default ];
      };
    in pkgs.mkShell {
      buildInputs = [ pkgs.${nixAttr} ];
    };
  };
}`;
---
<section class="space-y-4">
  <header class="flex items-center gap-3">
    <span class="inline-flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-accent/15 text-accent-soft border border-accent/35 font-mono text-sm font-bold select-none">
      1
    </span>
    <div>
      <h2 class="heading text-lg">Pull the Image</h2>
      <p class="text-xs text-ink-300">Select your preferred container runtime or package manager command closure.</p>
    </div>
  </header>

  <Tabs name={`usage-${image.id}`} tabs={[
    { id: 'docker', label: 'Docker' },
    { id: 'podman', label: 'Podman' },
    { id: 'compose', label: 'Docker Compose' },
    { id: 'k8s', label: 'Kubernetes' },
    { id: 'nix', label: 'Nix Flake' },
  ]}>
    <div data-panel-id="docker" data-panel-active="true" class="space-y-4">
      <div>
        <h3 class="mb-2 text-xs uppercase tracking-wider text-ink-300">Quick pull (rolling)</h3>
        <CopyBlock language="shell" code={`docker pull ${rolling}`} />
      </div>
      <div>
        <h3 class="mb-2 text-xs uppercase tracking-wider text-ink-300">Pinned to release</h3>
        <CopyBlock language="shell" code={`docker pull ${versioned}`} />
      </div>
      {release.manifestDigest && (
        <div>
          <h3 class="mb-2 text-xs uppercase tracking-wider text-ink-300">Pull multi-arch manifest by digest</h3>
          <CopyBlock language="shell" code={`docker pull ${image.fullName}@${release.manifestDigest}`} />
        </div>
      )}
      {release.architectures.map((arch) => arch.imageDigest && (
        <div>
          <h3 class="mb-2 text-xs uppercase tracking-wider text-ink-300">Pull specific arch ({arch.arch}) by digest</h3>
          <CopyBlock language="shell" code={`docker pull ${image.fullName}@${arch.imageDigest}`} />
        </div>
      ))}
      <div>
        <h3 class="mb-2 text-xs uppercase tracking-wider text-ink-300">Hardened docker run</h3>
        <CopyBlock language="shell" code={dockerRun} />
      </div>
    </div>

    <div data-panel-id="podman" data-panel-active="false" style="display:none" class="space-y-4">
      <div>
        <h3 class="mb-2 text-xs uppercase tracking-wider text-ink-300">Quick pull (rolling)</h3>
        <CopyBlock language="shell" code={`podman pull ${rolling}`} />
      </div>
      <div>
        <h3 class="mb-2 text-xs uppercase tracking-wider text-ink-300">Pinned to release</h3>
        <CopyBlock language="shell" code={`podman pull ${versioned}`} />
      </div>
      {release.manifestDigest && (
        <div>
          <h3 class="mb-2 text-xs uppercase tracking-wider text-ink-300">Pull multi-arch manifest by digest</h3>
          <CopyBlock language="shell" code={`podman pull ${image.fullName}@${release.manifestDigest}`} />
        </div>
      )}
      <div>
        <h3 class="mb-2 text-xs uppercase tracking-wider text-ink-300">Hardened podman run</h3>
        <CopyBlock language="shell" code={podmanRun} />
      </div>
    </div>

    <div data-panel-id="compose" data-panel-active="false" style="display:none">
      <CopyBlock language="yaml" code={compose} label="docker-compose.yml" />
    </div>

    <div data-panel-id="k8s" data-panel-active="false" style="display:none">
      <CopyBlock language="yaml" code={kube} label="pod.yaml" />
    </div>

    <div data-panel-id="nix" data-panel-active="false" style="display:none">
      <CopyBlock language="nix" code={nixFlake} label="flake.nix" />
    </div>
  </Tabs>
</section>
