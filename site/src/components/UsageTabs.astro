---
import Tabs from './Tabs.astro';
import CopyBlock from './CopyBlock.astro';
import type { ImageRecord, ReleaseEntry } from '../lib/catalog-schema';

interface Props {
  image: ImageRecord;
  release: ReleaseEntry;
  ownerRepo: string;
}
const { image, release, ownerRepo } = Astro.props;
const rolling = `${image.fullName}:${image.tier.id}`;
const versioned = `${image.fullName}:${release.tag}-${image.tier.id}`;
const langKey = image.language.id === 'core' ? 'coreLTS' : `${image.language.id}${image.language.version}`;

const dockerRun = `docker run --rm \\
  --read-only \\
  --cap-drop=ALL \\
  --security-opt no-new-privileges \\
  --user 10001:10001 \\
  --tmpfs /tmp:mode=1777 \\
  ${versioned}`;

const compose = `services:
  app:
    image: ${versioned}
    read_only: true
    user: "10001:10001"
    security_opt:
      - no-new-privileges:true
    cap_drop:
      - ALL
    tmpfs:
      - /tmp:mode=1777`;

const kube = `apiVersion: v1
kind: Pod
metadata:
  name: ${image.imageName}
spec:
  automountServiceAccountToken: false
  securityContext:
    runAsNonRoot: true
    runAsUser: 10001
    runAsGroup: 10001
    seccompProfile: { type: RuntimeDefault }
  containers:
    - name: app
      image: ${versioned}
      imagePullPolicy: IfNotPresent
      securityContext:
        readOnlyRootFilesystem: true
        allowPrivilegeEscalation: false
        capabilities: { drop: ["ALL"] }
      volumeMounts:
        - { name: tmp, mountPath: /tmp }
  volumes:
    - { name: tmp, emptyDir: { medium: Memory } }`;

const nixFlake = `{
  inputs.clearcutt.url = "github:${ownerRepo}/${release.tag}";
  outputs = { self, nixpkgs, clearcutt }: {
    devShells.x86_64-linux.default = let
      pkgs = import nixpkgs {
        system = "x86_64-linux";
        overlays = [ clearcutt.overlays.default ];
      };
    in pkgs.mkShell {
      buildInputs = [ pkgs.clearcutt${langKey} ];
    };
  };
}`;

const kyverno = `apiVersion: kyverno.io/v1
kind: ClusterPolicy
metadata:
  name: verify-${image.imageName}
spec:
  validationFailureAction: Enforce
  webhookTimeoutSeconds: 30
  rules:
    - name: verify-cosign-signature
      match:
        any:
          - resources:
              kinds: [Pod]
      verifyImages:
        - imageReferences: ["${image.fullName}:*"]
          attestors:
            - entries:
                - keyless:
                    subject: "${release.signature?.certificate?.subject ?? 'https://github.com/' + ownerRepo + '/.github/workflows/tag-release.yml@refs/tags/' + release.tag}"
                    issuer: "${release.signature?.certificate?.issuer ?? 'https://token.actions.githubusercontent.com'}"`;
---
<Tabs name={`usage-${image.id}`} tabs={[
  { id: 'docker', label: 'Docker' },
  { id: 'compose', label: 'Compose' },
  { id: 'k8s', label: 'Kubernetes' },
  { id: 'nix', label: 'Nix Flake' },
  { id: 'kyverno', label: 'Kyverno' },
]}>
  <div data-panel-id="docker" data-panel-active="true" class="space-y-4">
    <div>
      <h3 class="mb-2 text-xs uppercase tracking-wider text-ink-300">Quick pull (rolling)</h3>
      <CopyBlock language="shell" code={`docker pull ${rolling}`} />
    </div>
    <div>
      <h3 class="mb-2 text-xs uppercase tracking-wider text-ink-300">Pinned to release</h3>
      <CopyBlock language="shell" code={`docker pull ${versioned}`} />
    </div>
    <div>
      <h3 class="mb-2 text-xs uppercase tracking-wider text-ink-300">Hardened docker run</h3>
      <CopyBlock language="shell" code={dockerRun} />
    </div>
  </div>
  <div data-panel-id="compose" data-panel-active="false" style="display:none">
    <CopyBlock language="yaml" code={compose} label="docker-compose.yml" />
  </div>
  <div data-panel-id="k8s" data-panel-active="false" style="display:none">
    <CopyBlock language="yaml" code={kube} label="pod.yaml" />
  </div>
  <div data-panel-id="nix" data-panel-active="false" style="display:none">
    <CopyBlock language="nix" code={nixFlake} label="flake.nix" />
  </div>
  <div data-panel-id="kyverno" data-panel-active="false" style="display:none">
    <CopyBlock language="yaml" code={kyverno} label="policy.yaml" />
  </div>
</Tabs>
