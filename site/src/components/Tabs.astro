  }
  if (id === 'k8s') {
    return `<svg class="w-3.5 h-3.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M12 21a9.004 9.004 0 008.716-6.747M12 21a9.004 9.004 0 01-8.716-6.747M12 21V9.75M20.716 14.25a9.004 9.004 0 00-4.716-7.5M20.716 14.25h-5.466M3.284 14.25a9.004 9.004 0 014.716-7.5M3.284 14.25h5.466M16 6.75a9.004 9.004 0 00-8 0m8 0v3m-8-3v3m0 0h8" /></svg>`;
  }
  if (id === 'nix') {
    return `<svg class="w-3.5 h-3.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M12 3v18M3 12h18M5.636 5.636l12.728 12.728M5.636 18.364L18.364 5.636" /></svg>`;
  }
  if (id === 'labels') {
    return `<svg class="w-3.5 h-3.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9.568 3H5.25A2.25 2.25 0 003 5.25v4.318c0 .597.237 1.17.659 1.591l9.581 9.581a1.125 1.125 0 001.591 0l7.1-7.1a1.125 1.125 0 000-1.591L11.159 3.659A2.25 2.25 0 009.568 3z" /><path stroke-linecap="round" stroke-linejoin="round" d="M6 7.5h.007v.008H6V7.5z" /></svg>`;
  }
  if (id === 'versions') {
