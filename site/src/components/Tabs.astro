---
<div class="surface border border-ink-800 bg-ink-950/20 backdrop-blur-md rounded-2xl shadow-xl shadow-ink-950/50 overflow-hidden" data-tabs={name}>
  <div class="flex flex-wrap items-center border-b border-ink-800/50 px-4 py-3 bg-ink-950/30" role="tablist">
    <div class="flex flex-wrap gap-1 bg-ink-950/60 rounded-xl p-1 border border-ink-800/80">
      {tabs.map((t) => (
        <button
          type="button"
          role="tab"
          data-tab-id={t.id}
          data-tab-active={t.id === active ? 'true' : 'false'}
          class="rounded-lg px-3.5 py-1.5 text-[11px] font-bold font-sans tracking-wider uppercase text-ink-300 transition-all duration-200 cursor-pointer data-[tab-active=true]:bg-accent/15 data-[tab-active=true]:text-accent-soft data-[tab-active=true]:shadow-sm data-[tab-active=true]:shadow-accent/5 hover:text-ink-50 focus:outline-none flex items-center gap-2"
        >
          {(() => {
            const svg = getTabIcon(t.id);
            return svg ? <Fragment set:html={svg} /> : null;
          })()}
          {t.label}
        </button>
      ))}
    </div>
  </div>
  {/* Relative wrapper containing scoped transition CSS rules for sleek switching */}
  <div class="px-6 py-5 min-h-[10rem] relative overflow-hidden" data-tabs-panels>
    <slot />
  </div>
</div>

<style>
  :global([data-panel-id]) {
    transition: opacity 0.22s cubic-bezier(0.4, 0, 0.2, 1), transform 0.22s cubic-bezier(0.4, 0, 0.2, 1);
  }
  
  :global([data-panel-active="false"]) {
    opacity: 0;
    transform: translateY(4px) scale(0.99);
    position: absolute;
    inset-x: 0;
    width: calc(100% - 3rem); /* Compensate padding (px-6 is 1.5rem * 2) */
    margin-left: 1.5rem;
    pointer-events: none;
    visibility: hidden;
    height: 0;
    overflow: hidden;
  }
  
  :global([data-panel-active="true"]) {
    opacity: 1;
    transform: translateY(0) scale(1);
    position: relative;
    pointer-events: auto;
    visibility: visible;
    height: auto;
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-tabs]').forEach((root) => {
    const buttons = root.querySelectorAll<HTMLButtonElement>('[data-tab-id]');
    const panels = root.querySelectorAll<HTMLElement>('[data-panel-id]');
    const activate = (id: string) => {
      buttons.forEach((b) => (b.dataset.tabActive = b.dataset.tabId === id ? 'true' : 'false'));
      panels.forEach((p) => {
        const match = p.dataset.panelId === id;
        p.dataset.panelActive = match ? 'true' : 'false';
      });
    };
    // Set initial visibility based on data-tab-active on buttons.
    const initial = Array.from(buttons).find((b) => b.dataset.tabActive === 'true')?.dataset.tabId;
    if (initial) activate(initial);
    buttons.forEach((btn) => btn.addEventListener('click', () => activate(btn.dataset.tabId!)));
  });
</script>
