---
import type { ArchPayload } from '../lib/catalog-schema';

interface Props { architectures: ArchPayload[] }
const { architectures } = Astro.props;

function humanBytes(n: number | null | undefined): string {
  if (!n) return '—';
  const units = ['B','KB','MB','GB'];
  let i = 0;
  let v = n;
  while (v >= 1024 && i < units.length - 1) { v /= 1024; i += 1; }
  return `${v.toFixed(v < 10 ? 2 : 1)} ${units[i]}`;
}
---
<section class="space-y-3">
  <h2 class="heading text-lg">Layers</h2>
  <div class="grid gap-4 lg:grid-cols-2">
    {architectures.map((a) => (
      <details class="surface-soft" open>
        <summary class="flex cursor-pointer items-center justify-between gap-4 border-b border-ink-700/60 px-4 py-3 text-sm font-medium text-ink-50">
          <span class="font-mono">{a.arch}</span>
          <span class="text-xs text-ink-300">{a.layerCount ?? a.layers.length} layers · {humanBytes(a.imageSize)}</span>
        </summary>
        {a.layers.length === 0 ? (
          <p class="px-4 py-4 text-sm text-ink-300">
            Layer info will be filled in by the enrichment pass.
          </p>
        ) : (
          <table class="table-clean">
            <thead>
              <tr>
                <th>#</th>
                <th>Digest</th>
                <th class="text-right">Size</th>
              </tr>
            </thead>
            <tbody>
              {a.layers.map((l, i) => (
                <tr>
                  <td class="text-ink-300">{i + 1}</td>
                  <td class="font-mono text-[11px] break-all">{l.digest}</td>
                  <td class="text-right font-mono text-xs">{humanBytes(l.size)}</td>
                </tr>
              ))}
            </tbody>
          </table>
        )}
      </details>
    ))}
  </div>
</section>
