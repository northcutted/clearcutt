---
import type { ImageRecord } from '../lib/catalog-schema';
interface Props {
  image: ImageRecord;
  currentTag: string;
}
const { image, currentTag } = Astro.props;
const base = (import.meta.env.BASE_URL ?? '/').replace(/\/$/, '') + '/';
const latestTag = image.releases[0]?.tag;
---
<div class="space-y-3">
  <div class="surface-soft overflow-hidden">
    <table class="table-clean">
      <thead>
        <tr>
          <th>Tag</th>
          <th>Published</th>
          <th>Archs</th>
          <th>Packages</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        {image.releases.map((r) => {
          const archs = r.architectures.map((a) => a.arch);
          const pkgs = r.architectures.reduce((s, a) => s + a.sbom.packageCount, 0) /
            Math.max(1, r.architectures.length);
          const url = r.tag === latestTag
            ? `${base}images/${image.id}`
            : `${base}images/${image.id}/${r.tag}`;
          return (
            <tr>
              <td>
                <a href={url} class={`font-mono ${r.tag === currentTag ? 'text-accent-soft' : 'text-ink-100 hover:text-accent-soft'}`}>{r.tag}</a>
                {r.isLatest && <span class="ml-2 chip-accent text-[10px]">latest</span>}
              </td>
              <td class="text-ink-200">{new Date(r.publishedAt).toUTCString()}</td>
              <td>{archs.map((a) => <span class="chip text-[10px] mr-1">{a}</span>)}</td>
              <td class="font-mono text-xs">{Math.round(pkgs)}</td>
              <td class="text-right">
                {r.assetUrls.provenance && (
                  <a href={r.assetUrls.provenance} class="text-xs text-ink-300 hover:text-accent-soft" target="_blank" rel="noreferrer">
                    .intoto.jsonl ↗
                  </a>
                )}
              </td>
            </tr>
          );
        })}
      </tbody>
    </table>
  </div>
</div>
