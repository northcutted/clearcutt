---
import type { ReleaseEntry } from '../lib/catalog-schema';
interface Props {
  release: ReleaseEntry;
  ownerRepo: string;
}
const { release, ownerRepo } = Astro.props;
const prov = release.provenance;

function friendlyPredicate(type: string): string {
  if (!type || type === 'unknown') return 'unknown';
  if (type.includes('provenance/v1')) return 'SLSA Provenance v1.0';
  if (type.includes('provenance/v0.2')) return 'SLSA Provenance v0.2';
  return type;
}

function friendlyBuildType(type: string | null): string {
  if (!type || type === '—') return '—';
  if (type.includes('actions.github.com/buildTypes/')) return 'GitHub Actions Workflow';
  return type;
}

function friendlyBuilder(id: string): { label: string; url: string | null } {
  if (!id || id === 'unknown') return { label: 'unknown', url: null };
  if (id.includes('slsa-github-generator')) {
    const tagMatch = id.match(/@refs\/tags\/(v[0-9.]+)/) || id.match(/@(v[0-9.]+)/);
    const tag = tagMatch ? ` (${tagMatch[1]})` : '';
    return { label: `SLSA GitHub Generator${tag}`, url: id };
  }
  if (id.includes('attest-build-provenance')) {
    return { label: 'GitHub Provenance Attestor', url: id };
  }
  if (id.startsWith('https://')) {
    try {
      const url = new URL(id);
      return { label: url.hostname + url.pathname, url: id };
    } catch {
      return { label: id, url: id };
    }
  }
  return { label: id, url: id };
}
---
<section class="space-y-3">
  <header class="flex flex-wrap items-baseline justify-between gap-2">
    <h2 class="heading text-lg">Provenance &amp; signatures</h2>
    {release.assetUrls.provenance && (
      <a href={release.assetUrls.provenance} class="text-xs text-ink-300 hover:text-accent-soft" target="_blank" rel="noreferrer">
        raw in-toto JSONL ↗
      </a>
    )}
  </header>
  {!prov && release.signature?.cosignBundlePresent && (
    <div class="surface-soft px-5 py-4 text-sm">
      <p class="text-ink-200">
        Image is <strong class="text-ink-50">cosign-signed</strong>, but no SLSA Level 3
        provenance attestation was found on the GHCR manifest for this release. The
        signature certificate identifies the builder; the formal in-toto provenance envelope
        is expected from the slsa-github-generator step.
      </p>
      {release.signature?.certificate?.subject && (
        <div class="mt-3 font-mono text-[11px] text-ink-200 break-all">
          <span class="text-ink-300">cert subject:</span> {release.signature.certificate.subject}
        </div>
      )}
    </div>
  )}
  {!prov && !release.signature?.cosignBundlePresent && (
    <p class="text-sm text-ink-300">
      No provenance or signature attestation found on the GHCR manifest. Either the build
      pipeline didn't attest this release, or the image was not published.
    </p>
  )}
  {prov && (
    <div class="surface-soft px-5 py-4">
      <dl class="grid gap-x-8 gap-y-3 text-sm sm:grid-cols-[max-content_1fr]">
        <dt class="text-xs uppercase tracking-wider text-ink-300">SLSA level</dt>
        <dd><span class="chip-accent">Level {prov.slsaLevel}</span></dd>

        <dt class="text-xs uppercase tracking-wider text-ink-300">Predicate</dt>
        <dd class="font-mono text-xs break-all">{friendlyPredicate(prov.predicateType)}</dd>

        <dt class="text-xs uppercase tracking-wider text-ink-300">Build type</dt>
        <dd class="font-mono text-xs break-all">{friendlyBuildType(prov.buildType)}</dd>

        <dt class="text-xs uppercase tracking-wider text-ink-300">Builder</dt>
        <dd class="font-mono text-xs break-all">
          {(() => {
            const builder = friendlyBuilder(prov.builder.id);
            return builder.url ? (
              <a href={builder.url} class="text-ink-100 hover:text-accent-soft underline decoration-accent/40" target="_blank" rel="noreferrer">
                {builder.label}
              </a>
            ) : (
              <span class="text-ink-300">{builder.label}</span>
            );
          })()}
        </dd>

        <dt class="text-xs uppercase tracking-wider text-ink-300">Source</dt>
        <dd class="font-mono text-xs break-all">
          {prov.sourceUri ?? `github.com/${ownerRepo}`}
          {prov.sourceRevision && (<>
            <br />
            <span class="text-ink-300">@</span> {prov.sourceRevision}
          </>)}
        </dd>

        {release.signature && (
          <>
            <dt class="text-xs uppercase tracking-wider text-ink-300">Cosign</dt>
            <dd>
              {release.signature.cosignBundlePresent
                ? <span class="chip-accent">Signature present</span>
                : <span class="chip-warn">No signature detected</span>}
              {release.signature.certificate?.subject && (
                <div class="mt-2 font-mono text-[11px] text-ink-200 break-all">
                  identity: {release.signature.certificate.subject}
                </div>
              )}
            </dd>
          </>
        )}
      </dl>
    </div>
  )}
</section>
