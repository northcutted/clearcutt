---
import type { ReleaseEntry } from '../lib/catalog-schema';
interface Props {
  release: ReleaseEntry;
  ownerRepo: string;
}
const { release, ownerRepo } = Astro.props;
const prov = release.provenance;
const sig = release.signature;

function friendlyPredicate(type: string): string {
  if (!type || type === 'unknown') return 'unknown';
  if (type.includes('provenance/v1')) return 'SLSA Provenance v1.0';
  if (type.includes('provenance/v0.2')) return 'SLSA Provenance v0.2';
  return type;
}

function friendlyBuildType(type: string | null): string {
  if (!type || type === '—') return '—';
  if (type.includes('actions.github.com/buildTypes/')) return 'GitHub Actions Workflow';
  return type;
}

function friendlyBuilder(id: string): { label: string; url: string | null } {
  if (!id || id === 'unknown') return { label: 'unknown', url: null };
  if (id.includes('slsa-github-generator')) {
    const tagMatch = id.match(/@refs\/tags\/(v[0-9.]+)/) || id.match(/@(v[0-9.]+)/);
    const tag = tagMatch ? ` (${tagMatch[1]})` : '';
    return { label: `SLSA GitHub Generator${tag}`, url: id };
  }
  if (id.includes('attest-build-provenance')) {
    return { label: 'GitHub Provenance Attestor', url: id };
  }
  if (id.startsWith('https://')) {
    try {
      const url = new URL(id);
      return { label: url.hostname + url.pathname, url: id };
    } catch {
      return { label: id, url: id };
    }
  }
  return { label: id, url: id };
}

interface ParsedSubject {
  owner: string;
  repo: string;
  workflow: string;
  ref: string;
}

function parseOidcSubject(subject: string | null | undefined): ParsedSubject | null {
  if (!subject) return null;
  // Format: https://github.com/owner/repo/.github/workflows/workflow.yml@refs/heads/branch or similar
  const match = subject.match(/github\.com\/([^/]+)\/([^/]+)\/\.github\/workflows\/([^@\s]+)@(.*)/);
  if (match) {
    return {
      owner: match[1],
      repo: match[2],
      workflow: `.github/workflows/${match[3]}`,
      ref: match[4]
    };
  }
  const simpleMatch = subject.match(/github\.com\/([^/]+)\/([^/]+)\/\.github\/workflows\/([^@\s]+)/);
  if (simpleMatch) {
    return {
      owner: simpleMatch[1],
      repo: simpleMatch[2],
      workflow: `.github/workflows/${simpleMatch[3]}`,
      ref: 'main'
    };
  }
  return null;
}

function shortSha(sha: string | null | undefined): string | null {
  if (!sha) return null;
  return sha.length > 7 ? sha.substring(0, 7) : sha;
}

const oidcDetails = sig?.certificate ? parseOidcSubject(sig.certificate.subject) : null;
---
<section class="space-y-4">
  <header class="flex flex-wrap items-baseline justify-between gap-2 border-b border-ink-800/40 pb-2">
    <div>
      <h2 class="heading text-lg">Provenance &amp; signatures</h2>
      <p class="text-xs text-ink-300">Cryptographically audit OCI identity claims and supply chain gating artifacts.</p>
    </div>
    {release.assetUrls.provenance && (
      <a href={release.assetUrls.provenance} class="chip hover:border-accent/40 font-mono text-xs flex items-center gap-1 shrink-0" target="_blank" rel="noreferrer">
        raw in-toto JSONL <span class="text-[10px]">↗</span>
      </a>
    )}
  </header>

  {!prov && !sig?.cosignBundlePresent ? (
    <div class="surface-soft p-6 rounded-2xl border border-ink-800/40 text-center">
      <p class="text-sm text-ink-300">
        No provenance or signature attestation found on the GHCR manifest. Either the build
        pipeline didn't attest this release, or the image was not published.
      </p>
    </div>
  ) : (
    <div class="grid gap-5 md:grid-cols-2">
      {/* CARD 1: Cryptographic Signatures (Cosign) */}
      <div class="surface-soft border border-ink-800/40 rounded-2xl p-5 space-y-4 flex flex-col justify-between">
        <div class="space-y-3">
          <header class="flex items-center justify-between border-b border-ink-800/50 pb-2.5">
            <h3 class="text-xs uppercase tracking-wider text-ink-300 font-bold">Cryptographic Proof</h3>
            {sig?.cosignBundlePresent ? (
              <span class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded-full text-[10px] font-bold bg-emerald-500/10 text-emerald-400 border border-emerald-500/25">
                <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse" />
                VERIFIED KEYLESS
              </span>
            ) : (
              <span class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded-full text-[10px] font-bold bg-warn/10 text-warn border border-warn/25">
                <span class="w-1.5 h-1.5 rounded-full bg-warn" />
                NO COSIGN SIGNATURE
              </span>
            )}
          </header>

          {sig?.cosignBundlePresent ? (
            <div class="divide-y divide-ink-800/30">
              {oidcDetails && (
                <>
                  <div class="flex items-baseline justify-between text-xs py-2">
                    <span class="text-ink-300 font-medium">Source Repo</span>
                    <a href={`https://github.com/${oidcDetails.owner}/${oidcDetails.repo}`} class="text-ink-100 font-mono hover:text-accent-soft underline decoration-accent/40" target="_blank" rel="noreferrer">
                      {oidcDetails.owner}/{oidcDetails.repo}
                    </a>
                  </div>
                  <div class="flex items-baseline justify-between text-xs py-2">
                    <span class="text-ink-300 font-medium">Signing Workflow</span>
                    <span class="text-ink-100 font-mono text-[11px] truncate max-w-[200px] sm:max-w-[260px]" title={oidcDetails.workflow}>
                      {oidcDetails.workflow.split('/').pop()}
                    </span>
                  </div>
                  <div class="flex items-baseline justify-between text-xs py-2">
                    <span class="text-ink-300 font-medium">Workflow Ref</span>
                    <span class="px-1.5 py-0.5 rounded bg-ink-950/60 border border-ink-800 text-[10px] text-ink-200 font-mono">
                      {oidcDetails.ref}
                    </span>
                  </div>
                </>
              )}
              
              <div class="flex items-baseline justify-between text-xs py-2">
                <span class="text-ink-300 font-medium">OIDC Issuer</span>
                <span class="text-ink-200 font-mono text-[10px]">
                  {sig.certificate?.issuer ? sig.certificate.issuer.replace('https://', '') : 'token.actions.githubusercontent.com'}
                </span>
              </div>

              {sig.rekorLogIndex && (
                <div class="flex items-baseline justify-between text-xs py-2">
                  <span class="text-ink-300 font-medium">Rekor Entry</span>
                  <a href={`https://search.sigstore.dev/?logIndex=${sig.rekorLogIndex}`} class="text-accent-soft font-mono hover:text-accent font-semibold underline decoration-accent/35" target="_blank" rel="noreferrer">
                    Log Index #{sig.rekorLogIndex} ↗
                  </a>
                </div>
              )}
            </div>
          ) : (
            <p class="text-xs text-ink-300 leading-relaxed pt-2">
              This OCI release has not been signed via standard keyless sigstore/cosign OIDC tokens. Verify local deployment rules to ensure verification blocks are satisfied.
            </p>
          )}
        </div>

        {sig?.cosignBundlePresent && sig.certificate?.subject && (
          <div class="rounded-lg border border-ink-800 bg-ink-950/70 p-2.5 font-mono text-[9.5px] text-ink-300 break-all leading-normal">
            <div class="text-[9px] uppercase tracking-wider font-sans font-bold text-ink-400 mb-1 select-none">OIDC Certificate Subject</div>
            {sig.certificate.subject}
          </div>
        )}
      </div>

      {/* CARD 2: SLSA Build Provenance */}
      <div class="surface-soft border border-ink-800/40 rounded-2xl p-5 space-y-4 flex flex-col justify-between">
        <div class="space-y-3">
          <header class="flex items-center justify-between border-b border-ink-800/50 pb-2.5">
            <h3 class="text-xs uppercase tracking-wider text-ink-300 font-bold">Supply Chain Provenance</h3>
            {prov ? (
              <span class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded-full text-[10px] font-bold bg-accent/15 text-accent-soft border border-accent/25">
                <span class="w-1.5 h-1.5 rounded-full bg-accent shadow-[0_0_8px_rgba(var(--accent),0.5)]" />
                SLSA LEVEL {prov.slsaLevel}
              </span>
            ) : (
              <span class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded-full text-[10px] font-bold bg-ink-800 text-ink-300 border border-ink-700/50">
                NO PROVENANCE
              </span>
            )}
          </header>

          {prov ? (
            <div class="divide-y divide-ink-800/30">
              <div class="flex items-baseline justify-between text-xs py-2">
                <span class="text-ink-300 font-medium">Builder</span>
                {(() => {
                  const b = friendlyBuilder(prov.builder.id);
                  return b.url ? (
                    <a href={b.url} class="text-ink-100 font-mono hover:text-accent-soft underline decoration-accent/40" target="_blank" rel="noreferrer">
                      {b.label}
                    </a>
                  ) : (
                    <span class="text-ink-200 font-mono">{b.label}</span>
                  );
                })()}
              </div>

              <div class="flex items-baseline justify-between text-xs py-2">
                <span class="text-ink-300 font-medium">Build Type</span>
                <span class="text-ink-200 font-mono text-[11px] truncate max-w-[200px] sm:max-w-[240px]">
                  {friendlyBuildType(prov.buildType)}
                </span>
              </div>

              <div class="flex items-baseline justify-between text-xs py-2">
                <span class="text-ink-300 font-medium">Predicate Schema</span>
                <span class="text-ink-200 font-mono text-[10px]">
                  {friendlyPredicate(prov.predicateType).split('/').pop()}
                </span>
              </div>

              <div class="flex items-baseline justify-between text-xs py-2">
                <span class="text-ink-300 font-medium">Source Material</span>
                <span class="text-ink-100 font-mono text-[11px]" title={prov.sourceUri || `github.com/${ownerRepo}`}>
                  {prov.sourceUri ? prov.sourceUri.replace('git+https://', '') : `github.com/${ownerRepo}`}
                </span>
              </div>

              {prov.sourceRevision && (
                <div class="flex items-baseline justify-between text-xs py-2">
                  <span class="text-ink-300 font-medium">Commit SHA</span>
                  <a href={`https://github.com/${ownerRepo}/commit/${prov.sourceRevision}`} class="px-1.5 py-0.5 rounded bg-ink-950/60 border border-ink-800 text-[10px] text-accent-soft font-mono font-bold hover:text-accent" target="_blank" rel="noreferrer">
                    {shortSha(prov.sourceRevision)} ↗
                  </a>
                </div>
              )}
            </div>
          ) : (
            <p class="text-xs text-ink-300 leading-relaxed pt-2">
              No formal supply chain build provenance envelope was found. Attesting compiler runs prevents tampering by linking binary digests to cryptographic parent hashes.
            </p>
          )}
        </div>

        {prov && (
          <div class="rounded-lg border border-ink-800 bg-ink-950/70 p-2.5 font-mono text-[9.5px] text-ink-300 flex items-center justify-between select-none">
            <span class="text-ink-400 font-sans font-semibold">Non-falsifiable attestation gate:</span>
            <span class="text-emerald-400 font-semibold font-mono flex items-center gap-1.5">
              <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 shadow-[0_0_8px_rgba(52,211,153,0.4)]" /> Passed
            </span>
          </div>
        )}
      </div>
    </div>
  )}
</section>
