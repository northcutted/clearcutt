---
import type { ImageRecord } from '../lib/catalog-schema';
import StatusPill from './StatusPill.astro';
import LangIcon from './LangIcon.astro';

interface Props {
  image: ImageRecord;
  selectedTag: string;
}
const { image, selectedTag } = Astro.props;
const release = image.releases.find((r) => r.tag === selectedTag) ?? image.releases[0];
const base = (import.meta.env.BASE_URL ?? '/').replace(/\/$/, '') + '/';
const arches = release.architectures.map((a) => a.arch);
const passed = release.architectures.length > 0 && release.architectures.every((a) => a.testResults?.status === 'passed');
const allReleases = image.releases;
const evidence = release.evidence ?? {
  signature: !!release.signature?.cosignBundlePresent,
  provenance: !!release.provenance,
  sbom: release.architectures.length > 0 && release.architectures.every((a) => (a.sbom?.packageCount || 0) > 0),
  tests: passed,
  vulnerabilities: release.architectures.length > 0 && release.architectures.every((a) => !!a.vulnerabilities),
};

// Stage 5 dead-man's-switch check (30 days threshold)
const lastRebuiltAt = release.lastRebuiltAt || release.publishedAt;
const lastRebuiltDate = new Date(lastRebuiltAt);
const isStale = (new Date().getTime() - lastRebuiltDate.getTime()) > (30 * 24 * 60 * 60 * 1000);
---
<section class="surface px-6 py-6 sm:px-8 sm:py-8">
  <div class="flex flex-wrap items-start justify-between gap-6">
    <div class="flex items-start gap-4">
      <span class="inline-flex h-14 w-14 shrink-0 items-center justify-center rounded-xl border border-ink-700/60 bg-ink-800/60 p-3">
        <LangIcon language={image.language.id} class="h-8 w-8" />
      </span>
      <div class="space-y-3">
      <div class="flex flex-wrap items-center gap-3 text-xs uppercase tracking-[0.18em] text-ink-300">
        <span>{image.language.displayName} {image.language.version}</span>
        <span class="text-ink-500">·</span>
        <span>{image.tier.name}</span>
      </div>
      <h1 class="heading text-2xl sm:text-3xl">
        <span class="font-mono text-ink-50">{image.imageName}</span>
        <span class="text-ink-300">:</span>
        <span class="text-accent-soft">{image.tier.id}</span>
      </h1>
      <p class="max-w-2xl text-sm text-ink-200">{image.tier.blurb}</p>
      <div class="flex flex-wrap items-center gap-2">
        <span class="chip">{release.tag}</span>
        {arches.map((a) => <span class="chip">{a}</span>)}
        {evidence.signature
          ? <StatusPill kind="ok" label="Cosign signed" />
          : <StatusPill kind="warn" label="Signature missing" />}
        {evidence.provenance
          ? <StatusPill kind="ok" label="SLSA L3" />
          : <StatusPill kind="warn" label="Provenance missing" />}
        {evidence.sbom
          ? <StatusPill kind="ok" label="SBOM attached" />
          : <StatusPill kind="warn" label="SBOM incomplete" />}
        {evidence.vulnerabilities
          ? <StatusPill kind="ok" label="Scan attached" />
          : <StatusPill kind="warn" label="Scan pending" />}
        {passed
          ? <StatusPill kind="ok" label="Vulnerability gate passed" />
          : <StatusPill kind="warn" label="Gate pending" />}
        {isStale && <StatusPill kind="warn" label="maintenance-stale" />}
      </div>
      {release.manifestDigest && (
        <div class="mt-4 flex flex-wrap items-center gap-3 text-xs">
          <span class="text-ink-300">Multi-arch Manifest Digest:</span>
          <div class="flex items-center gap-2 rounded bg-ink-950/80 px-2 py-1 font-mono border border-ink-700/40 text-ink-100" data-digest-copy-root>
            <span data-digest-val class="text-[11px] truncate max-w-[200px] sm:max-w-xs">{release.manifestDigest}</span>
            <button
              type="button"
              class="text-ink-300 hover:text-accent-soft p-0.5"
              data-digest-copy-btn
              title="Copy manifest digest to clipboard"
            >
              <svg viewBox="0 0 24 24" class="h-3.5 w-3.5" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15V5a2 2 0 0 1 2-2h10"/></svg>
            </button>
          </div>
        </div>
      )}
      </div>
    </div>
    <div class="flex flex-col items-end gap-3">
      <label class="text-[11px] uppercase tracking-wider text-ink-300">Release</label>
      <div class="relative">
        <select
          class="appearance-none rounded-lg border border-ink-700 bg-ink-900 px-4 py-2 pr-10 font-mono text-sm text-ink-100 focus:border-accent focus:outline-none"
          data-version-switcher={image.id}
        >
          {allReleases.map((r) => (
            <option value={r.tag} selected={r.tag === selectedTag}>{r.tag}</option>
          ))}
        </select>
        <svg viewBox="0 0 24 24" class="pointer-events-none absolute right-3 top-1/2 h-4 w-4 -translate-y-1/2 text-ink-300" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"/></svg>
      </div>
      <p class="text-[11px] text-ink-300">Published {new Date(release.publishedAt).toUTCString()}</p>
      <p class="text-[11px] text-accent-soft" title="Last successful scan/rebuild of this runtime overlay layer">Last Rebuild {lastRebuiltDate.toUTCString()}</p>
    </div>
  </div>
</section>
<script is:inline define:vars={{ base, imageId: image.id, latestTag: image.releases[0].tag }}>
  document.querySelectorAll('[data-version-switcher]').forEach((sel) => {
    sel.addEventListener('change', (e) => {
      const tag = e.target.value;
      const target = tag === latestTag
        ? base + 'images/' + imageId
        : base + 'images/' + imageId + '/' + tag;
      window.location.href = target;
    });
  });

  document.querySelectorAll('[data-digest-copy-root]').forEach((root) => {
    const btn = root.querySelector('[data-digest-copy-btn]');
    const val = root.querySelector('[data-digest-val]');
    if (!btn || !val) return;
    btn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(val.textContent.trim());
        const svg = btn.innerHTML;
        btn.innerHTML = `<span class="text-[10px] text-accent-soft font-sans font-semibold">Copied</span>`;
        setTimeout(() => { btn.innerHTML = svg; }, 1200);
      } catch {}
    });
  });
</script>
