---
import type { ImageRecord } from '../lib/catalog-schema';
import StatusPill from './StatusPill.astro';
import LangIcon from './LangIcon.astro';
import { loadSiteConfig, tierLabel } from '../lib/site-config';
import { channelStatus, evidencePillKind, statusLabel } from '../lib/evidence-status';

interface Props {
  image: ImageRecord;
  selectedTag: string;
}
const { image, selectedTag } = Astro.props;
const release = image.releases.find((r) => r.tag === selectedTag) ?? image.releases[0];
const siteConfig = loadSiteConfig();
const isService = image.kind === 'service';
const isImported = image.governance?.imported || image.origin?.kind === 'imported' || image.origin?.createdByClearCutt === false || image.origin?.provenanceClaim === 'none';
const tierName = isService ? 'Service' : tierLabel(siteConfig, image.tier.id);
const tierRole = isService
  ? `${image.service?.template ?? 'Platform service'} image`
  : image.tier.id === 'distroless'
  ? `${tierName} runtime`
  : image.tier.id === 'slim'
    ? `${tierName} runtime`
    : `${tierName} builder`;
const base = (import.meta.env.BASE_URL ?? '/').replace(/\/$/, '') + '/';
const arches = release.architectures.map((a) => a.arch);
const passed = release.architectures.length > 0 && release.architectures.every((a) => a.testResults?.status === 'passed');
const allReleases = image.releases;
const evidence = release.evidence;
const signatureStatus = channelStatus(evidence, 'signature', !!release.signature?.cosignBundlePresent);
const provenanceStatus = channelStatus(evidence, 'provenance', !!release.provenance);
const sbomStatus = channelStatus(evidence, 'sbom', release.architectures.length > 0 && release.architectures.every((a) => (a.sbom?.packageCount || 0) > 0));
const scanStatus = channelStatus(evidence, 'vulnerabilities', release.architectures.length > 0 && release.architectures.every((a) => !!a.vulnerabilities));
const testStatus = channelStatus(evidence, 'tests', passed);
const supportKind = ['lts', 'current', 'supported', 'active'].includes(release.lifecycle.support.toLowerCase()) ? 'ok' : 'warn';

// Stage 5 dead-man's-switch check (30 days threshold)
const lastRebuiltAt = release.lastRebuiltAt || release.publishedAt;
const lastRebuiltDate = new Date(lastRebuiltAt);
const isStale = (new Date().getTime() - lastRebuiltDate.getTime()) > (30 * 24 * 60 * 60 * 1000);
const scanStateLabel = `Scan data ${statusLabel(scanStatus.status).toLowerCase()}`;
const scanStateTitle = scanStatus.claim || `Vulnerability scan status: ${statusLabel(scanStatus.status)}.`;
---
<section class="surface px-6 py-6 sm:px-8 sm:py-8">
  <div class="flex flex-wrap items-start justify-between gap-6">
    <div class="flex items-start gap-4">
      <span class="inline-flex h-14 w-14 shrink-0 items-center justify-center rounded-xl border border-ink-700/60 bg-ink-800/60 p-3">
        <LangIcon language={image.language.id} class="h-8 w-8" />
      </span>
      <div class="space-y-3">
      <div class="flex flex-wrap items-center gap-3 text-xs uppercase tracking-[0.18em] text-ink-300">
        <span>{image.language.displayName} {image.language.version}</span>
        <span class="text-ink-500">·</span>
        <span>{tierName}</span>
        <span class="text-ink-500">·</span>
        <span class="text-accent-soft font-semibold">{tierRole}</span>
      </div>
      <h1 class="heading text-2xl sm:text-3xl">
        <span class="font-mono text-ink-50">{image.imageName}</span>
        <span class="text-ink-300">:</span>
        <span class="text-accent-soft">{isService ? (image.service?.template ?? image.tier.id) : image.tier.id}</span>
      </h1>
      <p class="max-w-2xl text-sm text-ink-200">
        {isService
          ? `First-class ${image.service?.template ?? 'service'} image with template-owned ports, storage, lifecycle, and smoke checks.`
          : image.tier.blurb}
      </p>
      <div class="flex flex-wrap items-center gap-2">
        <span class="chip">{release.tag}</span>
        {arches.map((a) => <span class="chip">{a}</span>)}
        <StatusPill kind={release.lifecycle.status === 'active' ? 'ok' : 'warn'} label={`Status: ${release.lifecycle.status}`} />
        <StatusPill kind={supportKind} label={`Support: ${release.lifecycle.support.toUpperCase()}`} />
        <StatusPill kind={release.lifecycle.productionAllowed ? 'ok' : 'warn'} label={release.lifecycle.productionAllowed ? 'Prod Allowed' : 'Non-Prod Only'} />
        {isImported && <StatusPill kind="info" label="Imported image" />}
        <StatusPill kind={evidencePillKind(signatureStatus.status)} label={`Signature: ${statusLabel(signatureStatus.status)}`} />
        <StatusPill kind={evidencePillKind(provenanceStatus.status)} label={`Provenance: ${statusLabel(provenanceStatus.status)}`} />
        <StatusPill kind={evidencePillKind(sbomStatus.status)} label={`SBOM: ${statusLabel(sbomStatus.status)}`} />
        <StatusPill kind={evidencePillKind(scanStatus.status)} label={`Vulnerability scan: ${statusLabel(scanStatus.status)}`} />
        <StatusPill kind={evidencePillKind(testStatus.status)} label={`Tests: ${statusLabel(testStatus.status)}`} />
        {image.tier.id === 'distroless' && <StatusPill kind="ok" label="Shell-Free" />}
        {image.tier.id !== 'dev' && <StatusPill kind="ok" label="Evidence overlays listed" />}
        {isStale && <StatusPill kind="warn" label="maintenance-stale" />}
      </div>
      {isImported && (
        <div class="mt-4 rounded-lg border border-sky-500/30 bg-sky-500/10 p-4 text-xs text-sky-100">
          <div class="font-bold uppercase tracking-wider text-sky-300">Imported image</div>
          <p class="mt-1 leading-relaxed">
            ClearCutt did not build this image. No build provenance is inferred. Observed metadata is shown separately from verified provenance.
          </p>
        </div>
      )}
      {release.manifestDigest && (
        <div class="mt-4 flex flex-wrap items-center gap-3 text-xs">
          <span class="text-ink-300">Multi-arch Manifest Digest:</span>
          <div class="flex items-center gap-2 rounded bg-ink-950/80 px-2 py-1 font-mono border border-ink-700/40 text-ink-100" data-digest-copy-root>
            <span data-digest-val class="text-[11px] truncate max-w-[200px] sm:max-w-xs">{release.manifestDigest}</span>
            <button
              type="button"
              class="text-ink-300 hover:text-accent-soft p-0.5"
              data-digest-copy-btn
              title="Copy manifest digest to clipboard"
            >
              <svg viewBox="0 0 24 24" class="h-3.5 w-3.5" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15V5a2 2 0 0 1 2-2h10"/></svg>
            </button>
          </div>
        </div>
      )}
      
      {/* Visual Warning Banner for non-production/preview/deprecated images */}
      {['preview', 'deprecated', 'experimental', 'blocked'].includes(release.lifecycle.status) && (
        <div class="mt-4 p-4 rounded-xl border border-amber-500/30 bg-amber-500/10 text-amber-300 text-xs space-y-1">
          <div class="flex items-center gap-2 font-bold uppercase tracking-wider text-[10px] text-amber-400">
            <svg class="h-4 w-4 shrink-0 text-amber-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
            </svg>
            <span>Lifecycle Advisory: {release.lifecycle.status.toUpperCase()} IMAGE</span>
          </div>
          <p class="leading-relaxed">
            {release.lifecycle.status === 'preview' && 'This image is currently in Preview status. It has catalog evidence, but is not recommended for production environments until general availability.'}
            {release.lifecycle.status === 'deprecated' && 'Warning: This image version has been Deprecated. Security patches are no longer active; please plan downstream migration immediately.'}
            {release.lifecycle.status === 'experimental' && 'Advisory: This image is designated as experimental/development only and is strictly not allowed in production workloads.'}
            {release.lifecycle.status === 'blocked' && 'CRITICAL: This image is blocked due to standard non-compliance or critical gating failures.'}
          </p>
        </div>
      )}
      </div>
    </div>
    <div class="flex flex-col items-end gap-3">
      <label class="text-[11px] uppercase tracking-wider text-ink-300">Release</label>
      <div class="relative">
        <select
          class="appearance-none rounded-lg border border-ink-700 bg-ink-900 px-4 py-2 pr-10 font-mono text-sm text-ink-100 focus:border-accent focus:outline-none"
          data-version-switcher={image.id}
        >
          {allReleases.map((r) => (
            <option value={r.tag} selected={r.tag === selectedTag}>{r.tag}</option>
          ))}
        </select>
        <svg viewBox="0 0 24 24" class="pointer-events-none absolute right-3 top-1/2 h-4 w-4 -translate-y-1/2 text-ink-300" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"/></svg>
      </div>
      <p class="text-[11px] text-ink-300">Published {new Date(release.publishedAt).toUTCString()}</p>
      <p class="text-[11px] text-ink-400" title="Last successful rebuild of this runtime overlay layer">Last Rebuilt {lastRebuiltDate.toUTCString()}</p>
      
      {/* Active Scan Telemetry card block */}
      <div
        class:list={[
          'mt-1 flex items-center gap-2 rounded-lg border px-2.5 py-1 text-[10px] font-mono select-none',
          scanStatus.status === 'observed' || scanStatus.status === 'verified' || scanStatus.status === 'attested'
            ? 'border-emerald-800/30 bg-emerald-950/10 text-emerald-400'
            : 'border-amber-500/30 bg-amber-500/10 text-amber-300',
        ]}
        title={scanStateTitle}
      >
        <span class:list={[
          'inline-flex h-2 w-2 rounded-full',
          scanStatus.status === 'observed' || scanStatus.status === 'verified' || scanStatus.status === 'attested' ? 'bg-emerald-500' : 'bg-amber-400',
        ]}></span>
        <span class="uppercase tracking-wider font-semibold">{scanStateLabel}</span>
      </div>
    </div>
  </div>
</section>
<script is:inline define:vars={{ base, imageId: image.id, latestTag: image.releases[0].tag }}>
  document.querySelectorAll('[data-version-switcher]').forEach((sel) => {
    sel.addEventListener('change', (e) => {
      const tag = e.target.value;
      const target = tag === latestTag
        ? base + 'images/' + imageId
        : base + 'images/' + imageId + '/' + tag;
      window.location.href = target;
    });
  });

  document.querySelectorAll('[data-digest-copy-root]').forEach((root) => {
    const btn = root.querySelector('[data-digest-copy-btn]');
    const val = root.querySelector('[data-digest-val]');
    if (!btn || !val) return;
    btn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(val.textContent.trim());
        const svg = btn.innerHTML;
        btn.innerHTML = `<span class="text-[10px] text-accent-soft font-sans font-semibold">Copied</span>`;
        setTimeout(() => { btn.innerHTML = svg; }, 1200);
      } catch {}
    });
  });
</script>
