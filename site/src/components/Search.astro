---
const base = (import.meta.env.BASE_URL ?? '/').replace(/\/$/, '') + '/';
const pagefindPath = `${base}pagefind/pagefind.js`;
---
<div class="relative w-full max-w-xl mx-auto" data-search-root data-pagefind-path={pagefindPath}>
  <div class="relative group">
    <div class="absolute inset-y-0 left-0 flex items-center pl-3.5 pointer-events-none text-ink-400 group-focus-within:text-accent-soft transition-colors">
      <svg viewBox="0 0 20 20" fill="currentColor" class="w-4 h-4">
        <path fill-rule="evenodd" d="M9 3.5a5.5 5.5 0 100 11 5.5 5.5 0 000-11zM2 9a7 7 0 1112.452 4.391l3.328 3.329a.75.75 0 11-1.06 1.06l-3.329-3.328A7 7 0 012 9z" clip-rule="evenodd" />
      </svg>
    </div>
    <input
      type="search"
      id="catalog-search"
      placeholder="Search images, packages, or CVEs... (Press '/' to focus)"
      class="w-full pl-10 pr-12 py-2.5 text-sm rounded-xl border border-ink-700/60 bg-ink-900/60 text-ink-100 placeholder-ink-400 backdrop-blur-sm transition-all focus:border-accent/60 focus:bg-ink-900/80 focus:outline-none focus:ring-1 focus:ring-accent/40"
      aria-label="Search catalog"
      autocomplete="off"
    />
    <div class="absolute inset-y-0 right-0 flex items-center pr-3 pointer-events-none">
      <kbd class="hidden sm:inline-flex items-center gap-0.5 h-5 select-none rounded border border-ink-700/80 bg-ink-950/80 px-1.5 font-mono text-[10px] font-bold text-ink-300 transition-colors group-focus-within:border-accent/40 group-focus-within:text-accent-soft">
        /
      </kbd>
    </div>
  </div>

  <!-- Search Results Dropdown -->
  <div
    id="search-results"
    class="absolute z-50 left-0 right-0 mt-2 max-h-96 overflow-y-auto hidden rounded-xl border border-ink-700/80 bg-ink-900/95 p-2 shadow-glow backdrop-blur-md transition-all divide-y divide-ink-800/50"
    role="listbox"
    aria-label="Search results"
  >
    <div class="px-3 py-2 text-xs text-ink-400 font-medium" id="search-status">
      Start typing to search...
    </div>
    <div id="results-container" class="space-y-1 pt-1"></div>
  </div>
</div>

<script is:inline>
  (function () {
    const root = document.querySelector('[data-search-root]');
    if (!root) return;

    const input = root.querySelector('#catalog-search');
    const resultsDropdown = root.querySelector('#search-results');
    const statusText = root.querySelector('#search-status');
    const resultsContainer = root.querySelector('#results-container');
    const pagefindPath = root.getAttribute('data-pagefind-path');

    let pagefind = null;
    let searchTimeout = null;
    let selectedIndex = -1;

    // Synchronously listen for the '/' hotkey to focus the input
    window.addEventListener('keydown', function (e) {
      if (e.key === '/' && document.activeElement !== input) {
        // Prevent default browser slash quick find in Firefox
        e.preventDefault();
        input.focus();
        input.select();
      }
    });

    async function loadPagefind() {
      if (pagefind) return pagefind;
      try {
        statusText.textContent = 'Loading search index...';
        pagefind = await import(pagefindPath);
        await pagefind.options({
          // Clear any dynamic page restrictions
        });
        statusText.textContent = 'Type to search...';
        return pagefind;
      } catch (err) {
        console.warn('Pagefind is only available after site compilation. Run npm run build.', err);
        statusText.textContent = 'Search index unavailable in local dev (run build).';
        return null;
      }
    }

    async function performSearch(query) {
      if (!query.trim()) {
        resultsDropdown.classList.add('hidden');
        resultsContainer.innerHTML = '';
        selectedIndex = -1;
        return;
      }

      resultsDropdown.classList.remove('hidden');
      const pf = await loadPagefind();
      if (!pf) return;

      statusText.textContent = 'Searching...';
      const searchRes = await pf.search(query);
      
      if (searchRes.results.length === 0) {
        statusText.textContent = 'No matching images or packages found.';
        resultsContainer.innerHTML = '';
        selectedIndex = -1;
        return;
      }

      statusText.textContent = `Found ${searchRes.results.length} result(s)`;
      resultsContainer.innerHTML = '';
      selectedIndex = -1;

      // Slice to top 6 results to keep command palette clean
      const topResults = searchRes.results.slice(0, 6);
      
      // Load data for all top results concurrently
      const loadedData = await Promise.all(topResults.map(r => r.data()));

      loadedData.forEach((data, index) => {
        const item = document.createElement('a');
        item.href = data.url;
        item.className = 'block px-3 py-2 rounded-lg text-left no-underline group/item transition hover:bg-accent/10 focus:bg-accent/10 focus:outline-none';
        item.setAttribute('role', 'option');
        item.setAttribute('id', `search-opt-${index}`);

        // Build title & breadcrumb
        const titleText = data.meta.title || 'Untitled Image';
        // Base.astro builds page titles as "<page> · <site title>"; strip the
        // site-title suffix generically so this works for any fork's brand.
        const cleanTitle = titleText.split(' · ')[0];

        // Extract snippet excerpt
        const excerptHtml = data.excerpt || '';

        item.innerHTML = `
          <div class="flex items-center justify-between gap-2">
            <span class="text-sm font-semibold text-ink-100 group-hover/item:text-accent-soft transition-colors">${cleanTitle}</span>
            <span class="text-[10px] uppercase tracking-wider text-ink-400 group-hover/item:text-ink-200 transition-colors">View image →</span>
          </div>
          <p class="text-xs text-ink-300 line-clamp-1 mt-0.5 font-sans">${excerptHtml}</p>
        `;

        resultsContainer.appendChild(item);
      });
    }

    input.addEventListener('input', function () {
      clearTimeout(searchTimeout);
      const val = input.value;
      searchTimeout = setTimeout(() => {
        performSearch(val);
      }, 150);
    });

    // Close dropdown on click outside
    document.addEventListener('click', function (e) {
      if (!root.contains(e.target)) {
        resultsDropdown.classList.add('hidden');
        selectedIndex = -1;
      }
    });

    // Handle focus / dropdown reopen
    input.addEventListener('focus', function () {
      if (input.value.trim()) {
        resultsDropdown.classList.remove('hidden');
      }
    });

    // Keyboard navigation (Up, Down, Enter, Escape)
    input.addEventListener('keydown', function (e) {
      const items = resultsContainer.querySelectorAll('a');
      if (resultsDropdown.classList.contains('hidden') || items.length === 0) return;

      if (e.key === 'ArrowDown') {
        e.preventDefault();
        selectedIndex = (selectedIndex + 1) % items.length;
        updateActiveItem(items);
      } else if (e.key === 'ArrowUp') {
        e.preventDefault();
        selectedIndex = (selectedIndex - 1 + items.length) % items.length;
        updateActiveItem(items);
      } else if (e.key === 'Enter') {
        if (selectedIndex >= 0 && selectedIndex < items.length) {
          e.preventDefault();
          items[selectedIndex].click();
        }
      } else if (e.key === 'Escape') {
        resultsDropdown.classList.add('hidden');
        input.blur();
        selectedIndex = -1;
      }
    });

    function updateActiveItem(items) {
      items.forEach((item, idx) => {
        if (idx === selectedIndex) {
          item.classList.add('bg-accent/15', 'border-accent/20');
          item.scrollIntoView({ block: 'nearest' });
          input.setAttribute('aria-activedescendant', item.id);
        } else {
          item.classList.remove('bg-accent/15', 'border-accent/20');
        }
      });
    }
  })();
</script>
