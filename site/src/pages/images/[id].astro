---
import Base from '../../layouts/Base.astro';
import ImageHeader from '../../components/ImageHeader.astro';
import UsageTabs from '../../components/UsageTabs.astro';
import VerifyBlock from '../../components/VerifyBlock.astro';
import SbomSection from '../../components/SbomSection.astro';
import VulnerabilityTable from '../../components/VulnerabilityTable.tsx';
import OciLabels from '../../components/OciLabels.astro';
import LayerExplorer from '../../components/LayerExplorer.tsx';
import ProvenanceBlock from '../../components/ProvenanceBlock.astro';
import VersionHistory from '../../components/VersionHistory.astro';
import Tabs from '../../components/Tabs.astro';
import { listImageIds, loadImage, loadIndex } from '../../lib/catalog';
import { loadSiteConfig } from '../../lib/site-config';

export async function getStaticPaths() {
  return listImageIds().map((id) => ({ params: { id } }));
}

const { id } = Astro.params;
const image = loadImage(id!);
const index = loadIndex();
const release = image.releases[0];
const ownerRepo = `${index.owner}/${index.repo}`;
const sbomUrls = release.assetUrls.sbom || {};
const features = loadSiteConfig().site.features;
const base = (import.meta.env.BASE_URL ?? '/').replace(/\/$/, '') + '/';
const imageDataUrl = `${base}catalog/images/${image.id}.json`;
const isService = image.kind === 'service';
const metadataTabs = [
  ...(features.ociLabels ? [{ id: 'labels', label: 'OCI Labels' }] : []),
  ...(features.versionHistory ? [{ id: 'versions', label: 'Version History' }] : []),
];
const metadataDefaultTab = metadataTabs[0]?.id;
const showDeepDive = features.sbomTable || features.layerExplorer || metadataTabs.length > 0;
---
<Base title={`${image.imageName}:${isService ? (image.service?.template ?? 'service') : image.tier.id}`}>
  <div class="space-y-12">
    <div data-pagefind-body>
      <span class="hidden" data-pagefind-meta={`image:${image.id}`}></span>
      <ImageHeader image={image} selectedTag={release.tag} />
    </div>
    {/* Step 1: Pull */}
    <UsageTabs image={image} release={release} ownerRepo={ownerRepo} />

    {/* Step 2: Verify & Audit Compliance */}
    <section class="space-y-4">
      <header class="flex items-center gap-4">
        <span class="inline-flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-accent/20 text-accent-soft border border-accent/40 font-mono text-base font-bold shadow-sm shadow-accent/10 select-none">
          2
        </span>
        <div>
          <h2 class="heading text-xl sm:text-2xl font-bold">Verify &amp; Audit Compliance</h2>
          <p class="text-xs sm:text-sm text-ink-300">Inspect supply chain provenance, run local cryptographic OIDC audits, and review vulnerability gates.</p>
        </div>
      </header>

      <div class="space-y-10">
        {features.provenance && (
          <div>
            <ProvenanceBlock
              release={release}
              ownerRepo={ownerRepo}
              architectures={release.architectures}
              rawTestResultsUrls={release.assetUrls.testResults}
            />
          </div>
        )}
        <div class="border-t border-ink-800/60 pt-10">
          <VerifyBlock image={image} release={release} ownerRepo={ownerRepo} showKyverno={features.kyvernoPolicies} />
        </div>
        {features.vulnerabilityTable && (
          <div class="border-t border-ink-800/60 pt-10">
            <VulnerabilityTable
              dataUrl={imageDataUrl}
              releaseTag={release.tag}
              imageId={image.id}
              language={image.language.id}
              languageVersion={image.language.version}
              tier={image.tier.id}
              client:visible
            />
          </div>
        )}
      </div>
    </section>

    {showDeepDive ? (
    <section class="space-y-4">
      <header class="flex items-center gap-4">
        <span class="inline-flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-accent/20 text-accent-soft border border-accent/40 font-mono text-base font-bold shadow-sm shadow-accent/10 select-none">
          3
        </span>
        <div>
          <h2 class="heading text-xl sm:text-2xl font-bold">{isService ? 'Evidence &amp; OCI Specifications' : 'Deep-Dive &amp; OCI Specifications'}</h2>
          <p class="text-xs sm:text-sm text-ink-300">
            {isService
              ? 'Inspect service SBOMs, image layers, OCI labels, and release history after reviewing the service contract above.'
              : 'Analyze the full Nix store dependency closure, image layer architecture, and OCI configuration labels.'}
          </p>
        </div>
      </header>

      <div class="space-y-10">
        {features.sbomTable && (
          <div>
            <SbomSection
              dataUrl={imageDataUrl}
              releaseTag={release.tag}
              rawSbomUrls={sbomUrls}
              language={image.language.id}
              tier={image.tier.id}
              createdAt={release.architectures[0]?.sbom.createdAt}
            />
          </div>
        )}
        {features.layerExplorer && (
          <div class="border-t border-ink-800/60 pt-10">
            <LayerExplorer
              dataUrl={imageDataUrl}
              releaseTag={release.tag}
              fullName={image.fullName}
              imageName={image.imageName}
              tierId={image.tier.id}
              imageTag={release.tag}
              client:visible
            />
          </div>
        )}
        {metadataTabs.length > 0 && (
          <div class="border-t border-ink-800/60 pt-10">
          <div class="space-y-4">
            <div>
              <h3 class="text-xs uppercase tracking-wider text-ink-300 font-bold mb-1">Image Specifications &amp; Release Ledger</h3>
              <p class="text-xs text-ink-400">Inspect the static OCI container metadata labels and browse the immutable published release history for this image.</p>
            </div>
            
            <Tabs name={`metadata-${image.id}`} tabs={metadataTabs} defaultTab={metadataDefaultTab}>
              {features.ociLabels && (
                <div data-panel-id="labels" data-panel-active={metadataDefaultTab === 'labels' ? 'true' : 'false'}>
                  <OciLabels architectures={release.architectures} />
                </div>
              )}
              {features.versionHistory && (
                <div data-panel-id="versions" data-panel-active={metadataDefaultTab === 'versions' ? 'true' : 'false'}>
                  <VersionHistory image={image} currentTag={release.tag} />
                </div>
              )}
            </Tabs>
          </div>
          </div>
        )}
      </div>
    </section>
    ) : null}
  </div>
</Base>
