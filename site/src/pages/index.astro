---
import Base from '../layouts/Base.astro';
import { loadIndex } from '../lib/catalog';

let index;
let error: string | null = null;
try { index = loadIndex(); } catch (e: any) { error = e.message; }

const base = (import.meta.env.BASE_URL ?? '/').replace(/\/$/, '') + '/';
const published = index ? index.images.filter((i) => i.latestTag === index.latestTag).length : 0;
const totalSlots = 13 * 3; // 13 languages × 3 tiers; kept in sync with flake.nix matrix.
const evidenceCoverage = index
  ? {
      signatures: index.images.filter((i) => i.latestTag === index.latestTag && (i.evidence?.signature ?? i.signed)).length,
      provenance: index.images.filter((i) => i.latestTag === index.latestTag && (i.evidence?.provenance ?? i.provenance)).length,
      scans: index.images.filter((i) => i.latestTag === index.latestTag && !!i.evidence?.vulnerabilities).length,
    }
  : null;
---
<Base title="Home">
  <section class="pb-16 pt-4 space-y-12">
    <!-- Hero Block -->
    <div class="relative rounded-3xl border border-ink-800 bg-gradient-to-br from-ink-950/40 via-ink-900/10 to-ink-950/60 p-8 sm:p-12 shadow-2xl backdrop-blur-md overflow-hidden">
      <!-- Background glowing orb -->
      <div class="absolute -right-32 -top-32 h-96 w-96 rounded-full bg-accent/5 blur-[120px] pointer-events-none" />
      <div class="absolute -left-32 -bottom-32 h-96 w-96 rounded-full bg-accent-soft/5 blur-[120px] pointer-events-none" />

      <div class="grid gap-8 lg:grid-cols-[1.2fr_0.8fr] items-center relative z-10">
        <div class="space-y-6">
          <div class="space-y-3">
            <span class="chip-accent">Cryptographically Secure Container Architectures</span>
            <h1 class="heading text-4xl sm:text-5xl lg:text-6xl font-black leading-tight text-ink-50 uppercase">
              Enterprise Compliance,<br />
              <span class="text-accent-soft bg-gradient-to-r from-accent-soft to-accent bg-clip-text text-transparent">Hermetically Sealed.</span>
            </h1>
            <p class="text-[10px] uppercase tracking-[0.22em] text-accent-soft font-bold">- That's the ClearCutt Advantage</p>
          </div>
          <p class="text-base sm:text-lg text-ink-200 leading-relaxed max-w-xl font-sans">
            ClearCutt is a free, open-source base image blueprint built declaratively using Nix. Use our hardened shell-less runtimes straight out of the box, or fork the repository to easily customize your own enterprise container fleet.
          </p>

          <div class="flex flex-wrap gap-4 pt-2">
            <a href={`${base}catalog`} class="rounded-full bg-accent hover:bg-accent-soft px-6 py-3 text-sm font-semibold uppercase tracking-wider text-ink-950 shadow-lg shadow-accent/25 hover:scale-[1.02] transition">
              Explore Catalog →
            </a>
            <a href={`${base}about`} class="rounded-full border border-ink-700 bg-ink-950/30 hover:border-ink-600 px-6 py-3 text-sm font-semibold uppercase tracking-wider text-ink-200 hover:text-ink-50 transition">
              Learn Architecture
            </a>
          </div>
        </div>

        <!-- 3D-Styled Stack Visualization -->
        <div class="flex items-center justify-center lg:pl-6 select-none">
          <div class="relative w-full max-w-[280px] aspect-square flex items-center justify-center">
            <div class="space-y-4 w-full">
              <!-- Top Layer: OIDC wrapper -->
              <div class="transform -rotate-x-12 -rotate-y-12 rotate-z-3 border border-emerald-500/40 bg-emerald-950/10 backdrop-blur rounded-xl p-4 shadow-[0_8px_30px_rgb(16_185_129/0.05)] hover:translate-y-[-4px] transition duration-300">
                <div class="flex items-center justify-between">
                  <span class="text-[9px] uppercase tracking-widest font-bold text-emerald-400">Cryptographic Seal</span>
                  <span class="inline-flex h-2 w-2 rounded-full bg-emerald-400 animate-pulse" />
                </div>
                <div class="mt-1.5 font-mono text-[10px] text-ink-100 truncate">Sigstore OIDC &amp; Attestations</div>
              </div>

              <!-- Middle Layer: Nix store path closures -->
              <div class="transform -rotate-x-12 -rotate-y-12 rotate-z-3 border border-accent/40 bg-accent/5 backdrop-blur rounded-xl p-4 shadow-[0_8px_30px_rgb(var(--accent)/0.05)] hover:translate-y-[-4px] transition duration-300">
                <div class="flex items-center justify-between">
                  <span class="text-[9px] uppercase tracking-widest font-bold text-accent-soft">Safe Core Runtime</span>
                  <svg class="h-3.5 w-3.5 text-accent-soft" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M12 3v18M3 12h18M5.636 5.636l12.728 12.728M5.636 18.364L18.364 5.636" /></svg>
                </div>
                <div class="mt-1.5 font-mono text-[10px] text-ink-100 truncate">Nix Immutable store closures</div>
              </div>

              <!-- Bedrock Layer: Enterprise OS base overlay -->
              <div class="transform -rotate-x-12 -rotate-y-12 rotate-z-3 border border-ink-800 bg-ink-950/80 backdrop-blur rounded-xl p-4 shadow-lg hover:translate-y-[-4px] transition duration-300">
                <div class="flex items-center justify-between">
                  <span class="text-[9px] uppercase tracking-widest font-bold text-ink-400 font-sans">Base Integration</span>
                  <span class="inline-flex items-center px-1.5 py-0.2 rounded bg-ink-900 border border-ink-800 text-[7.5px] font-sans font-bold text-ink-300 tracking-wider">FLEXIBLE OVERLAY</span>
                </div>
                <div class="mt-1.5 font-mono text-[10px] text-ink-200 leading-normal">Use out-of-the-box, or overlay on UBI/Ubuntu</div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Perspective / Target Switcher Dashboard Section -->
    <div class="space-y-6">
      <header class="flex flex-wrap items-end justify-between gap-4 border-b border-ink-800/40 pb-3">
        <div>
          <h2 class="heading text-xl sm:text-2xl font-bold">Interactive Platform Perspective</h2>
          <p class="text-xs sm:text-sm text-ink-300">Switch perspectives to see how ClearCutt serves both business leaders and security operators.</p>
        </div>

        <!-- Sliding Selector Switch -->
        <div class="inline-flex rounded-full border border-ink-800 bg-ink-950/60 p-1 font-sans text-[11px]">
          <button
            type="button"
            data-perspective-btn="executive"
            class="rounded-full px-4 py-1.5 font-semibold uppercase tracking-wider transition-all select-none text-accent-soft bg-accent/15 border border-accent/20"
          >
            Executive &amp; Sales
          </button>
          <button
            type="button"
            data-perspective-btn="developer"
            class="rounded-full px-4 py-1.5 font-semibold uppercase tracking-wider text-ink-300 transition-all select-none border border-transparent"
          >
            Security &amp; Operator
          </button>
        </div>
      </header>

      <!-- EXECUTIVE VIEW PANEL -->
      <div data-perspective-panel="executive" class="grid gap-6 sm:grid-cols-3">
        <div class="surface-soft border border-ink-800/40 rounded-2xl p-5 space-y-3 hover:border-ink-700/50 transition">
          <header class="flex items-center gap-2">
            <span class="p-2 rounded-xl bg-accent/10 border border-accent/20 text-accent-soft">
              <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" /></svg>
            </span>
            <h3 class="font-bold text-ink-50">Zero Risk Supply Chain</h3>
          </header>
          <p class="text-sm text-ink-200 leading-relaxed">
            Eliminate software supply chain surprises. Our hermetic building prevents outside package injection, yielding standard runtimes with absolute reproducibility.
          </p>
        </div>

        <div class="surface-soft border border-ink-800/40 rounded-2xl p-5 space-y-3 hover:border-ink-700/50 transition">
          <header class="flex items-center gap-2">
            <span class="p-2 rounded-xl bg-emerald-500/10 border border-emerald-500/20 text-emerald-400">
              <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.57-.598-3.75h-.152c-3.196 0-6.1-1.249-8.25-3.286zm0 13.036h.008v.008H12v-.008z" /></svg>
            </span>
            <h3 class="font-bold text-ink-50">Enterprise Compliance</h3>
          </header>
          <p class="text-sm text-ink-200 leading-relaxed">
            ClearCutt Distroless images are STIG-Aligned out-of-the-box by omitting potential shell injection vectors, while all production runtimes support FIPS 140-3 capable cryptographic paths.
          </p>
        </div>

        <div class="surface-soft border border-ink-800/40 rounded-2xl p-5 space-y-3 hover:border-ink-700/50 transition">
          <header class="flex items-center gap-2">
            <span class="p-2 rounded-xl bg-sky-500/10 border border-sky-500/20 text-sky-400">
              <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z" /></svg>
            </span>
            <h3 class="font-bold text-ink-50">High Developer Velocity</h3>
          </header>
          <p class="text-sm text-ink-200 leading-relaxed">
            No rebuild friction. Our caching saves gigabytes of package downloading time, shrinking base images and accelerating pipeline deployments cleanly.
          </p>
        </div>
      </div>

      <!-- DEVELOPER VIEW PANEL -->
      <div data-perspective-panel="developer" class="hidden grid gap-6 sm:grid-cols-3">
        <div class="surface-soft border border-ink-800/40 rounded-2xl p-5 space-y-3 hover:border-ink-700/50 transition">
          <header class="flex items-center gap-2">
            <span class="p-2 rounded-xl bg-accent/10 border border-accent/20 text-accent-soft">
              <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M20.25 7.5l-.625 10.632a2.25 2.25 0 01-2.247 2.118H6.622a2.25 2.25 0 01-2.247-2.118L3.75 7.5M10 11.25h4M3.375 7.5h17.25c.621 0 1.125-.504 1.125-1.125v-1.5c0-.621-.504-1.125-1.125-1.125H3.375c-.621 0-1.125.504-1.125 1.125v1.5c0 .621.504 1.125 1.125 1.125z" /></svg>
            </span>
            <h3 class="font-bold text-ink-50">Nix Store Closures</h3>
          </header>
          <p class="text-sm text-ink-200 leading-relaxed">
            Hermetic compilation only packs transitively reachable dependencies into `nix/store`. Prunes shells, coreutils, and diagnostic binaries for production.
          </p>
        </div>

        <div class="surface-soft border border-ink-800/40 rounded-2xl p-5 space-y-3 hover:border-ink-700/50 transition">
          <header class="flex items-center gap-2">
            <span class="p-2 rounded-xl bg-emerald-500/10 border border-emerald-500/20 text-emerald-400">
              <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" /></svg>
            </span>
            <h3 class="font-bold text-ink-50">Kyverno Cluster Gates</h3>
          </header>
          <p class="text-sm text-ink-200 leading-relaxed">
            Enforce OIDC identities dynamically at admission. Click any image page to download instant copy-paste admission rules blocking un-signed OCI tags.
          </p>
        </div>

        <div class="surface-soft border border-ink-800/40 rounded-2xl p-5 space-y-3 hover:border-ink-700/50 transition">
          <header class="flex items-center gap-2">
            <span class="p-2 rounded-xl bg-sky-500/10 border border-sky-500/20 text-sky-400">
              <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4m6 6v10m6-2a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4" /></svg>
            </span>
            <h3 class="font-bold text-ink-50">Nightly CVE Telemetry</h3>
          </header>
          <p class="text-sm text-ink-200 leading-relaxed">
            Our SBOMs are evaluated nightly against current vulnerability feeds, refreshing safety scores without triggering resource-intensive image rebuilds.
          </p>
        </div>
      </div>
    </div>

    <!-- Active Gating Telemetry -->
    {evidenceCoverage && (
      <div class="space-y-4">
        <h2 class="heading text-xl font-bold border-b border-ink-800/40 pb-2">Supply Chain Health &amp; Telemetry</h2>
        <div class="grid gap-4 sm:grid-cols-4">
          <!-- Stat 1 -->
          <div class="surface-soft border border-ink-800/40 rounded-2xl p-4 space-y-1">
            <span class="text-[10px] uppercase tracking-wider text-ink-300 font-bold">Image Verification</span>
            <div class="flex items-baseline gap-1">
              <span class="text-2xl font-bold font-mono text-ink-50">{evidenceCoverage.signatures}</span>
              <span class="text-xs text-ink-300 font-mono">/ {published}</span>
            </div>
            <p class="text-[10px] text-ink-300">100% keyless OIDC signed</p>
          </div>

          <!-- Stat 2 -->
          <div class="surface-soft border border-ink-800/40 rounded-2xl p-4 space-y-1">
            <span class="text-[10px] uppercase tracking-wider text-ink-300 font-bold">SLSA Provenance</span>
            <div class="flex items-baseline gap-1">
              <span class="text-2xl font-bold font-mono text-ink-50">{evidenceCoverage.provenance}</span>
              <span class="text-xs text-ink-300 font-mono">/ {published}</span>
            </div>
            <p class="text-[10px] text-ink-300">SLSA Level 3 certified</p>
          </div>

          <!-- Stat 3 -->
          <div class="surface-soft border border-ink-800/40 rounded-2xl p-4 space-y-1">
            <span class="text-[10px] uppercase tracking-wider text-ink-300 font-bold">Compliance Status</span>
            <div class="text-lg font-bold text-accent-soft flex items-center gap-1.5 pt-1">
              <span class="relative flex h-2 w-2">
                <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
                <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
              </span>
              STIG / FIPS
            </div>
            <p class="text-[10px] text-ink-300">Distroless STIG, Prod FIPS</p>
          </div>

          <!-- Stat 4 -->
          <div class="surface-soft border border-ink-800/40 rounded-2xl p-4 space-y-1">
            <span class="text-[10px] uppercase tracking-wider text-ink-300 font-bold">Runtimes Managed</span>
            <div class="flex items-baseline gap-1">
              <span class="text-2xl font-bold font-mono text-ink-50">{published}</span>
              <span class="text-xs text-ink-300 font-mono">/ {totalSlots}</span>
            </div>
            <p class="text-[10px] text-ink-300">declarative target closures</p>
          </div>
        </div>
      </div>
    )}
  </section>

  <script is:inline>
    (function () {
      const buttons = document.querySelectorAll('[data-perspective-btn]');
      const panels = document.querySelectorAll('[data-perspective-panel]');
      
      const setPerspective = (activeId) => {
        buttons.forEach((btn) => {
          const id = btn.getAttribute('data-perspective-btn');
          if (id === activeId) {
            btn.className = "rounded-full px-4 py-1.5 font-semibold uppercase tracking-wider transition-all select-none text-accent-soft bg-accent/15 border border-accent/20";
          } else {
            btn.className = "rounded-full px-4 py-1.5 font-semibold uppercase tracking-wider text-ink-300 transition-all select-none border border-transparent";
          }
        });
        panels.forEach((p) => {
          const id = p.getAttribute('data-perspective-panel');
          if (id === activeId) {
            p.classList.remove('hidden');
            p.classList.add('grid');
          } else {
            p.classList.add('hidden');
            p.classList.remove('grid');
          }
        });
      };

      buttons.forEach((btn) => {
        btn.addEventListener('click', () => {
          setPerspective(btn.getAttribute('data-perspective-btn'));
        });
      });
    })();
  </script>
</Base>
