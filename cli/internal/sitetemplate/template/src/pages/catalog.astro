---
import Base from '../layouts/Base.astro';
import MatrixGrid from '../components/MatrixGrid.astro';
import Search from '../components/Search.astro';
import { loadIndex } from '../lib/catalog';
import { loadSiteConfig, tierLabel } from '../lib/site-config';

let index;
let error: string | null = null;
try { index = loadIndex(); } catch (e: any) { error = e.message; }

const base = (import.meta.env.BASE_URL ?? '/').replace(/\/$/, '') + '/';
const siteConfig = loadSiteConfig();
const devLabel = tierLabel(siteConfig, 'dev');
const releaseTags = index?.releases.map((r) => r.tag) ?? [];
const published = index ? index.images.filter((i) => i.latestTag === index.latestTag).length : 0;
const lagging = index ? index.images.filter((i) => i.latestTag !== index.latestTag).length : 0;
// One slot per language-version × tier, read from the catalog index so it can't
// drift from the flake matrix.
const totalSlots = index ? index.languages.length * index.tiers.length : 0;
const pending = index ? Math.max(0, totalSlots - index.images.length) : 0;
const evidenceCoverage = index
  ? {
      signatures: index.images.filter((i) => i.latestTag === index.latestTag && (i.evidence?.signature ?? i.signed)).length,
      provenance: index.images.filter((i) => i.latestTag === index.latestTag && (i.evidence?.provenance ?? i.provenance)).length,
      scans: index.images.filter((i) => i.latestTag === index.latestTag && !!i.evidence?.vulnerabilities).length,
    }
  : null;
---
<Base title="Catalog">
  <section class="space-y-8 pb-10">
    <div class="space-y-4 max-w-3xl">
      <span class="chip-accent">For platform &amp; security engineers shipping enterprise containers</span>
      <h1 class="heading text-4xl sm:text-5xl">Hardened reference runtimes you can verify.</h1>
      <p class="text-base text-ink-200">
        ClearCutt is an open-source container hardening blueprint built declaratively using Nix store layers. The catalog below serves as a live worked-example of a production image feed. Downstream platform teams can fork the blueprint to build and govern their own custom internal feeds.
      </p>
      <p class="text-sm text-ink-300">
        CVE counts on the catalog are refreshed nightly against current vulnerability
        advisories, so a stable SBOM picks up newly-disclosed issues without a new release.
        Each image page explains whether a safe fix is available, no fix was found yet, the
        finding comes from the base image, or the finding is listed for awareness. {devLabel}
        images include full toolchains and are deliberately not optimized for CVE surface area;
        never deploy them.
      </p>
      <div class="flex flex-wrap gap-3 pt-1">
        <a href={`${base}about?tab=audit`} class="chip border-accent/40 bg-accent/10 text-accent-soft">Verification guide →</a>
        <a href={`${base}about`} class="chip">What these tiers mean →</a>
      </div>
    </div>

    <div class="border-t border-ink-800/40 pt-6">
      <Search />
    </div>

    {error ? (
      <div class="surface-soft px-5 py-6 text-sm text-ink-200">
        <p class="font-medium text-warn">Catalog data missing.</p>
        <p class="mt-1 text-ink-300">{error}</p>
      </div>
    ) : (
      <>
        <div class="surface-soft flex flex-wrap items-center justify-between gap-4 px-5 py-3 text-xs text-ink-200">
          <div class="flex flex-wrap items-center gap-x-5 gap-y-1">
            <span>
              <strong class="text-ink-50">{published}</strong> on {index!.latestTag}
            </span>
            {lagging > 0 && (
              <span>
                <strong class="text-warn">{lagging}</strong> lagging
                <span class="text-ink-300"> (showing older release)</span>
              </span>
            )}
            {pending > 0 && (
              <span>
                <strong class="text-ink-100">{pending}</strong> pending
              </span>
            )}
            <span class="text-ink-300">of {totalSlots} target slots</span>
            {evidenceCoverage && (
              <span class="text-ink-300">
                evidence: {evidenceCoverage.signatures}/{published} sig · {evidenceCoverage.provenance}/{published} slsa · {evidenceCoverage.scans}/{published} scans
              </span>
            )}
          </div>
          <div class="flex flex-wrap items-center gap-x-3 gap-y-1">
            <span class="text-ink-300">Releases:</span>
            {releaseTags.map((tag, i) => (
              <a
                href={`${index!.repoUrl}/releases/tag/${tag}`}
                class="font-mono text-ink-100 hover:text-accent-soft"
                target="_blank" rel="noreferrer"
              >{tag}{i === 0 && <span class="ml-1 text-[10px] text-accent-soft">latest</span>}</a>
            ))}
          </div>
        </div>

        <!-- Security & Compliance Audit Legend -->
        <div class="relative rounded-2xl border border-ink-800/60 bg-ink-950/20 p-5 shadow-lg overflow-hidden">
          <div class="absolute -right-24 -top-24 h-48 w-48 rounded-full bg-accent/5 blur-[50px] pointer-events-none" />
          <div class="space-y-3 relative z-10">
            <h2 class="text-xs font-bold uppercase tracking-wider text-ink-400 font-sans">Security &amp; Compliance Audit Legend</h2>
            <div class="grid gap-6 sm:grid-cols-3 text-[11px] text-ink-200 leading-relaxed font-sans">
              <!-- Item 1 -->
              <div class="space-y-1.5">
                <h3 class="font-bold text-ink-50 flex items-center gap-1.5">
                  <span class="inline-flex items-center gap-0.5 rounded bg-ink-950/60 border border-ink-800 px-1 py-0.5 text-emerald-400">
                    <svg viewBox="0 0 16 16" fill="currentColor" class="w-3 h-3"><path d="M8 0c-.26 0-.5.1-.68.27L1.83 5.75c-.2.2-.33.48-.33.78v4.54c0 .32.14.62.38.82l5.5 4.54c.18.15.4.23.62.23s.44-.08.62-.23l5.5-4.54c.24-.2.38-.5.38-.82V6.53c0-.3-.13-.58-.33-.78L8.68.27A.96.96 0 008 0zm2.7 5.7a.75.75 0 010 1.06l-3.5 3.5a.75.75 0 01-1.06 0l-1.5-1.5a.75.75 0 111.06-1.06L7 9.44l2.97-2.97a.75.75 0 011.06 0z"/></svg>
                    <svg viewBox="0 0 16 16" fill="currentColor" class="w-3 h-3 border-l border-ink-800 pl-0.5"><path fill-rule="evenodd" d="M8 1a3.5 3.5 0 00-3.5 3.5V7A1.5 1.5 0 003 8.5v5A1.5 1.5 0 004.5 15h7a1.5 1.5 0 001.5-1.5v-5A1.5 1.5 0 0011.5 7V4.5A3.5 3.5 0 008 1zm2 6V4.5a2 2 0 10-4 0V7h4z" clip-rule="evenodd"/></svg>
                    <svg viewBox="0 0 16 16" fill="currentColor" class="w-3 h-3 border-l border-ink-800 pl-0.5"><path fill-rule="evenodd" d="M2.5 12a.75.75 0 01.75-.75h10a.75.75 0 010 1.5h-10a.75.75 0 01-.75-.75zm0-4a.75.75 0 01.75-.75h10a.75.75 0 010 1.5h-10a.75.75 0 01-.75-.75zm0-4a.75.75 0 01.75-.75h10a.75.75 0 010 1.5h-10a.75.75 0 01-.75-.75z" clip-rule="evenodd"/></svg>
                  </span>
                  Supply Chain Evidence
                </h3>
                <p class="text-ink-300 leading-normal">
                  Green icons indicate verified cryptographically bound evidence attached to the OCI manifest: Sigstore keyless OIDC signature, SLSA Build L3 provenance, and SPDX SBOM.
                </p>
              </div>

              <!-- Item 2 -->
              <div class="space-y-1.5">
                <h3 class="font-bold text-ink-50 flex items-center gap-1.5">
                  <span class="inline-flex items-center gap-1 text-[9px] font-semibold text-emerald-400 bg-emerald-950/20 border border-emerald-800/30 rounded px-1.5 py-0.5">
                    <svg viewBox="0 0 24 24" class="h-3 w-3 shrink-0" fill="none" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" /></svg>
                    Gate Passed
                  </span>
                  Vulnerability Gates
                </h3>
                <p class="text-ink-300 leading-normal">
                  Images show <strong>Gate Passed</strong> when current scan data reports no active Critical or High findings. Counts of outstanding CVE findings display in red (critical) or orange (high) badges.
                </p>
              </div>

              <!-- Item 3 -->
              <div class="space-y-1.5">
                <h3 class="font-bold text-ink-50 flex items-center gap-1.5">
                  <span class="inline-flex items-center px-1.5 py-0.5 rounded bg-emerald-500/10 border border-emerald-500/20 text-[7.5px] font-bold text-emerald-400 tracking-wider">SHELL-FREE</span>
                  <span class="inline-flex items-center px-1.5 py-0.5 rounded bg-sky-500/10 border border-sky-500/20 text-[7.5px] font-bold text-sky-400 tracking-wider">EVIDENCE PINNED</span>
                </h3>
                <p class="text-ink-300 leading-normal">
                  <strong>Shell-Free</strong> indicates that shells, core utilities, and package managers are omitted from the runtime. <strong>Evidence Pinned</strong> means the catalog exposes signatures, SBOMs, provenance, and workflow identities separately.
                </p>
              </div>
            </div>
          </div>
        </div>

        <div data-pagefind-body class="space-y-3">
          <div class="surface-soft flex flex-wrap items-center gap-3 px-5 py-3 text-xs text-ink-200" data-matrix-filters>
            <span class="text-ink-300">View:</span>
            <button type="button" data-filter-btn="all" data-active="true" class="chip data-[active=true]:border-accent/40 data-[active=true]:bg-accent/10 data-[active=true]:text-accent-soft">
              All ({totalSlots})
            </button>
            <button type="button" data-filter-btn="production" class="chip data-[active=true]:border-accent/40 data-[active=true]:bg-accent/10 data-[active=true]:text-accent-soft">
              Production only (hide {devLabel})
            </button>
            <button type="button" data-filter-btn="current" class="chip data-[active=true]:border-accent/40 data-[active=true]:bg-accent/10 data-[active=true]:text-accent-soft">
              On {index!.latestTag} only
            </button>
            <button type="button" data-filter-btn="cve" class="chip data-[active=true]:border-accent/40 data-[active=true]:bg-accent/10 data-[active=true]:text-accent-soft">
              Requires runtime patching
            </button>
            <span class="ml-auto text-ink-300">Filters are stacked: each adds to the selection above.</span>
          </div>
          <div data-matrix-root data-view="all">
            <MatrixGrid index={index!} />
          </div>
        </div>
        <script is:inline>
          (function () {
            const root = document.querySelector('[data-matrix-root]');
            const buttons = document.querySelectorAll('[data-filter-btn]');
            if (!root) return;
            const state = { production: false, current: false, cve: false };
            const sync = () => {
              const classes = [];
              if (state.production) classes.push('view-production');
              if (state.current)    classes.push('view-current');
              if (state.cve)        classes.push('view-cve');
              root.className = classes.join(' ');
              buttons.forEach((b) => {
                const k = b.getAttribute('data-filter-btn');
                if (k === 'all') {
                  b.dataset.active = (!state.production && !state.current && !state.cve) ? 'true' : 'false';
                } else {
                  b.dataset.active = state[k] ? 'true' : 'false';
                }
              });
            };
            buttons.forEach((b) => b.addEventListener('click', () => {
              const k = b.getAttribute('data-filter-btn');
              if (k === 'all') { state.production = state.current = state.cve = false; }
              else { state[k] = !state[k]; }
              sync();
            }));
            sync();
          })();
        </script>
      </>
    )}
  </section>
</Base>
