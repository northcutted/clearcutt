---
import Base from '../layouts/Base.astro';
import CopyBlock from '../components/CopyBlock.astro';
import Tabs from '../components/Tabs.astro';
import { loadImage, loadIndex } from '../lib/catalog';

let index;
try { index = loadIndex(); } catch { index = null; }
const ownerRepo = index ? `${index.owner}/${index.repo}` : 'northcutted/clearcutt';
const registryBase = index?.registryBase ?? `ghcr.io/${ownerRepo.toLowerCase()}`;
const imageRuntime = (id: string) => id.split('-')[0].toLowerCase();
const fallbackImagePrefix = (() => {
  const first = index?.images[0];
  if (!first) return 'clearcutt';
  try {
    const record = loadImage(first.id);
    const suffix = `-${imageRuntime(first.id)}`;
    return record.imageName.toLowerCase().endsWith(suffix)
      ? record.imageName.slice(0, -suffix.length)
      : 'clearcutt';
  } catch {
    return 'clearcutt';
  }
})();
const imageNameFor = (id: string) => {
  try {
    return loadImage(id).imageName;
  } catch {
    return `${fallbackImagePrefix}-${imageRuntime(id)}`;
  }
};
const java25ImageName = imageNameFor('java25-distroless');
const java21ImageName = imageNameFor('java21-distroless');
const latestTag = index?.latestTag ?? 'v0.6.2';
const base = (import.meta.env.BASE_URL ?? '/').replace(/\/$/, '') + '/';
---
<Base title="CLI Tools & Governance Engine">
  <div class="space-y-10">
    <header class="space-y-2 border-b border-ink-800/40 pb-4">
      <h1 class="heading text-3xl font-bold">ClearCutt CLI &amp; Governance Engine</h1>
      <p class="text-xs sm:text-sm text-ink-300">
        The core command-line companion and compliance engine. Audit image tarballs, rebase downstream app images, enforce exceptions, verify OIDC signatures, generate policies, and spin up Nix runtime overlays.
      </p>
    </header>

    <!-- Header Hero Card -->
    <div class="relative rounded-2xl border border-accent/20 bg-gradient-to-br from-accent/5 to-accent-soft/10 p-6 shadow-xl overflow-hidden">
      <div class="absolute -right-16 -top-16 h-48 w-48 rounded-full bg-accent/5 blur-[40px] pointer-events-none" />
      <div class="relative z-10 flex flex-col md:flex-row md:items-center justify-between gap-6">
        <div class="space-y-2">
          <h2 class="text-xs font-bold uppercase tracking-[0.22em] text-accent-soft">SECURE PLATFORM ENFORCEMENT</h2>
          <div class="heading text-xl sm:text-2xl font-black uppercase text-ink-50 tracking-wide">
            Automate Verification,<br />
            <span class="text-accent-soft bg-gradient-to-r from-accent-soft to-accent bg-clip-text text-transparent">Anywhere in CI/CD.</span>
          </div>
          <p class="text-xs text-ink-300 max-w-xl font-sans pt-1 leading-relaxed">
            The <code>clearcutt</code> CLI keeps governance checks offline and runs app lifecycle operations registry-direct without Docker. Build precompiled artifacts onto ClearCutt bases, inspect multi-arch manifests, parse OpenVEX triages, and rebase patched bases under untouched application layers.
          </p>
        </div>
        <div class="shrink-0 flex flex-col gap-2">
          <a href={`https://github.com/${ownerRepo}/releases/tag/${latestTag}`} target="_blank" rel="noreferrer" class="inline-flex items-center justify-center gap-2 rounded-xl bg-accent hover:bg-accent-soft text-ink-950 font-sans text-xs font-semibold px-4 py-2.5 transition no-underline">
            <svg viewBox="0 0 16 16" class="h-3.5 w-3.5" fill="currentColor"><path d="M8 0C3.58 0 0 3.58 0 8a8 8 0 0 0 5.47 7.59c.4.07.55-.17.55-.38v-1.33c-2.22.48-2.69-1.07-2.69-1.07-.36-.92-.89-1.17-.89-1.17-.72-.5.05-.49.05-.49.8.06 1.22.83 1.22.83.71 1.21 1.87.86 2.33.66.07-.51.28-.86.5-1.06-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82a7.66 7.66 0 0 1 4 0c1.53-1.03 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48v2.2c0 .21.15.46.55.38A8 8 0 0 0 16 8c0-4.42-3.58-8-8-8z"/></svg>
            Download Pre-Compiled Binaries ({latestTag})
          </a>
          <span class="text-[10px] text-ink-400 text-center uppercase tracking-wider">Signed keylessly via Sigstore OIDC</span>
        </div>
      </div>
    </div>

    <!-- Quick Installation Section -->
    <section class="space-y-4 max-w-3xl">
      <h2 class="heading text-xl text-ink-50">Installation</h2>
      <p class="text-sm text-ink-200">
        You can quickly download the pre-compiled binary for your architecture from the GitHub Releases tab, or compile it directly from the repository source using Go 1.26:
      </p>

      <Tabs name="cli-install" tabs={[
        { id: 'compile', label: 'Build from Source' },
        { id: 'download', label: 'Direct Download (macOS / Linux)' },
      ]}>
        <div data-panel-id="compile" data-panel-active="true" class="space-y-3">
          <p class="text-xs text-ink-300">Requires Go 1.26+ installed on your system. Run compilation in the repository directory root:</p>
          <CopyBlock language="shell" code={`git clone https://github.com/${ownerRepo}.git\ncd clearcutt\nmake cli-build\n./clearcutt --version`} />
        </div>
        <div data-panel-id="download" data-panel-active="false" class="space-y-3">
          <p class="text-xs text-ink-300">Run this shell command to fetch and install the correct architecture binary automatically:</p>
          <CopyBlock language="shell" code={`# Determine OS and Arch\nOS=$(uname -s | tr '[:upper:]' '[:lower:]')\nARCH=$(uname -m | sed 's/x86_64/amd64/' | sed 's/aarch64/arm64/')\nVERSION="${latestTag}"\n\n# Download binary asset and signature from releases\ncurl -fsSLO "https://github.com/${ownerRepo}/releases/download/\${VERSION}/clearcutt-\${OS}-\${ARCH}"\ncurl -fsSLO "https://github.com/${ownerRepo}/releases/download/\${VERSION}/clearcutt-\${OS}-\${ARCH}.sig"\n\n# Verify keyless signature offline\ncosign verify-blob "clearcutt-\${OS}-\${ARCH}" \\\n  --bundle "clearcutt-\${OS}-\${ARCH}.sig" \\\n  --certificate-identity-regexp "https://github.com/${ownerRepo}/.*" \\\n  --certificate-oidc-issuer "https://token.actions.githubusercontent.com"\n\nchmod +x "clearcutt-\${OS}-\${ARCH}"\nsudo mv "clearcutt-\${OS}-\${ARCH}" /usr/local/bin/clearcutt`} />
        </div>
      </Tabs>
    </section>

    <!-- Comprehensive Command Matrix Section -->
    <section class="space-y-6">
      <h2 class="heading text-xl text-ink-50">Command Reference</h2>
      <p class="text-sm text-ink-200 max-w-2xl">
        ClearCutt CLI divides duties into clean, dedicated, zero-daemon subcommands. Explore the primary governance command boundaries below:
      </p>

      <div class="grid gap-6 md:grid-cols-2">
        
        <!-- inspect -->
        <div class="surface-soft border border-ink-800/40 rounded-2xl p-6 space-y-4">
          <div class="space-y-1">
            <span class="inline-flex rounded bg-accent/15 px-2 py-0.5 text-[10px] font-mono font-bold text-accent-soft uppercase tracking-wider">inspect</span>
            <h3 class="font-bold text-base text-ink-50">Inspect Catalog Metadata</h3>
          </div>
          <p class="text-xs text-ink-300 leading-relaxed font-sans">
            Queries and audits high-fidelity catalog record structures locally. Evaluates configurations, architectures, image layers, unprivileged user settings, dynamic linkers, and cryptographic references.
          </p>
          <CopyBlock language="shell" code={`# Show standard details\nclearcutt inspect java25-distroless\n\n# Force strict mode (fail on any unknown metadata fields)\nclearcutt inspect java25-distroless --strict`} />
        </div>

        <!-- verify -->
        <div class="surface-soft border border-ink-800/40 rounded-2xl p-6 space-y-4">
          <div class="space-y-1">
            <span class="inline-flex rounded bg-accent/15 px-2 py-0.5 text-[10px] font-mono font-bold text-accent-soft uppercase tracking-wider">verify</span>
            <h3 class="font-bold text-base text-ink-50">Gated Verification Gatekeeper</h3>
          </div>
          <p class="text-xs text-ink-300 leading-relaxed font-sans">
            Enforces software supply chain compliance checks. Gates on signatures, SBOMs, SLSA level requirements, smoke test status, active support lifecycles, and maximum vulnerability counts. Can verify images, local catalog indexes, or published OCI release evidence.
          </p>
          <CopyBlock language="shell" code={`# Enforce full gate limits locally on a catalog image\nclearcutt verify image java25-distroless \\\n  --require-signature \\\n  --require-sbom \\\n  --max-critical 0 \\\n  --max-high 3 \\\n  --exceptions exceptions.yaml\n\n# Verify published OCI release evidence against Cosign + SLSA\nclearcutt verify release-evidence \\\n  --ref ${registryBase}/${java25ImageName}:distroless-v0.6.2 \\\n  --repo ${ownerRepo} \\\n  --workflow-identity "https://github.com/${ownerRepo}/.github/workflows/release.yml@refs/heads/main"\n\n# Verify the local catalog structure and database schema compliance\nclearcutt verify catalog`} />
        </div>

        <!-- certify -->
        <div class="surface-soft border border-ink-800/40 rounded-2xl p-6 space-y-4">
          <div class="space-y-1">
            <span class="inline-flex rounded bg-accent/15 px-2 py-0.5 text-[10px] font-mono font-bold text-accent-soft uppercase tracking-wider">certify</span>
            <h3 class="font-bold text-base text-ink-50">Declarative Downstream Auditer</h3>
          </div>
          <p class="text-xs text-ink-300 leading-relaxed font-sans">
            Audits downstream application image tarballs offline. Unpacks layered filesystems in-memory to verify the absence of shells, interactive package managers, and root UIDs.
          </p>
          <CopyBlock language="shell" code={`# Export docker/podman OCI tarball\ndocker save ghcr.io/acme/my-app:latest -o my-app.tar\n\n# Run declarative offline certification checks\nclearcutt certify my-app.tar \\\n  --base java25-distroless \\\n  --policy certification-policy.yaml`} />
        </div>

        <!-- app -->
        <div class="surface-soft border border-ink-800/40 rounded-2xl p-6 space-y-4">
          <div class="space-y-1">
            <span class="inline-flex rounded bg-accent/15 px-2 py-0.5 text-[10px] font-mono font-bold text-accent-soft uppercase tracking-wider">app build / rebase / template</span>
            <h3 class="font-bold text-base text-ink-50">Rebasable App Lifecycle</h3>
          </div>
          <p class="text-xs text-ink-300 leading-relaxed font-sans">
            Builds precompiled artifacts directly into OCI images, compares candidate bases, and rebases patched base layers under byte-preserved application layers with cosign signature and attestation gates. Also scaffolds app-team starters.
          </p>
          <CopyBlock language="shell" code={`# Scaffold an app-team starter project using ClearCutt\nclearcutt app template java --output clearcutt-template-java --name my-java-app\n\n# Build a rebasable app image\nclearcutt app build \\\n  --base java21-distroless \\\n  --artifact target/app.jar \\\n  --dest /workspace/app.jar \\\n  --entrypoint '["java","-jar","/workspace/app.jar"]' \\\n  --image ghcr.io/acme/payments-api:1.0.0\n\n# Rebase after the base is patched\nclearcutt app rebase \\\n  --image ghcr.io/acme/payments-api:1.0.0 \\\n  --candidate-base ${registryBase}/${java21ImageName}:distroless-v0.2.2 \\\n  --candidate-base-id java21-distroless \\\n  --tag ghcr.io/acme/payments-api:1.0.0-rebased \\\n  --dev-identity "$DEV_SIGNER" \\\n  --sign \\\n  --attest`} />
          <a href={`${base}app-lifecycle`} class="inline-flex text-xs font-semibold uppercase tracking-wider text-accent-soft hover:text-accent transition">
            All stack examples
          </a>
        </div>

        <!-- diff -->
        <div class="surface-soft border border-ink-800/40 rounded-2xl p-6 space-y-4">
          <div class="space-y-1">
            <span class="inline-flex rounded bg-accent/15 px-2 py-0.5 text-[10px] font-mono font-bold text-accent-soft uppercase tracking-wider">diff</span>
            <h3 class="font-bold text-base text-ink-50">Release Difference Analyser</h3>
          </div>
          <p class="text-xs text-ink-300 leading-relaxed font-sans">
            Generates release-to-release differences. Resolves release tags and tag-aliases dynamically, mapping image size changes, platform additions, packages updates, and CVE deltas.
          </p>
          <CopyBlock language="shell" code={`# Diff previous release vs latest\nclearcutt diff java25-distroless --from latest-1 --to latest`} />
        </div>

        <!-- overlay -->
        <div class="surface-soft border border-ink-800/40 rounded-2xl p-6 space-y-4">
          <div class="space-y-1">
            <span class="inline-flex rounded bg-accent/15 px-2 py-0.5 text-[10px] font-mono font-bold text-accent-soft uppercase tracking-wider">overlay generate</span>
            <h3 class="font-bold text-base text-ink-50">Nix Overlay Scaffolder</h3>
          </div>
          <p class="text-xs text-ink-300 leading-relaxed font-sans">
            Generates self-contained Nix multi-stage grafting workspaces to overlay ClearCutt runtimes onto enterprise-mandated base images. Includes Makefile, Containerfile, smoke tests, and GitHub Actions pipelines.
          </p>
          <CopyBlock language="shell" code={`# Scaffold Java 25 UBI9 graft workspace\nclearcutt overlay generate \\\n  --runtime java25 \\\n  --tier distroless \\\n  --base registry.access.redhat.com/ubi9/ubi-minimal \\\n  --output my-java25-overlay/`} />
        </div>

        <!-- conformance -->
        <div class="surface-soft border border-ink-800/40 rounded-2xl p-6 space-y-4">
          <div class="space-y-1">
            <span class="inline-flex rounded bg-accent/15 px-2 py-0.5 text-[10px] font-mono font-bold text-accent-soft uppercase tracking-wider">conformance run</span>
            <h3 class="font-bold text-base text-ink-50">Offline Conformance Auditor</h3>
          </div>
          <p class="text-xs text-ink-300 leading-relaxed font-sans">
            Audits the current host/container environment offline — run it inside the image under test. Validates timezone configuration, CA certificate pathways, unprivileged execution, a writable <code>/tmp</code>, and any language interpreters on PATH.
          </p>
          <CopyBlock language="shell" code={`# Audit the current environment (run inside the container under test)\nclearcutt conformance run --expect-runtime java`} />
        </div>

        <!-- exceptions -->
        <div class="surface-soft border border-ink-800/40 rounded-2xl p-6 space-y-4">
          <div class="space-y-1">
            <span class="inline-flex rounded bg-accent/15 px-2 py-0.5 text-[10px] font-mono font-bold text-accent-soft uppercase tracking-wider">exceptions validate</span>
            <h3 class="font-bold text-base text-ink-50">Exceptions Schema Validator</h3>
          </div>
          <p class="text-xs text-ink-300 leading-relaxed font-sans">
            Audits declarative <code>exceptions.yaml</code> governance files against standard schemas. Verifies active owners, reference tags, and immediately flags any expired exception mappings.
          </p>
          <CopyBlock language="shell" code={`# Validate exceptions catalog file\nclearcutt exceptions validate exceptions.yaml --fail-on-expired-exceptions`} />
        </div>

        <!-- mirror -->
        <div class="surface-soft border border-ink-800/40 rounded-2xl p-6 space-y-4">
          <div class="space-y-1">
            <span class="inline-flex rounded bg-accent/15 px-2 py-0.5 text-[10px] font-mono font-bold text-accent-soft uppercase tracking-wider">mirror / mirror verify</span>
            <h3 class="font-bold text-base text-ink-50">Mirroring script generator &amp; verifier</h3>
          </div>
          <p class="text-xs text-ink-300 leading-relaxed font-sans">
            Generates high-fidelity <code>skopeo</code> and <code>cosign</code> scripts to copy multi-arch base layers while preserving Sigstore signatures and referrers. Verifies mirrored referrers offline.
          </p>
          <CopyBlock language="shell" code={`# Generate secure copy script\nclearcutt mirror --source ghcr.io/acme/java25 --target my-registry.internal/java25\n\n# Offline verification of copied referrers\nclearcutt mirror verify --source ghcr.io/acme/java25 --target my-registry.internal/java25`} />
        </div>

        <!-- platform -->
        <div class="surface-soft border border-ink-800/40 rounded-2xl p-6 space-y-4">
          <div class="space-y-1">
            <span class="inline-flex rounded bg-accent/15 px-2 py-0.5 text-[10px] font-mono font-bold text-accent-soft uppercase tracking-wider">platform init / status</span>
            <h3 class="font-bold text-base text-ink-50">Platform Kit Management</h3>
          </div>
          <p class="text-xs text-ink-300 leading-relaxed font-sans">
            Initializes and checks the status of the forkable ClearCutt platform kit. Scaffolds initial fleet configuration templates, documents, and application templates, and validates platform components wiring.
          </p>
          <CopyBlock language="shell" code={`# Initialize a new platform kit layout\nclearcutt platform init --owner my-org --repo my-base-images\n\n# Verify status of all platform wiring checks\nclearcutt platform status`} />
        </div>
      </div>
    </section>

    <!-- Standard Governance Schemas Section -->
    <section class="space-y-6 max-w-3xl">
      <h2 class="heading text-xl text-ink-50">Standard Governance Schemas</h2>
      <p class="text-sm text-ink-200">
        ClearCutt uses strict schema structures for governance files to ensure consistency across local and pipeline builds.
      </p>

      <div class="space-y-4">
        <div>
          <h3 class="text-xs uppercase tracking-wider text-ink-300 font-bold mb-1">1. Exceptions YAML (`exceptions.yaml`)</h3>
          <p class="text-xs text-ink-400 mb-2">Used in <code>verify</code>, <code>vex</code>, and <code>exceptions validate</code> to document accepted CVEs, temporary business exemptions, and active owners:</p>
          <CopyBlock language="yaml" code={`apiVersion: clearcutt.dev/v1\nkind: VulnerabilityExceptions\nmetadata:\n  name: app-triage-exceptions\nspec:\n  exceptions:\n    - id: "CVE-2026-9999"\n      package: "openssl"\n      image: "*"\n      release: "*"\n      status: "accepted_risk"\n      reason: "inherited_from_base"\n      owner: "eddie-northcutt"\n      createdAt: "2026-05-30"\n      expiresAt: "2026-08-30"\n      references:\n        - "https://nvd.nist.gov/vuln/detail/CVE-2026-9999"\n      notes: "Vulnerable functions are completely sealed and unreachable in our distroless runtime closures."`} />
        </div>

        <div class="pt-4 border-t border-ink-800/40">
          <h3 class="text-xs uppercase tracking-wider text-ink-300 font-bold mb-1">2. Certification Policy YAML (`certification-policy.yaml`)</h3>
          <p class="text-xs text-ink-400 mb-2">Enforces downstream OCI compliance gates dynamically inside GHA workflows or local audits using <code>certify</code>:</p>
          <CopyBlock language="yaml" code={`apiVersion: clearcutt.dev/v1\nkind: CertificationPolicy\nmetadata:\n  name: production-hardening-contract\nspec:\n  base:\n    allowedImages:\n      - "java25-distroless"\n      - "python3.15-slim"\n    requireDigestPinned: true\n    requireKnownBase: true\n  supplyChain:\n    requireSignature: true\n    requireProvenance: true\n    requireSbom: true\n    minimumSlsaLevel: 3\n  runtime:\n    requireNonRoot: true\n    forbidShell: true\n    forbidPackageManagers: true\n    forbidDevTier: true\n  lifecycle:\n    allowPreview: false\n    allowDeprecated: false\n    allowExperimental: false\n  vulnerabilities:\n    maxCritical: 0\n    maxHigh: 3\n    allowExceptions: true\n    exceptionFile: "exceptions.yaml"`} />
        </div>

        <div class="pt-4 border-t border-ink-800/40">
          <h3 class="text-xs uppercase tracking-wider text-ink-300 font-bold mb-1">3. Rebase Attestation JSON (`rebase-attestation.schema.json`)</h3>
          <p class="text-xs text-ink-400 mb-2">Records the source digest, base-layer swap, preserved compressed app-layer digests, compatibility policy, and verified developer signature evidence for <code>app rebase --attest</code>.</p>
          <CopyBlock language="json" code={`{\n  "predicateType": "https://clearcutt.dev/attestations/rebase/v1",\n  "predicate": {\n    "sourceImage": "ghcr.io/acme/payments-api:1.0.0",\n    "sourceDigest": "sha256:...",\n    "preservedAppLayers": ["sha256:..."],\n    "developerSignatureVerified": true,\n    "developerIdentity": "$DEV_SIGNER",\n    "rebaseDecision": "allowed"\n  }\n}`} />
        </div>
      </div>
    </section>
  </div>
</Base>
