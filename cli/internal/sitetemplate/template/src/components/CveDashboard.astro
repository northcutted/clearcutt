---
import type { ReleaseEntry } from '../lib/catalog-schema';

interface Props {
  release: ReleaseEntry;
}

const { release } = Astro.props;

// Filter architectures that have vulnerability scan data
const scans = release.architectures
  .map((arch) => {
    const vuln = arch.vulnerabilities;
    if (!vuln) return null;
    const counts = vuln.countsBySeverity;
    const total = counts.critical + counts.high + counts.medium + counts.low;
    return {
      arch: arch.arch,
      scanner: vuln.scanner,
      scannedAt: vuln.scannedAt,
      counts: {
        critical: counts.critical,
        high: counts.high,
        medium: counts.medium,
        low: counts.low,
      },
      total,
    };
  })
  .filter(Boolean);
---
{scans.length > 0 && (
  <div class="surface p-5 space-y-6">
    <div class="flex items-center justify-between border-b border-ink-800/50 pb-3">
      <h3 class="text-xs uppercase tracking-wider text-ink-300 font-semibold">Current Scan Severity Profile</h3>
      <span class="text-[10px] text-ink-400">Scanned nightly against active advisories</span>
    </div>

    <div class="grid gap-6 md:grid-cols-2">
      {scans.map((scan) => {
        const c = scan!.counts;
        const total = scan!.total;

        // Calculate percentages for the stacked bar
        const pctCrit = total > 0 ? (c.critical / total) * 100 : 0;
        const pctHigh = total > 0 ? (c.high / total) * 100 : 0;
        const pctMed = total > 0 ? (c.medium / total) * 100 : 0;
        const pctLow = total > 0 ? (c.low / total) * 100 : 0;

        return (
          <div class="space-y-3">
            <div class="flex justify-between items-baseline">
              <span class="font-mono text-xs font-bold text-ink-50">linux/{scan!.arch}</span>
              <span class="text-[10px] text-ink-400 font-mono">
                {total === 0 ? '0 findings' : `${total} total findings`} · {scan!.scanner}
              </span>
            </div>

            {total > 0 ? (
              <div class="w-full h-3 rounded-full bg-ink-950 overflow-hidden flex">
                {c.critical > 0 && (
                  <div
                    style={`width: ${pctCrit}%`}
                    class="h-full bg-danger transition-all duration-300"
                    title={`Critical: ${c.critical}`}
                  />
                )}
                {c.high > 0 && (
                  <div
                    style={`width: ${pctHigh}%`}
                    class="h-full bg-warn transition-all duration-300"
                    title={`High: ${c.high}`}
                  />
                )}
                {c.medium > 0 && (
                  <div
                    style={`width: ${pctMed}%`}
                    class="h-full bg-accent transition-all duration-300"
                    title={`Medium: ${c.medium}`}
                  />
                )}
                {c.low > 0 && (
                  <div
                    style={`width: ${pctLow}%`}
                    class="h-full bg-accent-soft transition-all duration-300"
                    title={`Low: ${c.low}`}
                  />
                )}
              </div>
            ) : (
              <div class="w-full h-3 rounded-full bg-ink-950/60 border border-dashed border-ink-800 flex items-center justify-center">
                <span class="text-[8px] text-emerald-400 font-semibold tracking-wider uppercase">No Current Findings</span>
              </div>
            )}

            <!-- Severity Legend with explicit count readouts -->
            <div class="flex flex-wrap gap-x-4 gap-y-1 pt-1 text-[10px] font-mono">
              <div class="flex items-center gap-1.5">
                <span class="w-2.5 h-2.5 rounded-full bg-danger inline-block shrink-0" />
                <span class="text-ink-200">Critical: <strong class="text-ink-50">{c.critical}</strong></span>
              </div>
              <div class="flex items-center gap-1.5">
                <span class="w-2.5 h-2.5 rounded-full bg-warn inline-block shrink-0" />
                <span class="text-ink-200">High: <strong class="text-ink-50">{c.high}</strong></span>
              </div>
              <div class="flex items-center gap-1.5">
                <span class="w-2.5 h-2.5 rounded-full bg-accent inline-block shrink-0" />
                <span class="text-ink-200">Medium: <strong class="text-ink-50">{c.medium}</strong></span>
              </div>
              <div class="flex items-center gap-1.5">
                <span class="w-2.5 h-2.5 rounded-full bg-accent-soft inline-block shrink-0" />
                <span class="text-ink-200">Low: <strong class="text-ink-50">{c.low}</strong></span>
              </div>
            </div>
          </div>
        );
      })}
    </div>
  </div>
)}
