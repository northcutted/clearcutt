---
import type { CatalogIndex } from '../lib/catalog-schema';

interface Props { index: CatalogIndex }
const { index } = Astro.props;
const base = (import.meta.env.BASE_URL ?? '/').replace(/\/$/, '') + '/';
const services = index.images.filter((img) => img.kind === 'service');

function portsLabel(service: CatalogIndex['images'][number]['service']): string {
  const ports = service?.ports ?? [];
  if (ports.length === 0) return 'No ports';
  return ports.map((p) => `${p.name ? `${p.name}:` : ''}${p.port}/${p.protocol ?? 'tcp'}`).join(', ');
}

function evidenceLabel(img: CatalogIndex['images'][number]): string {
  const evidence = img.evidence;
  if (!evidence) return 'Evidence pending';
  const pieces = [
    evidence.signature ? 'sig' : null,
    evidence.provenance ? 'slsa' : null,
    evidence.sbom ? 'sbom' : null,
    evidence.tests ? 'smoke' : null,
  ].filter(Boolean);
  return pieces.length > 0 ? pieces.join(' + ') : 'Evidence pending';
}

function vulnerabilityLabel(img: CatalogIndex['images'][number]): string {
  const summary = img.vulnSummary;
  if (!summary) return 'Scan pending';
  return `${summary.critical ?? 0} critical / ${summary.high ?? 0} high`;
}
---
{services.length > 0 && (
  <section class="space-y-3" data-pagefind-body>
    <div class="flex flex-wrap items-end justify-between gap-3">
      <div>
        <h2 class="heading text-2xl sm:text-3xl">Service Images</h2>
        <p class="mt-1 max-w-2xl text-sm text-ink-300">
          Platform-owned application services built from Nix package templates, cataloged separately from runtime tiers.
        </p>
      </div>
      <span class="chip">{services.length} service{services.length === 1 ? '' : 's'}</span>
    </div>

    <div class="grid gap-3 md:grid-cols-3">
      {services.map((img) => {
        const service = img.service;
        return (
          <a
            href={`${base}images/${img.id}`}
            class="group block rounded-lg border border-ink-800 bg-ink-950/25 p-4 no-underline transition hover:border-accent/40 hover:bg-ink-950/60"
          >
	            <div class="flex items-start justify-between gap-3">
	              <div>
	                <div class="font-mono text-sm font-semibold text-ink-50 group-hover:text-accent-soft">{img.id}</div>
	                <div class="mt-1 text-xs text-ink-300">{service?.template ?? 'service'} {service?.version ?? img.languageVersion}</div>
	              </div>
	              <span class={img.lifecycle.productionAllowed ? 'chip-accent' : 'chip-warn'}>
	                {img.lifecycle.productionAllowed ? 'prod allowed' : 'non-prod'}
	              </span>
	            </div>
	            <div class="mt-4 grid gap-2 text-xs text-ink-200">
	              <div class="flex items-center justify-between gap-3 border-t border-ink-800/50 pt-3">
	                <span class="text-ink-400">Lifecycle</span>
	                <span class="font-mono text-ink-100">{img.lifecycle.status}</span>
	              </div>
	              <div class="flex items-center justify-between gap-3">
	                <span class="text-ink-400">Ports</span>
	                <span class="font-mono text-ink-100">{portsLabel(service)}</span>
	              </div>
              <div class="flex items-center justify-between gap-3">
                <span class="text-ink-400">Storage</span>
                <span class="font-mono text-ink-100">{service?.stateful ? (service.dataDirs?.join(', ') || 'stateful') : 'stateless'}</span>
              </div>
              <div class="flex items-center justify-between gap-3">
	                <span class="text-ink-400">Smoke</span>
	                <span class="font-mono text-ink-100">{service?.smokeStatus ?? 'pending'}</span>
	              </div>
	              <div class="flex items-center justify-between gap-3">
	                <span class="text-ink-400">Vulnerabilities</span>
	                <span class="font-mono text-ink-100">{vulnerabilityLabel(img)}</span>
	              </div>
	              <div class="flex items-center justify-between gap-3">
	                <span class="text-ink-400">Evidence</span>
	                <span class="font-mono text-ink-100">{evidenceLabel(img)}</span>
              </div>
            </div>
          </a>
        );
      })}
    </div>
  </section>
)}
