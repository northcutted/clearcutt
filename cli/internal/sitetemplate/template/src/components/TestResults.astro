---
import type { ArchPayload } from '../lib/catalog-schema';
interface Props {
  architectures: ArchPayload[];
  rawTestResultsUrls?: Record<string, string>;
}
const { architectures, rawTestResultsUrls = {} } = Astro.props;
const merged = new Map<string, { name: string; statuses: Record<string, string> }>();
function displayAssertionName(name: string): string {
  if (name === 'Grype Vulnerability Gating') return 'Vulnerability gate';
  if (name === 'Syft SBOM Generation') return 'SBOM generation';
  return name;
}
for (const a of architectures) {
  if (!a.testResults) continue;
  for (const x of a.testResults.assertions) {
    if (!merged.has(x.name)) merged.set(x.name, { name: displayAssertionName(x.name), statuses: {} });
    merged.get(x.name)!.statuses[a.arch] = x.status;
  }
}
const rows = Array.from(merged.values());
const archs = architectures.map((a) => a.arch);
---
<section class="space-y-3">
  <header class="flex items-baseline justify-between">
    <h2 class="heading text-lg">Gating &amp; test results</h2>
    <div class="text-xs text-ink-300">
      {architectures.map((a) => a.testResults?.timestamp).filter(Boolean)[0]
        ? `Run ${architectures.find((a) => a.testResults?.timestamp)?.testResults?.timestamp}`
        : 'No timestamp'}
    </div>
  </header>
  <div class="surface-soft overflow-hidden">
    {rows.length === 0 ? (
      <div class="px-4 py-6 text-center text-sm text-ink-300">No test predicate attached.</div>
    ) : (
      <table class="table-clean">
        <thead>
          <tr>
            <th>Assertion</th>
            {archs.map((a) => <th>{a}</th>)}
          </tr>
        </thead>
        <tbody>
          {rows.map((r) => (
            <tr>
              <td class="font-medium">{r.name}</td>
              {archs.map((a) => {
                const s = r.statuses[a];
                const rawUrl = rawTestResultsUrls[a];
                if (!s) return <td class="text-ink-300">—</td>;
                if (s === 'passed') {
                  return (
                    <td>
                      {rawUrl ? (
                        <a href={rawUrl} target="_blank" rel="noreferrer" class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[10px] font-bold bg-emerald-500/10 text-emerald-400 border border-emerald-500/25 hover:bg-emerald-500/20 transition cursor-pointer" title="Verify raw test outputs JSON">
                          passed ↗
                        </a>
                      ) : (
                        <span class="chip-accent text-[11px]">passed</span>
                      )}
                    </td>
                  );
                }
                if (s === 'failed') {
                  return (
                    <td>
                      {rawUrl ? (
                        <a href={rawUrl} target="_blank" rel="noreferrer" class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[10px] font-bold bg-danger/10 text-danger border border-danger/25 hover:bg-danger/20 transition cursor-pointer" title="Verify raw test outputs JSON">
                          failed ↗
                        </a>
                      ) : (
                        <span class="chip-danger text-[11px]">failed</span>
                      )}
                    </td>
                  );
                }
                return (
                  <td>
                    {rawUrl ? (
                      <a href={rawUrl} target="_blank" rel="noreferrer" class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[10px] font-bold bg-warn/10 text-warn border border-warn/25 hover:bg-warn/20 transition cursor-pointer" title="Verify raw test outputs JSON">
                        {s} ↗
                      </a>
                    ) : (
                      <span class="chip-warn text-[11px]">{s}</span>
                    )}
                  </td>
                );
              })}
            </tr>
          ))}
        </tbody>
      </table>
    )}
  </div>
</section>
