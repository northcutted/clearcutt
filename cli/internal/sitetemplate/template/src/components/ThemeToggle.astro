---
// Accessible 3-state theme toggle: System → Light → Dark → System.
//
// `data-theme-mode` on the button records the *user-selected* preference
// (system | light | dark). `aria-pressed`-style state isn't quite right here
// because there are three states, so we update an `aria-label` describing
// the current mode AND what clicking will do next. Screen readers also get
// an announce-on-change via a politely-live region.
//
// Initial paint comes from the inline script in Base.astro's <head>, which
// adds/removes the `.dark` class before any CSS resolves. This script only
// wires the button interactivity.
---
<div class="flex items-center">
  <button
    type="button"
    data-theme-toggle
    aria-label="Theme: System. Click to switch to Light."
    title="Cycle theme (system → light → dark)"
    class="inline-flex h-9 w-9 items-center justify-center rounded-lg border border-ink-600/60 bg-ink-800/60 text-ink-200 transition hover:border-accent/40 hover:text-ink-50 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent/70 focus-visible:ring-offset-2 focus-visible:ring-offset-ink-950"
  >
    <!-- System (monitor) icon -->
    <svg
      data-theme-icon="system"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.8"
      stroke-linecap="round"
      stroke-linejoin="round"
      class="h-4 w-4"
      aria-hidden="true"
    >
      <rect x="3" y="4" width="18" height="13" rx="2" />
      <path d="M8 21h8M12 17v4" />
    </svg>
    <!-- Light (sun) icon -->
    <svg
      data-theme-icon="light"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.8"
      stroke-linecap="round"
      stroke-linejoin="round"
      class="hidden h-4 w-4"
      aria-hidden="true"
    >
      <circle cx="12" cy="12" r="4" />
      <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41" />
    </svg>
    <!-- Dark (moon) icon -->
    <svg
      data-theme-icon="dark"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.8"
      stroke-linecap="round"
      stroke-linejoin="round"
      class="hidden h-4 w-4"
      aria-hidden="true"
    >
      <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" />
    </svg>
  </button>
  <span class="sr-only" aria-live="polite" data-theme-announce></span>
</div>
<script is:inline>
  (function () {
    var KEY = 'theme';
    var CYCLE = ['system', 'light', 'dark'];

    function readMode() {
      try {
        var v = localStorage.getItem(KEY);
        if (v === 'light' || v === 'dark') return v;
      } catch (e) {}
      return 'system';
    }
    function systemDark() {
      return window.matchMedia('(prefers-color-scheme: dark)').matches;
    }
    function effective(mode) {
      if (mode === 'dark' || mode === 'light') return mode;
      return systemDark() ? 'dark' : 'light';
    }
    function nextLabel(mode) {
      var idx = CYCLE.indexOf(mode);
      var next = CYCLE[(idx + 1) % CYCLE.length];
      return next.charAt(0).toUpperCase() + next.slice(1);
    }
    function modeLabel(mode) {
      return mode.charAt(0).toUpperCase() + mode.slice(1);
    }

    function applyMode(mode, opts) {
      opts = opts || {};
      var eff = effective(mode);
      document.documentElement.classList.toggle('dark', eff === 'dark');

      document.querySelectorAll('[data-theme-toggle]').forEach(function (btn) {
        btn.dataset.themeMode = mode;
        btn.setAttribute(
          'aria-label',
          'Theme: ' + modeLabel(mode) + ' (currently ' + eff + '). Click to switch to ' + nextLabel(mode) + '.',
        );
        btn.querySelectorAll('[data-theme-icon]').forEach(function (el) {
          el.classList.toggle('hidden', el.dataset.themeIcon !== mode);
        });
      });

      if (opts.announce) {
        document.querySelectorAll('[data-theme-announce]').forEach(function (el) {
          el.textContent = 'Theme switched to ' + modeLabel(mode) + ' (' + eff + ').';
        });
      }
    }

    function cycle() {
      var cur = readMode();
      var idx = CYCLE.indexOf(cur);
      var next = CYCLE[(idx + 1) % CYCLE.length];
      try {
        if (next === 'system') localStorage.removeItem(KEY);
        else localStorage.setItem(KEY, next);
      } catch (e) {}
      applyMode(next, { announce: true });
    }

    // Initial sync of the button label/icon based on whatever the FOUC
    // pre-script already established on <html>.
    applyMode(readMode());

    document.querySelectorAll('[data-theme-toggle]').forEach(function (btn) {
      btn.addEventListener('click', cycle);
    });

    // Track OS-level changes while the user is in System mode. `addEventListener`
    // is universally supported on MediaQueryList from Safari 14 / Chrome 39+.
    try {
      window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', function () {
        if (readMode() === 'system') applyMode('system');
      });
    } catch (e) {}

    // Cross-tab sync: when another tab changes the preference, reflect here.
    window.addEventListener('storage', function (e) {
      if (e.key === KEY) applyMode(readMode());
    });
  })();
</script>
