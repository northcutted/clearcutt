---
import type { ReleaseEntry, ArchPayload } from '../lib/catalog-schema';
interface Props {
  release: ReleaseEntry;
  ownerRepo: string;
  architectures?: ArchPayload[];
  rawTestResultsUrls?: Record<string, string>;
}
const { release, ownerRepo, architectures = [], rawTestResultsUrls = {} } = Astro.props;
const prov = release.provenance;
const sig = release.signature;
const attestations = release.attestations || [];

function friendlyPredicate(type: string): string {
  if (!type || type === 'unknown') return 'unknown';
  if (type.includes('provenance/v1')) return 'SLSA Provenance v1.0';
  if (type.includes('provenance/v0.2')) return 'SLSA Provenance v0.2';
  return type;
}

function friendlyBuildType(type: string | null): string {
  if (!type || type === '—') return '—';
  if (type.includes('actions.github.com/buildTypes/')) return 'GitHub Actions Workflow';
  if (type.includes('actions.github.io/buildtypes/workflow')) return 'GitHub Actions Workflow';
  return type;
}

function friendlyBuilder(id: string): { label: string; url: string | null } {
  if (!id || id === 'unknown') return { label: 'unknown', url: null };
  if (id.includes('slsa-github-generator')) {
    const tagMatch = id.match(/@refs\/tags\/(v[0-9.]+)/) || id.match(/@(v[0-9.]+)/);
    const tag = tagMatch ? ` (${tagMatch[1]})` : '';
    return { label: `SLSA GitHub Generator${tag}`, url: id };
  }
  if (id.includes('attest-build-provenance')) {
    return { label: 'GitHub Provenance Attestor', url: id };
  }
  const workflow = parseOidcSubject(id);
  if (workflow) {
    const workflowFile = workflow.workflow.split('/').pop() || workflow.workflow;
    const ref = workflow.ref.replace(/^refs\/heads\//, '').replace(/^refs\/tags\//, '');
    return {
      label: `GitHub Actions (${workflowFile}${ref ? ` @ ${ref}` : ''})`,
      url: `https://github.com/${workflow.owner}/${workflow.repo}/actions/workflows/${workflowFile}`,
    };
  }
  if (id.startsWith('https://')) {
    try {
      const url = new URL(id);
      return { label: url.hostname + url.pathname, url: id };
    } catch {
      return { label: id, url: id };
    }
  }
  return { label: id, url: id };
}

interface ParsedSubject {
  owner: string;
  repo: string;
  workflow: string;
  ref: string;
}

function parseOidcSubject(subject: string | null | undefined): ParsedSubject | null {
  if (!subject) return null;
  // Format: https://github.com/owner/repo/.github/workflows/workflow.yml@refs/heads/branch or similar
  const match = subject.match(/github\.com\/([^/]+)\/([^/]+)\/\.github\/workflows\/([^@\s]+)@(.*)/);
  if (match) {
    return {
      owner: match[1],
      repo: match[2],
      workflow: `.github/workflows/${match[3]}`,
      ref: match[4]
    };
  }
  const simpleMatch = subject.match(/github\.com\/([^/]+)\/([^/]+)\/\.github\/workflows\/([^@\s]+)/);
  if (simpleMatch) {
    return {
      owner: simpleMatch[1],
      repo: simpleMatch[2],
      workflow: `.github/workflows/${simpleMatch[3]}`,
      ref: 'main'
    };
  }
  return null;
}

function attestationSourceFileUrl(subject: string | null | undefined): string | null {
  const parsed = parseOidcSubject(subject);
  if (!parsed) return null;
  const ref = parsed.ref.replace(/^refs\/heads\//, '').replace(/^refs\/tags\//, '');
  return `https://github.com/${parsed.owner}/${parsed.repo}/blob/${ref}/${parsed.workflow}`;
}

function shortSha(sha: string | null | undefined): string | null {
  if (!sha) return null;
  return sha.length > 7 ? sha.substring(0, 7) : sha;
}

function displaySourceUri(uri: string | null | undefined, fallback: string): string {
  if (!uri) return fallback;
  return uri
    .replace(/^git\+https:\/\//, '')
    .replace(/^https:\/\//, '')
    .replace(/@refs\/.*$/, '');
}

function attestationLabel(kind: string, predicateType: string): string {
  switch (kind) {
    case 'slsa-provenance':
      return 'SLSA provenance';
    case 'sbom':
      return 'SBOM';
    case 'test-results':
      return 'Test results';
    default:
      return friendlyPredicate(predicateType).split('/').pop() || 'Attestation';
  }
}

function shortDigest(digest: string | null | undefined): string {
  if (!digest) return 'unknown';
  const [alg, value] = digest.split(':');
  if (!value) return digest.length > 18 ? `${digest.slice(0, 18)}...` : digest;
  return `${alg}:${value.slice(0, 12)}...`;
}

function displaySigner(identity: string | null | undefined): string {
  const parsed = parseOidcSubject(identity);
  if (parsed) {
    const workflowFile = parsed.workflow.split('/').pop();
    const ref = parsed.ref.replace(/^refs\/heads\//, '').replace(/^refs\/tags\//, '');
    return `${workflowFile}${ref ? ` @ ${ref}` : ''}`;
  }
  if (!identity) return 'unknown';
  return identity.replace(/^https:\/\//, '');
}


const oidcDetails = sig?.certificate ? parseOidcSubject(sig.certificate.subject) : null;

// Attestations share one subject digest and one signer across every statement;
// what differs is the kind (what it proves), the source it was read from, and
// the individual Rekor transparency-log entry. So we group by kind, state the
// shared facts once, and surface the per-statement Rekor entries compactly —
// that's what makes the seemingly-duplicate rows meaningful.
const KIND_ORDER = ['slsa-provenance', 'sbom', 'test-results', 'custom'] as const;
const KIND_META: Record<string, { label: string; blurb: string; dot: string }> = {
  'slsa-provenance': {
    label: 'Build provenance',
    blurb: 'How and where the image was built — binds this digest to the exact workflow run, commit, and builder.',
    dot: 'bg-accent',
  },
  sbom: {
    label: 'SBOM',
    blurb: 'Software Bill of Materials — the full inventory of packages baked into the image.',
    dot: 'bg-sky-400',
  },
  'test-results': {
    label: 'Test results',
    blurb: 'Signed evidence that the release-gate test suite passed for this exact digest.',
    dot: 'bg-emerald-400',
  },
  custom: {
    label: 'Cosign signature',
    blurb: 'The keyless cosign signature statement covering the image index.',
    dot: 'bg-ink-400',
  },
};

interface AttGroup {
  kind: string;
  meta: { label: string; blurb: string; dot: string };
  predicateType: string;
  count: number;
  sources: string[];
  links: { run: string | null; workflow: string | null; githubApi: string | null; asset: string | null };
  entries: { index: number | null; url: string | null }[];
}

function groupAttestations(atts: typeof attestations): AttGroup[] {
  const map = new Map<string, AttGroup>();
  for (const a of atts) {
    let g = map.get(a.kind);
    if (!g) {
      g = {
        kind: a.kind,
        meta: KIND_META[a.kind] || {
          label: attestationLabel(a.kind, a.predicateType),
          blurb: '',
          dot: 'bg-ink-400',
        },
        predicateType: a.predicateType,
        count: 0,
        sources: [],
        links: { run: null, workflow: null, githubApi: null, asset: null },
        entries: [],
      };
      map.set(a.kind, g);
    }
    g.count += 1;
    for (const s of a.sources) if (!g.sources.includes(s)) g.sources.push(s);
    g.links.run ||= a.runUrl;
    const fileUrl = attestationSourceFileUrl(a.signerIdentity);
    g.links.workflow ||= fileUrl || a.workflowUrl;
    g.links.githubApi ||= a.githubApiUrl;
    g.links.asset ||= a.releaseAssetUrl ?? null;
    g.entries.push({ index: a.transparencyLogIndex, url: a.transparencyUrl });
  }
  // Newest transparency entry first within each group.
  for (const g of map.values()) g.entries.sort((x, y) => (y.index ?? 0) - (x.index ?? 0));
  const ordered: AttGroup[] = [];
  for (const k of KIND_ORDER) { const g = map.get(k); if (g) ordered.push(g); }
  for (const g of map.values()) if (!KIND_ORDER.includes(g.kind as (typeof KIND_ORDER)[number])) ordered.push(g);
  return ordered;
}

const attestationGroups = groupAttestations(attestations);
const attSubjectName = attestations.find((a) => a.subjectName)?.subjectName ?? null;
const attDigests = [...new Set(attestations.map((a) => a.subjectDigest).filter(Boolean))] as string[];
const attSigners = [...new Set(attestations.map((a) => a.signerIdentity).filter(Boolean))] as string[];

// Architectures covered by the multi-arch manifest index (the signed subject).
const attArches = Array.from(new Set((release.architectures || []).map((a) => a.arch))).filter(Boolean);

// Copy-paste verification commands bound to the exact signed subject (the
// multi-arch index digest), so each "Verify with" badge yields a runnable line.
const attRef = attSubjectName && attDigests.length === 1 ? `${attSubjectName}@${attDigests[0]}` : null;
const attSubject = attSigners[0] ?? `https://github.com/${ownerRepo}/.github/workflows/release.yml@refs/heads/main`;
const attIssuer = 'https://token.actions.githubusercontent.com';

function verifyOptions(g: AttGroup): VerifyOption[] {
  const out: VerifyOption[] = [];
  const idArgs = `--certificate-identity '${attSubject}' --certificate-oidc-issuer '${attIssuer}'`;
  if (g.sources.includes('oci')) {
    const cmd = !attRef
      ? ''
      : g.kind === 'custom'
        ? `cosign verify ${attRef} ${idArgs}`
        : `cosign verify-attestation ${attRef} --type ${COSIGN_ATTEST_TYPE[g.kind] ?? 'custom'} ${idArgs}`;
    out.push({ tool: 'cosign', source: 'OCI', cmd });
  }
  if (g.sources.includes('github')) {
    const pred = GH_PREDICATE_TYPE[g.kind] ? ` --predicate-type ${GH_PREDICATE_TYPE[g.kind]}` : '';
    const cmd = !attRef
      ? ''
      : `gh attestation verify oci://${attRef} --repo ${ownerRepo} --cert-identity '${attSubject}' --source-ref refs/heads/main${pred}`;
    out.push({ tool: 'gh CLI', source: 'GitHub', cmd });
  }
  return out;
}

// A record's discovery sources map onto the verification ecosystem a user is
// likely to already know. Both toolchains attest the same claim in our release
// flow, so a viewer can verify with whichever they trust:
//   oci    → cosign reads the attestation from the image's OCI referrers
//   github → GitHub first-party attestation, verifiable with the gh CLI
type VerifyOption = { tool: string; source: string; cmd: string };
// cosign verify-attestation --type value per attestation kind.
const COSIGN_ATTEST_TYPE: Record<string, string> = {
  'slsa-provenance': 'slsaprovenance',
  sbom: 'spdxjson',
  'test-results': 'custom',
};
// gh attestation --predicate-type filter, where a GitHub attestation exists.
const GH_PREDICATE_TYPE: Record<string, string> = {
  'slsa-provenance': 'https://slsa.dev/provenance/v1',
  sbom: 'https://spdx.dev/Document/v2.3',
};

// Gating results mapping
const merged = new Map<string, { name: string; statuses: Record<string, string> }>();
function displayAssertionName(name: string): string {
  if (name === 'Grype Vulnerability Gating') return 'Vulnerability gate';
  if (name === 'Syft SBOM Generation') return 'SBOM generation';
  return name;
}
for (const a of architectures) {
  if (!a.testResults) continue;
  for (const x of a.testResults.assertions) {
    if (!merged.has(x.name)) merged.set(x.name, { name: displayAssertionName(x.name), statuses: {} });
    merged.get(x.name)!.statuses[a.arch] = x.status;
  }
}
const gatingRows = Array.from(merged.values());
const gatingArchs = architectures.map((a) => a.arch);
---
<section class="space-y-4">
  <header class="flex flex-wrap items-baseline justify-between gap-2 border-b border-ink-800/40 pb-2">
    <div>
      <h2 class="heading text-lg">Provenance &amp; signatures</h2>
      <p class="text-xs text-ink-300">Cryptographically audit OCI identity claims and supply chain gating artifacts.</p>
    </div>
    {release.assetUrls.provenance && (
      <a href={release.assetUrls.provenance} class="chip hover:border-accent/40 font-mono text-xs flex items-center gap-1 shrink-0" target="_blank" rel="noreferrer">
        raw in-toto JSONL <span class="text-[10px]">↗</span>
      </a>
    )}
  </header>

  {!prov && !sig?.cosignBundlePresent ? (
    <div class="surface-soft p-6 rounded-2xl border border-ink-800/40 text-center">
      <p class="text-sm text-ink-300">
        No provenance or signature attestation found on the GHCR manifest. Either the build
        pipeline didn't attest this release, or the image was not published.
      </p>
    </div>
  ) : (
    <>
      <div class="grid gap-5 lg:grid-cols-3">
        {/* CARD 1: Cryptographic Proof (Cosign) */}
        <div class="surface-soft border border-ink-800/40 rounded-2xl p-5 space-y-4 flex flex-col justify-between">
          <div class="space-y-3">
            <header class="flex items-center justify-between border-b border-ink-800/50 pb-2.5">
              <h3 class="text-xs uppercase tracking-wider text-ink-300 font-bold">Cryptographic Proof</h3>
              {sig?.cosignBundlePresent ? (
                <span class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded-full text-[10px] font-bold bg-emerald-500/10 text-emerald-400 border border-emerald-500/25">
                  <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse" />
                  VERIFIED KEYLESS
                </span>
              ) : (
                <span class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded-full text-[10px] font-bold bg-warn/10 text-warn border border-warn/25">
                  <span class="w-1.5 h-1.5 rounded-full bg-warn" />
                  NO COSIGN SIGNATURE
                </span>
              )}
            </header>

            {sig?.cosignBundlePresent ? (
              <div class="divide-y divide-ink-800/30">
                {oidcDetails && (
                  <>
                    <div class="flex items-baseline justify-between text-xs py-2">
                      <span class="text-ink-300 font-medium">Source Repo</span>
                      <a href={`https://github.com/${oidcDetails.owner}/${oidcDetails.repo}`} class="text-ink-100 font-mono hover:text-accent-soft underline decoration-accent/40" target="_blank" rel="noreferrer">
                        {oidcDetails.owner}/{oidcDetails.repo}
                      </a>
                    </div>
                    <div class="flex items-baseline justify-between text-xs py-2">
                      <span class="text-ink-300 font-medium">Signing Workflow</span>
                      <span class="text-ink-100 font-mono text-[11px] truncate max-w-[150px] sm:max-w-[200px]" title={oidcDetails.workflow}>
                        {oidcDetails.workflow.split('/').pop()}
                      </span>
                    </div>
                    <div class="flex items-baseline justify-between text-xs py-2">
                      <span class="text-ink-300 font-medium">Workflow Ref</span>
                      <span class="px-1.5 py-0.5 rounded bg-ink-950/60 border border-ink-800 text-[10px] text-ink-200 font-mono">
                        {oidcDetails.ref}
                      </span>
                    </div>
                  </>
                )}

                <div class="flex items-baseline justify-between text-xs py-2">
                  <span class="text-ink-300 font-medium">OIDC Issuer</span>
                  <span class="text-ink-200 font-mono text-[10px]">
                    {sig.certificate?.issuer ? sig.certificate.issuer.replace('https://', '') : 'token.actions.githubusercontent.com'}
                  </span>
                </div>

                {sig.rekorLogIndex && (
                  <div class="flex items-baseline justify-between text-xs py-2">
                    <span class="text-ink-300 font-medium">Rekor Entry</span>
                    <a href={`https://search.sigstore.dev/?logIndex=${sig.rekorLogIndex}`} class="text-accent-soft font-mono hover:text-accent font-semibold underline decoration-accent/35" target="_blank" rel="noreferrer">
                      Log Index #{sig.rekorLogIndex} ↗
                    </a>
                  </div>
                )}
              </div>
            ) : (
              <p class="text-xs text-ink-300 leading-relaxed pt-2">
                This OCI release has not been signed via standard keyless sigstore/cosign OIDC tokens. Verify local deployment rules to ensure verification blocks are satisfied.
              </p>
            )}
          </div>

          {sig?.cosignBundlePresent && sig.certificate?.subject && (
            <details class="group rounded-lg border border-ink-800 bg-ink-950/70 p-2.5 font-mono text-[9.5px] text-ink-300 transition-all duration-200">
              <summary class="flex items-center justify-between text-[9px] uppercase tracking-wider font-sans font-bold text-ink-400 cursor-pointer list-none select-none hover:text-accent-soft transition-colors focus:outline-none">
                <span>OIDC Certificate Subject</span>
                <span class="text-ink-500 group-open:rotate-180 transition-transform duration-200 shrink-0">
                  <svg viewBox="0 0 24 24" class="h-3.5 w-3.5" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="6 9 12 15 18 9"/></svg>
                </span>
              </summary>
              <div class="mt-2 pt-2 border-t border-ink-800/40 break-all leading-normal text-ink-300 select-all">
                {sig.certificate.subject}
              </div>
            </details>
          )}
        </div>

        {/* CARD 2: SLSA Build Provenance */}
        <div class="surface-soft border border-ink-800/40 rounded-2xl p-5 space-y-4 flex flex-col justify-between">
          <div class="space-y-3">
            <header class="flex items-center justify-between border-b border-ink-800/50 pb-2.5">
              <h3 class="text-xs uppercase tracking-wider text-ink-300 font-bold">Supply Chain Provenance</h3>
              {prov ? (
                <span class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded-full text-[10px] font-bold bg-accent/15 text-accent-soft border border-accent/25">
                  <span class="w-1.5 h-1.5 rounded-full bg-accent shadow-[0_0_8px_rgba(var(--accent),0.5)]" />
                  SLSA LEVEL {prov.slsaLevel}
                </span>
              ) : (
                <span class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded-full text-[10px] font-bold bg-ink-800 text-ink-300 border border-ink-700/50">
                  NO PROVENANCE
                </span>
              )}
            </header>

            {prov ? (
              <div class="divide-y divide-ink-800/30">
                <div class="flex items-baseline justify-between text-xs py-2">
                  <span class="text-ink-300 font-medium">Builder</span>
                  {(() => {
                    const b = friendlyBuilder(prov.builder.id);
                    return b.url ? (
                      <a href={b.url} class="text-ink-100 font-mono hover:text-accent-soft underline decoration-accent/40" target="_blank" rel="noreferrer">
                        {b.label}
                      </a>
                    ) : (
                      <span class="text-ink-200 font-mono">{b.label}</span>
                    );
                  })()}
                </div>

                <div class="flex items-baseline justify-between text-xs py-2">
                  <span class="text-ink-300 font-medium">Build Type</span>
                  <span class="text-ink-200 font-mono text-[11px] truncate max-w-[150px] sm:max-w-[200px]">
                    {friendlyBuildType(prov.buildType)}
                  </span>
                </div>

                <div class="flex items-baseline justify-between text-xs py-2">
                  <span class="text-ink-300 font-medium">Predicate Schema</span>
                  <span class="text-ink-200 font-mono text-[10px]">
                    {friendlyPredicate(prov.predicateType).split('/').pop()}
                  </span>
                </div>

                <div class="flex items-baseline justify-between text-xs py-2">
                  <span class="text-ink-300 font-medium">Source Material</span>
                  <span class="text-ink-100 font-mono text-[11px]" title={prov.sourceUri || `github.com/${ownerRepo}`}>
                    {displaySourceUri(prov.sourceUri, `github.com/${ownerRepo}`)}
                  </span>
                </div>

                {prov.sourceRevision && (
                  <div class="flex items-baseline justify-between text-xs py-2">
                    <span class="text-ink-300 font-medium">Commit SHA</span>
                    <a href={`https://github.com/${ownerRepo}/commit/${prov.sourceRevision}`} class="px-1.5 py-0.5 rounded bg-ink-950/60 border border-ink-800 text-[10px] text-accent-soft font-mono font-bold hover:text-accent" target="_blank" rel="noreferrer">
                      {shortSha(prov.sourceRevision)} ↗
                    </a>
                  </div>
                )}
              </div>
            ) : (
              <p class="text-xs text-ink-300 leading-relaxed pt-2">
                No formal supply chain build provenance envelope was found. Attesting compiler runs prevents tampering by linking binary digests to cryptographic parent hashes.
              </p>
            )}
          </div>

          {prov && (
            <div class="rounded-lg border border-ink-800 bg-ink-950/70 p-2.5 font-mono text-[9.5px] text-ink-300 flex items-center justify-between select-none">
              <span class="text-ink-400 font-sans font-semibold">Non-falsifiable attestation:</span>
              <span class="text-emerald-400 font-semibold font-mono flex items-center gap-1.5">
                <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 shadow-[0_0_8px_rgba(52,211,153,0.4)]" /> Passed
              </span>
            </div>
          )}
        </div>

        {/* CARD 3: Supply Chain test assertions */}
        <div class="surface-soft border border-ink-800/40 rounded-2xl p-5 space-y-4 flex flex-col justify-between">
          <div class="space-y-3">
            <header class="flex items-center justify-between border-b border-ink-800/50 pb-2.5">
              <h3 class="text-xs uppercase tracking-wider text-ink-300 font-bold">Compilation &amp; Tests</h3>
              {gatingRows.length > 0 && !gatingRows.some(r => gatingArchs.some(a => r.statuses[a] === 'failed')) ? (
                <span class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded-full text-[10px] font-bold bg-emerald-500/10 text-emerald-400 border border-emerald-500/25">
                  <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse" />
                  TESTS PASSED
                </span>
              ) : (
                <span class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded-full text-[10px] font-bold bg-danger/10 text-danger border border-danger/25">
                  <span class="w-1.5 h-1.5 rounded-full bg-danger" />
                  TEST FAILED
                </span>
              )}
            </header>

            {gatingRows.length === 0 ? (
              <p class="text-xs text-ink-300 leading-relaxed pt-2">
                No policy predicates or compile verifications are attached. Compile and test predicates record whether binaries satisfied release assertions before publication.
              </p>
            ) : (
              <div class="divide-y divide-ink-800/30">
                {gatingRows.map((r) => (
                  <div class="flex items-center justify-between text-xs py-2.5">
                    <span class="text-ink-300 font-medium">{r.name}</span>
                    <div class="flex gap-1.5">
                      {gatingArchs.map((a) => {
                        const s = r.statuses[a];
                        const rawUrl = rawTestResultsUrls[a];
                        if (!s) return <span class="text-ink-400 font-mono text-[10px]">—</span>;
                        
                        const badgeClass = s === 'passed' 
                          ? 'bg-emerald-500/10 text-emerald-400 border-emerald-500/25 hover:bg-emerald-500/20' 
                          : s === 'failed' 
                            ? 'bg-danger/10 text-danger border-danger/25 hover:bg-danger/20' 
                            : 'bg-warn/10 text-warn border-warn/25 hover:bg-warn/20';
                            
                        return rawUrl ? (
                          <a 
                            href={rawUrl} 
                            target="_blank" 
                            rel="noreferrer" 
                            class={`inline-flex items-center gap-0.5 px-1.5 py-0.5 rounded border text-[9px] font-mono font-bold ${badgeClass} transition cursor-pointer`}
                            title={`Verify raw ${a} ${r.name} outputs JSON`}
                          >
                            {a}:{s} ↗
                          </a>
                        ) : (
                          <span class={`inline-flex items-center px-1.5 py-0.5 rounded border text-[9px] font-mono font-bold ${badgeClass}`}>
                            {a}:{s}
                          </span>
                        );
                      })}
                    </div>
                  </div>
                ))}
              </div>
            )}
          </div>

          <div class="rounded-lg border border-ink-800 bg-ink-950/70 p-2.5 font-mono text-[9.5px] text-ink-300 flex items-center justify-between select-none">
            <span class="text-ink-400 font-sans font-semibold">Gating timestamp:</span>
            <span class="text-ink-200 font-mono">
              {architectures.map((a) => a.testResults?.timestamp).filter(Boolean)[0]
                ? String(architectures.find((a) => a.testResults?.timestamp)?.testResults?.timestamp).substring(0, 16)
                : '—'}
            </span>
          </div>
        </div>
      </div>

      {attestations.length > 0 && (
        <div class="surface-soft overflow-hidden">
          <div class="flex flex-wrap items-baseline justify-between gap-2 border-b border-ink-800/50 px-4 py-3">
            <div>
              <h3 class="text-xs uppercase tracking-wider text-ink-300 font-bold">Attestations</h3>
              <p class="mt-0.5 max-w-2xl text-[11px] leading-relaxed text-ink-400">
                {attestationGroups.length} kinds of evidence for this image. The counts are how many times each was independently signed into the public transparency log — <span class="text-ink-300">not</span> how many distinct artifacts exist.
              </p>
            </div>
            <span class="flex shrink-0 items-baseline gap-1.5 font-mono text-ink-400">
              <span class="text-2xl font-bold leading-none text-ink-50">{attestations.length}</span>
              <span class="text-[10px] uppercase tracking-wider">signed records</span>
            </span>
          </div>

          {/* Shared across every statement below — stated once instead of repeated per row. */}
          <div class="border-b border-ink-800/30 bg-ink-950/40 px-4 py-3">
            <div class="flex flex-wrap items-center gap-x-6 gap-y-2.5 text-[10.5px]">
              {attSubjectName && (
                <span class="inline-flex min-w-0 items-center gap-2 rounded-md bg-ink-900/40 border border-ink-800/60 px-2 py-1">
                  <span class="uppercase tracking-wider text-ink-400 text-[9px] font-bold font-sans">Subject</span>
                  <span class="truncate font-mono text-ink-100 font-medium" title={attSubjectName}>{attSubjectName}</span>
                </span>
              )}
              {attDigests.length === 1 && (
                <span class="inline-flex items-center gap-2 rounded-md bg-ink-900/40 border border-ink-800/60 px-2 py-1">
                  <span class="uppercase tracking-wider text-ink-400 text-[9px] font-bold font-sans">Digest</span>
                  <span class="font-mono text-accent-soft font-semibold" title={attDigests[0]}>{shortDigest(attDigests[0])}</span>
                  <span class="rounded bg-ink-950/60 px-1.5 py-0.2 text-[8px] font-sans font-bold text-ink-300 uppercase tracking-wider border border-ink-800 leading-none" title="The signed subject is the multi-arch image index, not a single architecture.">
                    index{attArches.length ? ` · ${attArches.join('+')}` : ''}
                  </span>
                </span>
              )}
              {attSigners.length === 1 && (
                <span class="inline-flex min-w-0 items-center gap-2 rounded-md bg-ink-900/40 border border-ink-800/60 px-2 py-1">
                  <span class="uppercase tracking-wider text-ink-400 text-[9px] font-bold font-sans">Signed By</span>
                  <span class="truncate font-mono text-ink-100 font-medium" title={attSigners[0]}>{displaySigner(attSigners[0])}</span>
                  <span class="inline-flex items-center gap-1 text-[9px] font-bold text-emerald-400 font-mono bg-emerald-500/10 px-1.5 py-0.2 rounded border border-emerald-500/20 leading-none">keyless ✓</span>
                </span>
              )}
            </div>
          </div>

          {/* Legend: the two axes that explain the record counts — verification
              ecosystem and architecture. Stated once, up top. */}
          <div class="border-b border-ink-800/40 px-4 py-3 text-[11px] leading-relaxed text-ink-400">
            <div class="mb-1.5 font-semibold uppercase tracking-wider text-ink-300 text-[10px]">Two ways to verify — pick the ecosystem you know</div>
            <div class="grid gap-x-6 gap-y-1.5 sm:grid-cols-2">
              <div class="flex items-start gap-2">
                <span class="mt-px shrink-0 rounded border border-ink-700 bg-ink-950/60 px-1.5 py-0.5 font-mono text-[10px] text-ink-200">cosign · OCI</span>
                <span>Attestation lives with the image in the registry. Verify with <code class="font-mono text-ink-300">cosign verify-attestation</code>.</span>
              </div>
              <div class="flex items-start gap-2">
                <span class="mt-px shrink-0 rounded border border-ink-700 bg-ink-950/60 px-1.5 py-0.5 font-mono text-[10px] text-ink-200">gh CLI · GitHub</span>
                <span>GitHub first-party attestation. Verify with <code class="font-mono text-ink-300">gh attestation verify</code>.</span>
              </div>
            </div>
            <p class="mt-2 text-ink-400">
              The subject above is the <span class="text-ink-300">multi-arch index</span>{attArches.length > 1 ? <> ({attArches.join(' + ')})</> : null}. Each architecture's SBOM is attested separately, in <span class="text-ink-300">both</span> ecosystems — so one SBOM naturally appears as several signed records below.
              Records also accumulate as the image is rebuilt, with each release re-signing into the transparency log afresh. Every entry is independent and publicly verifiable: click any <span class="font-mono text-accent-soft">#index</span> below to inspect it in <span class="text-ink-200">Sigstore Rekor</span>, or use the copy-paste commands below to verify them locally.
            </p>
          </div>

          <div class="divide-y divide-ink-800/60">
            {attestationGroups.map((g) => (
              <div class="px-4 py-5">
                <div class="flex items-start justify-between gap-3">
                  <div class="flex min-w-0 items-start gap-2.5">
                    <span class={`mt-1.5 h-2.5 w-2.5 shrink-0 rounded-full ${g.meta.dot}`} />
                    <div class="min-w-0">
                      <div class="flex flex-wrap items-baseline gap-x-2 gap-y-0.5">
                        <span class="text-sm font-semibold text-ink-50">{g.meta.label}</span>
                        <span class="truncate font-mono text-[9px] text-ink-400" title={g.predicateType}>{g.predicateType.replace(/^https:\/\//, '')}</span>
                      </div>
                      {g.meta.blurb && <p class="mt-1 text-[11px] leading-snug text-ink-300">{g.meta.blurb}</p>}
                    </div>
                  </div>
                  <span class="flex shrink-0 items-baseline gap-1 rounded-full border border-ink-600/70 bg-ink-800/80 px-3 py-1 text-ink-400" title={`Signed and logged ${g.count} time${g.count === 1 ? '' : 's'} in the public transparency log`}>
                    <span class="text-base font-bold leading-none text-ink-100">{g.count}×</span>
                    <span class="text-[10px]">signed</span>
                  </span>
                </div>

                <div class="mt-3.5 grid grid-cols-[5.5rem_1fr] items-center gap-x-3 gap-y-2.5 pl-[22px]">
                  <span class="text-[9px] uppercase tracking-wider text-ink-500" title="Click a badge to copy a ready-to-run verification command.">Verify with</span>
                  <div class="flex flex-wrap gap-1.5">
                    {verifyOptions(g).map((e) => (
                      <button
                        type="button"
                        data-verify-copy
                        data-cmd={e.cmd}
                        title={e.cmd ? `Click to copy:\n${e.cmd}` : `${e.tool} · ${e.source}`}
                        class="group/vc inline-flex items-center gap-1.5 rounded border border-ink-700 bg-ink-950/60 px-1.5 py-0.5 font-mono text-[9px] text-ink-200 transition hover:border-accent/50 hover:text-accent-soft focus-visible:border-accent/50 focus:outline-none"
                      >
                        <span>{e.tool}<span class="text-ink-500"> · {e.source}</span></span>
                        <span data-vc-icon aria-hidden="true" class="text-ink-500 transition group-hover/vc:text-accent-soft inline-flex items-center">
                          <svg viewBox="0 0 24 24" class="h-3 w-3" fill="none" stroke="currentColor" stroke-width="2.5"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15V5a2 2 0 0 1 2-2h10"/></svg>
                        </span>
                      </button>
                    ))}
                  </div>

                  {(g.links.run || g.links.workflow || g.links.asset) && (
                    <>
                      <span class="text-[9px] uppercase tracking-wider text-ink-500" title="Open the source artifacts behind these records.">Inspect</span>
                      <div class="flex flex-wrap items-center gap-1.5">
                        {g.links.run && (
                          <a href={g.links.run} class="chip text-[10px] hover:border-accent/40" target="_blank" rel="noreferrer">run ↗</a>
                        )}
                        {g.links.workflow && (
                          <a href={g.links.workflow} class="chip text-[10px] hover:border-accent/40" target="_blank" rel="noreferrer">workflow file ↗</a>
                        )}
                        {g.links.asset && (
                          <a href={g.links.asset} class="chip text-[10px] hover:border-accent/40" target="_blank" rel="noreferrer">asset ↗</a>
                        )}
                      </div>
                    </>
                  )}

                  {g.entries.some((e) => e.url) && (
                    <>
                      <span class="self-start pt-1 text-[9px] uppercase tracking-wider text-ink-500" title="Each record is an independent entry in the Sigstore Rekor public transparency log.">Rekor log</span>
                      <div class="flex flex-wrap items-center gap-1.5">
                        {g.entries.slice(0, 3).map((e) => (e.url ? (
                          <a href={e.url} class="rounded border border-ink-700 bg-ink-950/60 px-1.5 py-0.5 font-mono text-[9px] text-accent-soft hover:border-accent/40 hover:text-accent" target="_blank" rel="noreferrer" title={`Inspect this statement in the public transparency log · index ${e.index}`}>#{e.index} ↗</a>
                        ) : null))}
                        {g.entries.length > 3 && (
                          <>
                            <button
                              type="button"
                              data-rekor-expand-btn
                              class="rounded border border-ink-700 bg-ink-900 px-1.5 py-0.5 font-mono text-[9px] text-ink-300 hover:border-accent/40 hover:text-accent-soft transition font-semibold"
                            >
                              + {g.entries.length - 3} historical logs
                            </button>
                            <span data-rekor-expanded-list class="hidden items-center gap-1.5 flex-wrap">
                              {g.entries.slice(3).map((e) => (e.url ? (
                                <a href={e.url} class="rounded border border-ink-700 bg-ink-950/60 px-1.5 py-0.5 font-mono text-[9px] text-accent-soft hover:border-accent/40 hover:text-accent" target="_blank" rel="noreferrer" title={`Inspect this statement in the public transparency log · index ${e.index}`}>#{e.index} ↗</a>
                              ) : null))}
                            </span>
                          </>
                        )}
                      </div>
                    </>
                  )}
                </div>
              </div>
            ))}
          </div>

        </div>
      )}
    </>
  )}
</section>

<script>
  // Click-to-copy for the "Verify with" badges: copies the full, runnable
  // verification command and flashes a check in place of the copy glyph.
  document.querySelectorAll<HTMLButtonElement>('[data-verify-copy]').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const cmd = btn.getAttribute('data-cmd');
      if (!cmd) return;
      try {
        await navigator.clipboard.writeText(cmd);
        const icon = btn.querySelector<HTMLElement>('[data-vc-icon]');
        if (icon) {
          const prevSvg = icon.innerHTML;
          icon.innerHTML = `<svg viewBox="0 0 24 24" class="h-3 w-3 text-emerald-400 animate-pulse" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg>`;
          window.setTimeout(() => {
            icon.innerHTML = prevSvg;
          }, 1200);
        }
      } catch { /* clipboard unavailable */ }
    });
  });

  // Toggle historical Rekor entries
  document.querySelectorAll<HTMLButtonElement>('[data-rekor-expand-btn]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const parent = btn.parentElement;
      if (!parent) return;
      const list = parent.querySelector<HTMLElement>('[data-rekor-expanded-list]');
      if (list) {
        list.classList.remove('hidden');
        list.classList.add('flex');
        btn.classList.add('hidden');
      }
    });
  });
</script>
