---
import type { CatalogIndex } from '../lib/catalog-schema';
import LangIcon from './LangIcon.astro';
import { channelStatus, evidencePillKind, statusLabel } from '../lib/evidence-status';

interface Props { index: CatalogIndex }
const { index } = Astro.props;
const base = (import.meta.env.BASE_URL ?? '/').replace(/\/$/, '') + '/';
const importedImages = index.images.filter((img) =>
  img.governance?.imported ||
  img.origin?.kind === 'imported' ||
  img.origin?.createdByClearCutt === false ||
  img.origin?.provenanceClaim === 'none'
);

function chipClass(kind: ReturnType<typeof evidencePillKind>): string {
  if (kind === 'ok') return 'chip-accent';
  if (kind === 'info') return 'chip border-sky-500/30 bg-sky-500/10 text-sky-300';
  return 'chip-warn';
}
---
{importedImages.length > 0 && (
  <section class="surface-soft space-y-4 px-5 py-5">
    <div class="flex flex-wrap items-start justify-between gap-3">
      <div>
        <h2 class="heading text-xl text-ink-50">Imported Images</h2>
        <p class="mt-1 max-w-2xl text-sm text-ink-300">
          ClearCutt did not build these images. No build provenance is inferred; missing evidence remains visible as governance gaps.
        </p>
      </div>
      <span class="chip">Imported image</span>
    </div>
    <div class="grid gap-3 md:grid-cols-2 xl:grid-cols-3">
      {importedImages.map((img) => {
        const evidence = img.evidence;
        const provenance = channelStatus(evidence, 'provenance', img.provenance);
        const sbom = channelStatus(evidence, 'sbom', evidence?.sbom);
        return (
          <a href={`${base}images/${img.id}`} class="block rounded-lg border border-ink-800 bg-ink-950/30 p-4 no-underline transition hover:border-accent/40 hover:bg-ink-950/60">
            <div class="flex items-start gap-3">
              <span class="inline-flex h-10 w-10 shrink-0 items-center justify-center rounded-lg border border-ink-700/60 bg-ink-800/60 p-2">
                <LangIcon language={img.language} class="h-6 w-6" />
              </span>
              <div class="min-w-0 flex-1">
                <div class="flex flex-wrap items-center gap-2">
                  <span class="chip-accent text-[10px]">Imported image</span>
                  <span class="font-mono text-[10px] text-ink-400">{img.latestTag}</span>
                </div>
                <h3 class="mt-2 truncate font-mono text-sm font-semibold text-ink-100">{img.id}</h3>
                <p class="mt-1 text-xs text-ink-300">{img.languageDisplay} {img.languageVersion} · {img.tier}</p>
                <div class="mt-3 flex flex-wrap gap-2 text-[10px]">
                  <span class={chipClass(evidencePillKind(provenance.status))}>
                    Provenance: {statusLabel(provenance.status)}
                  </span>
                  <span class={chipClass(evidencePillKind(sbom.status))}>
                    SBOM: {statusLabel(sbom.status)}
                  </span>
                </div>
              </div>
            </div>
          </a>
        );
      })}
    </div>
  </section>
)}
