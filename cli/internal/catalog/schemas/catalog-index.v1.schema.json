{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CatalogIndex",
  "type": "object",
  "required": [
    "schemaVersion",
    "generatedAt",
    "generator",
    "source",
    "summary",
    "owner",
    "repo",
    "repoUrl",
    "registryBase",
    "latestTag",
    "releases",
    "languages",
    "tiers",
    "images"
  ],
  "properties": {
    "schemaVersion": { "type": "string", "const": "clearcutt.catalog.index/v1" },
    "generatedAt": { "type": "string" },
    "generator": {
      "type": "object",
      "required": ["name", "version", "commit"],
      "properties": {
        "name": { "type": "string" },
        "version": { "type": "string" },
        "commit": { "type": "string" }
      }
    },
    "source": {
      "type": "object",
      "required": ["owner", "repo", "repoUrl", "registryBase"],
      "properties": {
        "owner": { "type": "string" },
        "repo": { "type": "string" },
        "repoUrl": { "type": "string" },
        "registryBase": { "type": "string" }
      }
    },
    "summary": {
      "type": "object",
      "required": ["imageCount", "releaseCount", "signedCount", "provenanceCount", "sbomCount", "scanCount", "passingCount"],
      "properties": {
        "imageCount": { "type": "integer" },
        "releaseCount": { "type": "integer" },
        "signedCount": { "type": "integer" },
        "provenanceCount": { "type": "integer" },
        "sbomCount": { "type": "integer" },
        "scanCount": { "type": "integer" },
        "passingCount": { "type": "integer" }
      }
    },
    "owner": { "type": "string" },
    "repo": { "type": "string" },
    "repoUrl": { "type": "string" },
    "registryBase": { "type": "string" },
    "latestTag": { "type": "string" },
    "releases": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["tag", "publishedAt", "isLatest"],
        "properties": {
          "tag": { "type": "string" },
          "publishedAt": { "type": "string" },
          "isLatest": { "type": "boolean" }
        }
      }
    },
    "languages": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "displayName", "version"],
        "properties": {
          "id": { "type": "string" },
          "displayName": { "type": "string" },
          "version": { "type": "string" },
          "icon": { "type": ["string", "null"] }
        }
      }
    },
    "tiers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "blurb"],
        "properties": {
          "id": { "type": "string", "enum": ["dev", "slim", "distroless"] },
          "name": { "type": "string" },
          "blurb": { "type": "string" }
        }
      }
    },
    "images": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/CatalogImageSummary"
      }
    }
  },
  "definitions": {
    "EvidenceSummary": {
      "type": "object",
      "required": [
        "signature",
        "provenance",
        "sbom",
        "tests",
        "vulnerabilities",
        "archCount",
        "sbomArchCount",
        "testArchCount",
        "passedTestArchCount",
        "vulnerabilityArchCount"
      ],
      "properties": {
        "signature": { "type": "boolean" },
        "provenance": { "type": "boolean" },
        "sbom": { "type": "boolean" },
        "tests": { "type": "boolean" },
        "vulnerabilities": { "type": "boolean" },
        "statuses": { "$ref": "#/definitions/EvidenceStatuses" },
        "archCount": { "type": "integer" },
        "sbomArchCount": { "type": "integer" },
        "testArchCount": { "type": "integer" },
        "passedTestArchCount": { "type": "integer" },
        "vulnerabilityArchCount": { "type": "integer" }
      }
    },
    "EvidenceStatuses": {
      "type": "object",
      "properties": {
        "signature": { "$ref": "#/definitions/EvidenceChannelStatus" },
        "provenance": { "$ref": "#/definitions/EvidenceChannelStatus" },
        "sbom": { "$ref": "#/definitions/EvidenceChannelStatus" },
        "tests": { "$ref": "#/definitions/EvidenceChannelStatus" },
        "vulnerabilities": { "$ref": "#/definitions/EvidenceChannelStatus" }
      }
    },
    "EvidenceChannelStatus": {
      "type": "object",
      "required": ["status"],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["missing", "observed", "verified", "attested", "stale", "unknown"]
        },
        "source": { "type": "string" },
        "claim": { "type": "string" }
      }
    },
    "ImageOrigin": {
      "type": "object",
      "required": ["kind", "createdByClearCutt"],
      "properties": {
        "kind": { "type": "string", "enum": ["clearcutt", "imported"] },
        "createdByClearCutt": { "type": "boolean" },
        "sourceRef": { "type": "string" },
        "digestRef": { "type": "string" },
        "observedAt": { "type": "string" },
        "observationMode": { "type": "string" },
        "provenanceClaim": { "type": "string", "enum": ["none", "external", "clearcutt"] }
      }
    },
    "ImageGovernance": {
      "type": "object",
      "required": ["imported"],
      "properties": {
        "imported": { "type": "boolean" },
        "owner": { "type": "string" },
        "classificationConfidence": { "type": "string" },
        "productionIntent": { "type": "string" },
        "notes": { "type": "array", "items": { "type": "string" } }
      }
    },
    "EvidencePolicy": {
      "type": "object",
      "properties": {
        "signature": { "type": "string" },
        "sbom": { "type": "string" },
        "provenance": { "type": "string" },
        "vulnerabilityScan": { "type": "string" },
        "tests": { "type": "string" }
      }
    },
    "Lifecycle": {
      "type": "object",
      "required": [
        "status",
        "support",
        "productionAllowed",
        "deprecatedAt",
        "eolAt",
        "reason"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["active", "preview", "deprecated", "eol", "experimental", "blocked"]
        },
        "support": {
          "type": "string",
          "enum": ["lts", "current", "preview", "legacy", "unsupported"]
        },
        "productionAllowed": { "type": "boolean" },
        "deprecatedAt": { "type": ["string", "null"] },
        "eolAt": { "type": ["string", "null"] },
        "reason": { "type": ["string", "null"] }
      }
    },
    "RuntimeContract": {
      "type": "object",
      "required": [
        "user",
        "workingDir",
        "shellPresent",
        "packageManagerPresent",
        "caCertificatesPresent",
        "timezoneDataPresent",
        "defaultEntrypoint",
        "productionTier"
      ],
      "properties": {
        "user": { "type": ["string", "null"] },
        "workingDir": { "type": ["string", "null"] },
        "shellPresent": { "type": ["boolean", "null"] },
        "packageManagerPresent": { "type": ["boolean", "null"] },
        "caCertificatesPresent": { "type": ["boolean", "null"] },
        "timezoneDataPresent": { "type": ["boolean", "null"] },
        "defaultEntrypoint": { "type": ["string", "null"] },
        "productionTier": { "type": "boolean" }
      }
    },
    "CatalogImageSummary": {
      "type": "object",
      "required": [
        "id",
        "language",
        "languageDisplay",
        "languageVersion",
        "tier",
        "latestTag",
        "latestPackageCount",
        "architectures",
        "signed",
        "provenance",
        "passed",
        "lifecycle",
        "runtimeContract"
      ],
      "properties": {
        "id": { "type": "string" },
        "language": { "type": "string" },
        "languageDisplay": { "type": "string" },
        "languageVersion": { "type": "string" },
        "tier": { "type": "string", "enum": ["dev", "slim", "distroless"] },
        "latestTag": { "type": "string" },
        "latestPackageCount": { "type": "integer" },
        "architectures": {
          "type": "array",
          "items": { "type": "string" }
        },
        "signed": { "type": "boolean" },
        "provenance": { "type": "boolean" },
        "evidence": { "$ref": "#/definitions/EvidenceSummary" },
        "passed": { "type": "boolean" },
        "lifecycle": { "$ref": "#/definitions/Lifecycle" },
        "runtimeContract": { "$ref": "#/definitions/RuntimeContract" },
        "origin": { "$ref": "#/definitions/ImageOrigin" },
        "governance": { "$ref": "#/definitions/ImageGovernance" },
        "evidencePolicy": { "$ref": "#/definitions/EvidencePolicy" },
        "vulnSummary": {
          "type": ["object", "null"],
          "required": ["critical", "high", "medium", "low", "scannedAt"],
          "properties": {
            "critical": { "type": "integer" },
            "high": { "type": "integer" },
            "medium": { "type": "integer" },
            "low": { "type": "integer" },
            "scannedAt": { "type": ["string", "null"] },
            "remediation": {
              "type": "object",
              "required": ["eligible", "baseLayer", "noFixedVersion", "belowPriorityThreshold", "otherDeferred"],
              "properties": {
                "eligible": { "type": "integer" },
                "baseLayer": { "type": "integer" },
                "noFixedVersion": { "type": "integer" },
                "belowPriorityThreshold": { "type": "integer" },
                "otherDeferred": { "type": "integer" }
              }
            }
          }
        }
      }
    }
  }
}
