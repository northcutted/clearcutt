{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "EvidenceManifestV1",
  "type": "object",
  "required": ["schemaVersion", "generatedAt", "source", "summary", "releases"],
  "properties": {
    "schemaVersion": { "type": "string", "const": "clearcutt.catalog.evidence-manifest/v1" },
    "generatedAt": { "type": "string" },
    "source": {
      "type": "object",
      "required": ["owner", "repo", "repoUrl", "registryBase"],
      "properties": {
        "owner": { "type": "string" },
        "repo": { "type": "string" },
        "repoUrl": { "type": "string" },
        "registryBase": { "type": "string" }
      }
    },
    "summary": {
      "type": "object",
      "required": ["imageReleases", "complete", "missingEvidence"],
      "properties": {
        "imageReleases": { "type": "integer" },
        "complete": { "type": "integer" },
        "missingEvidence": { "type": "integer" }
      }
    },
    "releases": {
      "type": "array",
      "items": { "$ref": "#/definitions/EvidenceManifestRelease" }
    }
  },
  "definitions": {
    "EvidenceManifestRelease": {
      "type": "object",
      "required": [
        "imageId",
        "kind",
        "tag",
        "publishedAt",
        "isLatest",
        "fullName",
        "imageRef",
        "channels",
        "architectures",
        "assets",
        "catalogRecord"
      ],
      "properties": {
        "imageId": { "type": "string" },
        "kind": { "type": "string" },
        "tag": { "type": "string" },
        "publishedAt": { "type": "string" },
        "isLatest": { "type": "boolean" },
        "fullName": { "type": "string" },
        "imageRef": { "type": "string" },
        "immutableRef": { "type": ["string", "null"] },
        "manifestDigest": { "type": ["string", "null"] },
        "channels": { "$ref": "#/definitions/EvidenceManifestChannels" },
        "missing": {
          "type": "array",
          "items": { "type": "string" }
        },
        "architectures": {
          "type": "array",
          "items": { "$ref": "#/definitions/EvidenceManifestArchitecture" }
        },
        "signature": { "$ref": "#/definitions/EvidenceManifestSignature" },
        "provenance": { "$ref": "#/definitions/EvidenceManifestProvenance" },
        "assets": {
          "type": "object",
          "properties": {
            "sbom": {
              "type": ["object", "null"],
              "additionalProperties": { "type": "string" }
            },
            "provenance": { "type": ["string", "null"] },
            "testResults": {
              "type": ["object", "null"],
              "additionalProperties": { "type": "string" }
            },
            "digest": { "type": ["string", "null"] }
          }
        },
        "catalogRecord": { "type": "string" }
      }
    },
    "EvidenceManifestChannels": {
      "type": "object",
      "required": ["signature", "provenance", "sbom", "tests", "vulnerabilities", "exceptions", "vex"],
      "properties": {
        "signature": { "$ref": "#/definitions/EvidenceManifestChannel" },
        "provenance": { "$ref": "#/definitions/EvidenceManifestChannel" },
        "sbom": { "$ref": "#/definitions/EvidenceManifestChannel" },
        "tests": { "$ref": "#/definitions/EvidenceManifestChannel" },
        "vulnerabilities": { "$ref": "#/definitions/EvidenceManifestChannel" },
        "exceptions": { "$ref": "#/definitions/EvidenceManifestChannel" },
        "vex": { "$ref": "#/definitions/EvidenceManifestChannel" }
      }
    },
    "EvidenceManifestChannel": {
      "type": "object",
      "required": ["expected", "observed", "status"],
      "properties": {
        "expected": { "type": "boolean" },
        "observed": { "type": "boolean" },
        "status": {
          "type": "string",
          "enum": ["present", "missing", "partial", "not_applicable", "on_demand"]
        },
        "detail": { "type": "string" }
      }
    },
    "EvidenceManifestArchitecture": {
      "type": "object",
      "required": ["arch", "os", "sbom", "tests", "vulnerabilities"],
      "properties": {
        "arch": { "type": "string" },
        "os": { "type": "string" },
        "imageDigest": { "type": ["string", "null"] },
        "sbom": { "type": "boolean" },
        "tests": { "type": "boolean" },
        "vulnerabilities": { "type": "boolean" }
      }
    },
    "EvidenceManifestSignature": {
      "type": "object",
      "properties": {
        "subject": { "type": ["string", "null"] },
        "issuer": { "type": ["string", "null"] },
        "rekorLogIndex": { "type": ["integer", "null"] }
      }
    },
    "EvidenceManifestProvenance": {
      "type": "object",
      "required": ["predicateType", "builderId", "slsaLevel"],
      "properties": {
        "predicateType": { "type": "string" },
        "builderId": { "type": "string" },
        "slsaLevel": { "type": "integer" },
        "sourceUri": { "type": ["string", "null"] },
        "sourceRevision": { "type": ["string", "null"] }
      }
    }
  }
}
