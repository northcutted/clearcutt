{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ImageRecordV2",
  "type": "object",
  "required": [
    "schemaVersion",
    "id",
    "kind",
    "language",
    "tier",
    "registry",
    "imageName",
    "fullName",
    "releases",
    "lifecycle",
    "runtimeContract"
  ],
  "properties": {
    "schemaVersion": { "type": "string", "const": "clearcutt.catalog.image/v2" },
    "id": { "type": "string" },
    "kind": { "type": "string", "enum": ["runtime", "service", "application"] },
    "language": { "$ref": "catalog-index.v2.schema.json#/definitions/LanguageInfo" },
    "tier": { "$ref": "catalog-index.v2.schema.json#/definitions/TierInfo" },
    "registry": { "type": "string" },
    "imageName": { "type": "string" },
    "fullName": { "type": "string" },
    "lifecycle": { "$ref": "catalog-index.v2.schema.json#/definitions/Lifecycle" },
    "runtimeContract": { "$ref": "catalog-index.v2.schema.json#/definitions/RuntimeContract" },
    "service": { "$ref": "catalog-index.v2.schema.json#/definitions/ServiceInfo" },
    "releases": {
      "type": "array",
      "items": { "$ref": "#/definitions/ReleaseEntry" }
    }
  },
  "definitions": {
    "PackageEntry": {
      "type": "object",
      "required": ["name", "version", "cpes", "license", "supplier", "spdxId"],
      "properties": {
        "name": { "type": "string" },
        "version": { "type": "string" },
        "purl": { "type": ["string", "null"] },
        "cpes": {
          "type": "array",
          "items": { "type": "string" }
        },
        "license": { "type": "string" },
        "supplier": { "type": "string" },
        "nixStorePath": { "type": ["string", "null"] },
        "spdxId": { "type": "string" },
        "layerDigest": { "type": ["string", "null"] }
      }
    },
    "ArchPayload": {
      "type": "object",
      "required": ["arch", "os", "layers", "labels", "sbom"],
      "properties": {
        "arch": { "type": "string", "enum": ["amd64", "arm64"] },
        "os": { "type": "string" },
        "imageDigest": { "type": ["string", "null"] },
        "imageSize": {
          "type": ["integer", "null"],
          "description": "Sum of the compressed layer sizes in bytes — the approximate registry pull size of the image for this architecture."
        },
        "manifestDescriptorSize": {
          "type": ["integer", "null"],
          "description": "Byte size of the OCI manifest descriptor for this architecture (the manifest document itself, typically a few KiB — not the image contents)."
        },
        "layerCount": { "type": ["integer", "null"] },
        "layers": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["digest", "size"],
            "properties": {
              "digest": { "type": "string" },
              "size": { "type": "integer" },
              "diffID": { "type": ["string", "null"] }
            }
          }
        },
        "labels": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "sbom": {
          "type": "object",
          "required": ["tool", "createdAt", "packageCount", "packages"],
          "properties": {
            "tool": { "type": "string" },
            "createdAt": { "type": "string" },
            "rootDigest": { "type": ["string", "null"] },
            "packageCount": { "type": "integer" },
            "packages": {
              "type": "array",
              "items": { "$ref": "#/definitions/PackageEntry" }
            }
          }
        },
        "testResults": {
          "type": ["object", "null"],
          "properties": {
            "status": { "type": "string" },
            "timestamp": { "type": ["string", "null"] },
            "assertions": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["name", "status"],
                "properties": {
                  "name": { "type": "string" },
                  "status": { "type": "string" }
                }
              }
            }
          }
        },
        "vulnerabilities": { "type": ["object", "null"] }
      }
    },
    "AttestationEntry": {
      "type": "object",
      "required": ["kind", "predicateType", "sources"],
      "properties": {
        "kind": { "type": "string", "enum": ["slsa-provenance", "sbom", "test-results", "custom"] },
        "predicateType": { "type": "string" },
        "subjectName": { "type": ["string", "null"] },
        "subjectDigest": { "type": ["string", "null"] },
        "signerIdentity": { "type": ["string", "null"] },
        "issuer": { "type": ["string", "null"] },
        "runUrl": { "type": ["string", "null"] },
        "workflowUrl": { "type": ["string", "null"] },
        "githubApiUrl": { "type": ["string", "null"] },
        "releaseAssetUrl": { "type": ["string", "null"] },
        "transparencyLogIndex": { "type": ["integer", "null"] },
        "transparencyUrl": { "type": ["string", "null"] },
        "sources": {
          "type": "array",
          "items": { "type": "string", "enum": ["oci", "github"] }
        }
      }
    },
    "ExceptionSummary": {
      "type": "object",
      "required": [
        "total",
        "expired",
        "active",
        "acceptedRisk",
        "noFixAvailable",
        "falsePositive",
        "inheritedFromBase"
      ],
      "properties": {
        "total": { "type": "integer" },
        "expired": { "type": "integer" },
        "active": { "type": "integer" },
        "acceptedRisk": { "type": "integer" },
        "noFixAvailable": { "type": "integer" },
        "falsePositive": { "type": "integer" },
        "inheritedFromBase": { "type": "integer" }
      }
    },
    "ReleaseEntry": {
      "type": "object",
      "required": [
        "tag",
        "publishedAt",
        "isLatest",
        "architectures",
        "attestations",
        "assetUrls",
        "lifecycle",
        "runtimeContract",
        "exceptions"
      ],
      "properties": {
        "tag": { "type": "string" },
        "publishedAt": { "type": "string" },
        "lastRebuiltAt": { "type": ["string", "null"] },
        "isLatest": { "type": "boolean" },
        "manifestDigest": { "type": ["string", "null"] },
        "totalSize": { "type": ["integer", "null"] },
        "architectures": {
          "type": "array",
          "items": { "$ref": "#/definitions/ArchPayload" }
        },
        "signature": { "type": ["object", "null"] },
        "provenance": { "type": ["object", "null"] },
        "attestations": {
          "type": "array",
          "items": { "$ref": "#/definitions/AttestationEntry" }
        },
        "assetUrls": {
          "type": "object",
          "required": ["sbom", "testResults"],
          "properties": {
            "sbom": {
              "type": "object",
              "additionalProperties": { "type": "string" }
            },
            "provenance": { "type": ["string", "null"] },
            "testResults": {
              "type": "object",
              "additionalProperties": { "type": "string" }
            },
            "digest": { "type": ["string", "null"] }
          }
        },
        "evidence": { "$ref": "catalog-index.v2.schema.json#/definitions/EvidenceSummary" },
        "lifecycle": { "$ref": "catalog-index.v2.schema.json#/definitions/Lifecycle" },
        "runtimeContract": { "$ref": "catalog-index.v2.schema.json#/definitions/RuntimeContract" },
        "exceptions": { "$ref": "#/definitions/ExceptionSummary" }
      }
    }
  }
}
